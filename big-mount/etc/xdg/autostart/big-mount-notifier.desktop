[Desktop Entry]
Type=Application
Name=Big-Mount notifier
Name[pt_BR]=Notificador do Big-Mount
Comment=Explains why a storage device cannot be written to
Comment[pt_BR]=Explica por que um dispositivo de armazenamento não aceita gravação
Exec=/usr/bin/bigmount --notifier
Icon=drive-harddisk
Terminal=false
NoDisplay=true
X-KDE-autostart-phase=2
X-GNOME-Autostart-enabled=true
