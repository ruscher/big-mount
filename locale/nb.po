msgstr "Plass som vil bli brukt"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:975
#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:977
msgid "To copy"
msgstr "Å kopiere"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:975
#, python-format
msgid "%(files)s files, %(size)s"
msgstr "Filer: %(files)s (%(size)s)"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:979
msgid "Free at the destination"
msgstr "Ledig på målet"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:981
msgid "Already there, with different content"
msgstr "Finnes allerede der, med annet innhold"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:984
msgid "Your files will be copied with their names. Nothing is written to the source."
msgstr "Filene dine blir kopiert med navnene sine. Ingenting skrives til kilden."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:985
msgid "First a list of what exists is made. Then you choose what to copy. Nothing is written to the source."
msgstr "Først lages en liste over det som finnes. Deretter velger du hva som skal kopieres. Ingenting skrives til kilden."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:986
msgid "Files will be searched for by their content. Names and folders are lost, some files may come out incomplete, and finding nothing is possible. Nothing is written to the source."
msgstr "Det søkes etter filer ut fra innholdet. Navn og mapper går tapt, noen filer kan bli ufullstendige, og det er mulig at ingenting blir funnet. Ingenting skrives til kilden."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:987
msgid "The disk is read once, into a file. Nothing is written to it."
msgstr "Disken leses én gang, til en fil. Ingenting skrives til den."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:992
msgid "After the image, the search needs your confirmation. It can also be started later."
msgstr "Etter bildet trenger søket din bekreftelse. Det kan også startes senere."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:994
msgid "Good to know"
msgstr "Greit å vite"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1004
#, python-format
msgid "%d item you marked"
msgid_plural "%d items you marked"
msgstr[0] "%d element du merket"
msgstr[1] "%d elementer du merket"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1014
msgid "If a file already exists"
msgstr "Hvis en fil allerede finnes"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1019
msgid "Check the result"
msgstr "Kontroller resultatet"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1021
