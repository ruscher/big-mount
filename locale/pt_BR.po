msgstr "Você pode escolher mais de um. Na dúvida, deixe Todos."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:533
#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:996
msgid "All types"
msgstr "Todos os tipos"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:592
msgid "This drive reported problems: every extra read wears it. Nothing starts without you."
msgstr "Este disco relatou problemas: cada leitura a mais o desgasta. Nada começa sem você."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:597
msgid "You chose the whole drive. Copying files and the quick analysis work with the files of a volume."
msgstr "Você escolheu o disco inteiro. Copiar arquivos e a análise rápida trabalham com os arquivos de um volume."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:598
#, python-format
msgid "Use the volume %s"
