X-KDE-Submenu[en]=Storage device
X-KDE-Submenu[es]=Dispositivo de almacenamiento
X-KDE-Submenu[et]=Salvestusseade
X-KDE-Submenu[fi]=Tallennuslaite
X-KDE-Submenu[fr]=Périphérique de stockage
X-KDE-Submenu[he]=התקן אחסון
X-KDE-Submenu[hr]=Uređaj za pohranu
X-KDE-Submenu[hu]=Tárolóeszköz
X-KDE-Submenu[is]=Gagnageymslutæki
X-KDE-Submenu[it]=Dispositivo di archiviazione
X-KDE-Submenu[ja]=ストレージデバイス
X-KDE-Submenu[ko]=저장 장치
X-KDE-Submenu[nb]=Lagringsenhet
X-KDE-Submenu[nl]=Opslagapparaat
X-KDE-Submenu[pl]=Urządzenie pamięci masowej
X-KDE-Submenu[pt]=Dispositivo de armazenamento
X-KDE-Submenu[pt_BR]=Dispositivo de armazenamento
X-KDE-Submenu[ro]=Dispozitiv de stocare
X-KDE-Submenu[ru]=Устройство хранения
X-KDE-Submenu[sk]=Úložné zariadenie
X-KDE-Submenu[sv]=Lagringsenhet
X-KDE-Submenu[tr]=Depolama aygıtı
X-KDE-Submenu[uk]=Пристрій зберігання
X-KDE-Submenu[zh_CN]=存储设备
X-KDE-Submenu[zh_TW]=儲存裝置
X-KDE-Submenu=Storage device
Icon=big-mount
Actions=diagnose;safeRemove;manage;

[Desktop Action diagnose]
Name[be]=Чаму я не магу тут запісваць?
Name[bg]=Защо не мога да записвам тук?
Name[cs]=Proč sem nemohu zapisovat?
Name[da]=Hvorfor kan jeg ikke skrive her?
Name[de]=Warum kann ich hier nicht schreiben?
Name[el]=Γιατί δεν μπορώ να γράψω εδώ;
Name[en]=Why can't I write here?
Name[es]=¿Por qué no puedo escribir aquí?
Name[et]=Miks ma siia kirjutada ei saa?
Name[fi]=Miksi en voi kirjoittaa tänne?
Name[fr]=Pourquoi ne puis-je pas écrire ici ?
Name[he]=למה אי אפשר לכתוב כאן?
Name[hr]=Zašto ovdje ne mogu pisati?
Name[hu]=Miért nem tudok ide írni?
Name[is]=Af hverju get ég ekki skrifað hér?
Name[it]=Perché non posso scrivere qui?
Name[ja]=ここに書き込めないのはなぜ?
Name[ko]=왜 여기에 쓸 수 없나요?
Name[nb]=Hvorfor kan jeg ikke skrive her?
Name[nl]=Waarom kan ik hier niet schrijven?
Name[pl]=Dlaczego nie można tu zapisywać?
Name[pt]=Porque é que não consigo escrever aqui?
Name[pt_BR]=Por que não consigo gravar aqui?
Name[ro]=De ce nu pot scrie aici?
Name[ru]=Почему сюда нельзя записывать?
Name[sk]=Prečo sem nemôžem zapisovať?
Name[sv]=Varför kan jag inte skriva här?
Name[tr]=Buraya neden yazamıyorum?
Name[uk]=Чому я не можу сюди записати?
Name[zh_CN]=为什么我无法在这里写入？
Name[zh_TW]=為什麼我無法在這裡寫入？
Name=Why can't I write here?
Icon=dialog-information
Exec=/usr/bin/bigmount --gui %f

[Desktop Action safeRemove]
Name[be]=Бяспечна выняць (паказвае, што трымае прыладу занятай)
Name[bg]=Безопасно отстраняване (показва какво го държи заето)
Name[cs]=Bezpečně odebrat (ukáže, co jej blokuje)
Name[da]=Fjern sikkert (viser, hvad der holder den optaget)
Name[de]=Sicher entfernen (zeigt, was es belegt)
Name[el]=Αφαίρεση με ασφάλεια (δείχνει τι την κρατά σε χρήση)
Name[en]=Safely remove (shows what keeps it busy)
Name[es]=Extraer con seguridad (muestra qué lo mantiene ocupado)
Name[et]=Eemalda turvaliselt (näitab, mis hoiab seda hõivatuna)
Name[fi]=Poista turvallisesti (näyttää, mikä pitää sen varattuna)
Name[fr]=Retirer en toute sécurité (montre ce qui l’occupe)
Name[he]=הסרה בבטחה (מציג מה מעסיק אותו)
Name[hr]=Sigurno ukloni (pokazuje što ga drži zauzetim)
Name[hu]=Biztonságos eltávolítás (megmutatja, mi tartja foglalva)
Name[is]=Fjarlægja á öruggan hátt (sýnir hvað heldur því uppteknu)
Name[it]=Rimuovi in sicurezza (mostra cosa lo tiene occupato)
Name[ja]=安全に取り外す (使用中のものを表示)
Name[ko]=안전하게 제거 (사용 중인 항목 표시)
Name[nb]=Fjern trygt (viser hva som holder den opptatt)
Name[nl]=Veilig verwijderen (toont wat het bezet houdt)
Name[pl]=Bezpiecznie odłącz (pokazuje, co je zajmuje)
Name[pt]=Remover em segurança (mostra o que o mantém ocupado)
Name[pt_BR]=Remover com segurança (mostra o que o mantém ocupado)
Name[ro]=Scoate în siguranță (arată ce îl ține ocupat)
Name[ru]=Безопасно извлечь (показывает, что его удерживает)
Name[sk]=Bezpečne odstrániť (ukáže, čo ho používa)
Name[sv]=Koppla ur säkert (visar vad som håller den upptagen)
Name[tr]=Güvenli Kaldır (onu neyin meşgul ettiğini gösterir)
Name[uk]=Безпечно вилучити (показує, чим він зайнятий)
Name[zh_CN]=安全移除（显示是什么让它处于忙碌状态）
Name[zh_TW]=安全移除（顯示是什麼讓它處於忙碌狀態）
Name=Safely remove (shows what keeps it busy)
Icon=media-eject
Exec=/usr/bin/bigmount --gui-remove %f

