msgstr "O que copiar"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:617
#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:994
msgid "Everything"
msgstr "Tudo"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:617
msgid "All the files of this volume."
msgstr "Todos os arquivos deste volume."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:618
msgid "Only what you mark. Recommended on a drive with problems: the most important first."
msgstr "Só o que você marcar. Recomendado em um disco com problemas: o mais importante primeiro."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:683
msgid "It asks for the administrator password."
msgstr "Pede a senha de administrador."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:685
#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:811
#, python-format
msgid "Not available: %s"
msgstr "Indisponível: %s"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:698
#, python-format
msgid "Use %s"
msgstr "Usar %s"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:700
msgid "Check again"
msgstr "Verificar de novo"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:701
msgid "After installing the package, check again without leaving the assistant."
msgstr "Depois de instalar o pacote, verifique de novo sem sair do assistente."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:703
msgid "Recommended"
msgstr "Recomendado"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:725
#, python-format
msgid "First a disk image is made, which needs free space elsewhere as large as the source (%s). Then the image is searched, and the disk rests."
msgstr "Primeiro é feita uma imagem do disco, que precisa de espaço livre em outro lugar do tamanho da origem (%s). Depois a busca é feita na imagem, e o disco descansa."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:727
msgid "A direct copy does not filter by type. To choose by type, use the quick analysis."
msgstr "A cópia direta não filtra por tipo. Para escolher por tipo, use a análise rápida."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:769
#, python-format
msgid "From: %s"
msgstr "De: %s"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:771
msgid "Never on the same physical disk as the source. If that disk fails, both are lost."
msgstr "Nunca no mesmo disco físico da origem. Se esse disco falhar, os dois se perdem."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:772
msgid "Places on another disk"
msgstr "Lugares em outro disco"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:773
msgid "Looking for places…"
msgstr "Procurando lugares…"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:776
#: big-mount/usr/lib/big-mount/gui/pages/results.py:626
msgid "Choose another folder…"
msgstr "Escolher outra pasta…"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:827
msgid "No other disk is mounted. Connect one, or choose a folder."
msgstr "Nenhum outro disco está montado. Conecte um, ou escolha uma pasta."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:832
#: big-mount/usr/lib/big-mount/gui/pages/results.py:586
#: big-mount/usr/lib/big-mount/gui/pages/results.py:615
msgid "Choose where to save"
msgstr "Escolha onde salvar"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:854
msgid "Checking this place…"
msgstr "Verificando este lugar…"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:860
msgid "The check could not be done."
msgstr "Não foi possível verificar."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:864
