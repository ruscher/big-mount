msgstr "Шукати за назвою, моделлю, міткою або текою"

#: big-mount/usr/lib/big-mount/gui/pages/overview.py:165
msgid "Search drives"
msgstr "Шукати диски"

#: big-mount/usr/lib/big-mount/gui/pages/overview.py:172
msgid "List"
msgstr "Список"

#: big-mount/usr/lib/big-mount/gui/pages/overview.py:172
