msgstr "Hier kann alles gespeichert werden."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:878
#, python-format
msgid "It can be saved here: %s free."
msgstr "Hier kann gespeichert werden: %s frei."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:881
msgid "It cannot be saved here."
msgstr "Hier kann nicht gespeichert werden."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:938
