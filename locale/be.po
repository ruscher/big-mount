msgstr "Крок %(n)d з %(t)d"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:406
msgid "Look for partitions"
msgstr "Шукаць раздзелы"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:413
msgid "Start"
msgstr "Пачаць"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:434
msgid "The source was unmounted. Nothing was done."
msgstr "Крыніцу адмантавалі. Нічога не зроблена."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:446
