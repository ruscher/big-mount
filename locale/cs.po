msgid "%d file with a line break in its name was left out. It cannot be handled safely."
msgid_plural "%d files with a line break in their names were left out. They cannot be handled safely."
msgstr[0] "%d soubor se zalomením řádku v názvu byl vynechán. Nelze s ním bezpečně pracovat."
msgstr[1] "%d soubory se zalomením řádku v názvu byly vynechány. Nelze s nimi bezpečně pracovat."
msgstr[2] "%d souborů se zalomením řádku v názvu bylo vynecháno. Nelze s nimi bezpečně pracovat."

#: big-mount/usr/lib/big-mount/gui/pages/results.py:629
msgid "It cannot be saved here"
msgstr "Sem nelze uložit"

#: locale/templates/big-mount.desktop.in:4
msgid "Drive manager and file rescue"
msgstr "Správce disků a záchrana souborů"

#: locale/templates/big-mount.desktop.in:5
msgid "See how your drives are doing, rescue files from them and remove them safely"
msgstr "Zjistěte, jak jsou na tom vaše disky, zachraňte z nich soubory a bezpečně je odeberte"

#: locale/templates/big-mount.desktop.in:11
msgid "disk;drive;usb;mount;unmount;read-only;busy;eject;ssd;erase;recover;rescue;backup;smart;storage;diagnostics;"
msgstr "disk;jednotka;usb;připojit;odpojit;jen ke čtení;používá se;vysunout;ssd;vymazat;obnovit;zachránit;záloha;smart;úložiště;diagnostika;"

#: locale/templates/big-mount.desktop.in:15
msgid "Storage Diagnostics"
msgstr "Diagnostika úložiště"

#: locale/templates/big-mount-notifier.desktop.in:3
msgid "Big-Mount notifier"
msgstr "Oznamovač Big-Mount"

#: locale/templates/big-mount-notifier.desktop.in:4
msgid "Explains why a storage device cannot be written to"
msgstr "Vysvětluje, proč na úložné zařízení nelze zapisovat"

#: locale/templates/big-mount-servicemenu.desktop.in:6
msgid "Storage device"
msgstr "Úložné zařízení"

#: locale/templates/big-mount-servicemenu.desktop.in:16
