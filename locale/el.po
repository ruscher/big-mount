msgstr "Αναζήτηση δίσκων"

#: big-mount/usr/lib/big-mount/gui/pages/overview.py:172
msgid "List"
msgstr "Λίστα"

#: big-mount/usr/lib/big-mount/gui/pages/overview.py:172
msgid "Grid"
msgstr "Πλέγμα"

#: big-mount/usr/lib/big-mount/gui/pages/overview.py:188
msgid "Looking at what is connected…"
msgstr "Έλεγχος των συνδεδεμένων συσκευών…"

#: big-mount/usr/lib/big-mount/gui/pages/overview.py:190
msgid "Connect a drive and it appears here by itself."
msgstr "Συνδέστε έναν δίσκο και θα εμφανιστεί εδώ αυτόματα."

#: big-mount/usr/lib/big-mount/gui/pages/overview.py:228
#, python-format
msgid "%s reported serious problems. Copy your files to another drive before trying any repair."
msgstr "Ο δίσκος %s ανέφερε σοβαρά προβλήματα. Αντιγράψτε τα αρχεία σας σε άλλον δίσκο πριν δοκιμάσετε οποιαδήποτε επιδιόρθωση."

#: big-mount/usr/lib/big-mount/gui/pages/overview.py:247
#, python-format
