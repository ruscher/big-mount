[Desktop Entry]
Type=Service
MimeType=inode/directory;
X-KDE-Protocols=file
X-KDE-RequiredNumberOfUrls=1
X-KDE-Submenu[pt_BR]=Dispositivo de armazenamento
X-KDE-Submenu=Storage device
Icon=big-mount
Actions=diagnose;safeRemove;

[Desktop Action diagnose]
Name[pt_BR]=Por que não consigo gravar aqui?
Name=Why can't I write here?
Icon=dialog-information
Exec=/usr/bin/bigmount --gui %f

[Desktop Action safeRemove]
Name[pt_BR]=Remover com segurança (mostra o que o mantém ocupado)
Name=Safely remove (shows what keeps it busy)
Icon=media-eject
Exec=/usr/bin/bigmount --gui-remove %f
