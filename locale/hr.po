msgstr "%s je stara skripta (iz 2025. ili starija): skraćuje nazive NVMe uređaja i SD kartica (nvme0n1p1 postaje nvme)"

#: big-mount/usr/lib/big-mount/doctor.sh:127
msgid "Symptoms: 'cat: /sys/block/nvme/removable' and 'Error looking up object for device /dev/nvme'. Update the big-mount package."
msgstr "Simptomi: 'cat: /sys/block/nvme/removable' i 'Error looking up object for device /dev/nvme'. Ažurirajte paket big-mount."

