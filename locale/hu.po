#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1119
msgid "They are not lost. To recover their files, copying them is faster and reads the disk less than any analysis."
msgstr "Ezek nem vesztek el. A fájljaik helyreállításához a másolás gyorsabb, és kevesebbet olvas a lemezről, mint bármilyen elemzés."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1124
msgid "Recover its files"
msgstr "A fájljainak helyreállítása"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1136
msgid "Looking for partitions…"
msgstr "Partíciók keresése…"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1140
msgid "TestDisk does not say how far it has gone, so there is no percentage. Analyzing a whole disk reads all of it and can take hours; the drive can be used for nothing else meanwhile."
msgstr "A TestDisk nem jelzi, hol tart, ezért nincs százalékérték. A teljes lemez elemzése az egészet beolvassa, és órákig tarthat; ezalatt a meghajtó semmi másra nem használható."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1151
#, python-format
msgid "Elapsed: %s"
msgstr "Eltelt idő: %s"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1171
msgid "The search failed."
msgstr "A keresés sikertelen volt."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1174
msgid "What TestDisk found"
msgstr "Amit a TestDisk talált"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1180
msgid "Big-Mount does not rewrite partition tables, on purpose: a mistake there can lose everything. A disk image, or a search by content, recovers files without that risk."
msgstr "A Big-Mount szándékosan nem írja újra a partíciós táblákat: egy ottani hiba miatt minden elveszhet. Egy lemezkép vagy egy tartalom alapján végzett keresés e kockázat nélkül állítja helyre a fájlokat."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1182
msgid "The analysis did not recognize any partition. That does not prove there is no data: a search by content may still find files."
msgstr "Az elemzés nem ismert fel partíciót. Ez nem bizonyítja, hogy nincs adat: a tartalom alapján végzett keresés még találhat fájlokat."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1184
msgid "The partition table is empty or unreadable. Analyzing the whole disk may find what it no longer lists."
msgstr "A partíciós tábla üres vagy olvashatatlan. A teljes lemez elemzése megtalálhatja azt, amit már nem tartalmaz."

#: big-mount/usr/lib/big-mount/gui/pages/results.py:228
msgid "This picture cannot be shown"
msgstr "Ez a kép nem jeleníthető meg"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:229
msgid "It may be incomplete. That is common with files found by content."
msgstr "Lehet, hogy hiányos. Ez gyakori a tartalom alapján talált fájloknál."

#: big-mount/usr/lib/big-mount/gui/pages/results.py:274
#: big-mount/usr/lib/big-mount/gui/pages/results.py:275
msgid "Search by name"
msgstr "Keresés név szerint"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:277
msgid "As found"
msgstr "Találat sorrendjében"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:277
msgid "Largest first"
msgstr "Legnagyobbak elöl"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:277
msgid "By name"
msgstr "Név szerint"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:278
msgid "Order"
msgstr "Sorrend"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:292
msgid "Name"
msgstr "Név"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:296
msgid "Date"
msgstr "Dátum"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:301
msgid "Reading the list…"
msgstr "A lista beolvasása…"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:303
msgid "Nothing to show"
msgstr "Nincs megjeleníthető elem"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:304
msgid "No file matches what you asked for."
msgstr "Egyetlen fájl sem felel meg a keresésnek."

#: big-mount/usr/lib/big-mount/gui/pages/results.py:311
msgid "Recover selected"
msgstr "Kijelöltek helyreállítása"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:313
msgid "Select all shown"
msgstr "Az összes látható kijelölése"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:314
msgid "Clear selection"
msgstr "Kijelölés törlése"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:321
#: big-mount/usr/lib/big-mount/gui/pages/results.py:639
msgid "Save report"
msgstr "Jelentés mentése"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:322
msgid "Try another method"
msgstr "Másik módszer kipróbálása"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:358
msgid "Candidates found by content. They are saved in the destination folder, without their names and folders, and some may be incomplete. Check them before deleting anything."
msgstr "Tartalom alapján talált jelöltek. A célmappába kerülnek, a nevük és a mappájuk nélkül, és egyesek hiányosak lehetnek. Mielőtt bármit törölne, ellenőrizze őket."

#: big-mount/usr/lib/big-mount/gui/pages/results.py:359
msgid "Copy selected to another folder"
msgstr "Kijelöltek másolása egy másik mappába"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:361
msgid "These files exist on the volume and have not been copied yet. Deleted files are not on this list."
msgstr "Ezek a fájlok léteznek a köteten, és még nincsenek átmásolva. A törölt fájlok nem szerepelnek a listán."

#: big-mount/usr/lib/big-mount/gui/pages/results.py:374
#, python-format
msgid "All (%d)"
msgstr "Mind (%d)"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:394
msgid "The list could not be read."
msgstr "A listát nem sikerült beolvasni."

#: big-mount/usr/lib/big-mount/gui/pages/results.py:492
#, python-format
msgid "%(shown)d shown, %(sel)d selected (%(size)s)"
msgstr "%(shown)d látható, %(sel)d kijelölve (%(size)s)"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:509
msgid "Select"
msgstr "Kijelölés"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:531
msgid "Preview"
msgstr "Előnézet"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:597
msgid "It cannot be copied"
msgstr "Nem másolható"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:600
#, python-format
msgid "%d file with a line break in its name was left out. It cannot be handled safely."
msgid_plural "%d files with a line break in their names were left out. They cannot be handled safely."
msgstr[0] "%d fájl kimaradt, mert sortörés van a nevében. Ez nem kezelhető biztonságosan."
msgstr[1] "%d fájl kimaradt, mert sortörés van a nevükben. Ezek nem kezelhetők biztonságosan."

#: big-mount/usr/lib/big-mount/gui/pages/results.py:626
