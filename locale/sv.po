#: big-mount/usr/bin/bigmount:83
msgid "bigmount: mounting the internal partitions needs administrator rights. big-mount.service does it at every boot."
msgstr "bigmount: att montera de interna partitionerna kräver administratörsbehörighet. big-mount.service gör det vid varje uppstart."

#: big-mount/usr/bin/bigmount:84
msgid "To mount them now:            sudo systemctl restart big-mount"
msgstr "Så monterar du dem nu:             sudo systemctl restart big-mount"

#: big-mount/usr/bin/bigmount:85
msgid "To see what would be mounted: bigmount --dry-run"
msgstr "Så ser du vad som skulle monteras: bigmount --dry-run"

#: big-mount/usr/bin/bigmount:86
msgid "To check the installation:    bigmount --doctor"
msgstr "Så kontrollerar du installationen: bigmount --doctor"

#: big-mount/usr/bin/bigmount:96
msgid "cannot open the lock file /run/lock/big-mount.lock, giving up"
msgstr "kan inte öppna låsfilen /run/lock/big-mount.lock, ger upp"

#: big-mount/usr/bin/bigmount:101
msgid "another bigmount is still running, giving up"
msgstr "en annan bigmount körs fortfarande, ger upp"

#: big-mount/usr/bin/bigmount:143
msgid "last login '%s' is not a known account, ignoring it"
msgstr "senaste inloggning '%s' är inget känt konto, ignoreras"

#: big-mount/usr/bin/bigmount:164
msgid "/etc/big-mount.conf: unknown value '%s', using shared"
msgstr "/etc/big-mount.conf: okänt värde '%s', använder shared"

#: big-mount/usr/bin/bigmount:283
msgid "%s: skipped, %s is not a filesystem"
msgstr "%s: hoppades över, %s är inget filsystem"

#: big-mount/usr/bin/bigmount:289
msgid "%s: skipped, virtual device"
msgstr "%s: hoppades över, virtuell enhet"

#: big-mount/usr/bin/bigmount:296
msgid "%s: skipped, already mounted"
msgstr "%s: hoppades över, redan monterad"

#: big-mount/usr/bin/bigmount:332
msgid "waiting for udev to finish processing %s"
msgstr "väntar på att udev ska bli klar med %s"

#: big-mount/usr/bin/bigmount:382
msgid "%s: udev has no information about it yet, not mounting"
msgstr "%s: udev har ingen information om den ännu, monteras inte"

#: big-mount/usr/bin/bigmount:386
msgid "%s: skipped, hidden by udev/UDisks (UDISKS_IGNORE)"
msgstr "%s: hoppades över, dold av udev/UDisks (UDISKS_IGNORE)"

#: big-mount/usr/bin/bigmount:394
msgid "%s: left to UDisks, external device (%s)"
msgstr "%s: lämnas åt UDisks, extern enhet (%s)"

#: big-mount/usr/bin/bigmount:400
msgid "%s: skipped, listed in /etc/fstab"
msgstr "%s: hoppades över, finns i /etc/fstab"

#: big-mount/usr/bin/bigmount:452
msgid "%s: device changed during the scan, not mounting"
msgstr "%s: enheten ändrades under genomsökningen, monteras inte"

#: big-mount/usr/bin/bigmount:478
msgid "%s: NTFS refused read-write mount (%s), retrying read-only"
msgstr "%s: NTFS vägrade montering med skrivåtkomst (%s), försöker igen skrivskyddat"

#: big-mount/usr/bin/bigmount:495
msgid "%s: mount of %s on %s failed (exit %s)"
msgstr "%s: montering av %s på %s misslyckades (slutstatus %s)"

#: big-mount/usr/bin/bigmount:516
msgid "%s: the driver mounted %s read-only on its own (%s)"
msgstr "%s: drivrutinen monterade %s skrivskyddat på egen hand (%s)"

#: big-mount/usr/bin/bigmount:523
msgid "%s: would be mounted %s on %s (%s)"
msgstr "%s: skulle monteras %s på %s (%s)"

#: big-mount/usr/bin/bigmount:525
msgid "%s: mounted %s on %s (%s)"
msgstr "%s: monterade %s på %s (%s)"

#: big-mount/usr/lib/big-mount/cli.sh:24
msgid "Usage: bigmount [OPTION] [DEVICE|FOLDER]"
msgstr "Användning: bigmount [ALTERNATIV] [ENHET|MAPP]"

#: big-mount/usr/lib/big-mount/cli.sh:27
msgid "(none)"
msgstr "(inget)"

#: big-mount/usr/lib/big-mount/cli.sh:27
msgid "mount internal partitions (run at boot by big-mount.service)"
msgstr "montera interna partitioner (körs vid uppstart av big-mount.service)"

#: big-mount/usr/lib/big-mount/cli.sh:28
msgid "show what would be mounted, change nothing"
msgstr "visa vad som skulle monteras, ändra ingenting"

#: big-mount/usr/lib/big-mount/cli.sh:29
msgid "storage overview, or details of one device (a whole disk: drive errors)"
msgstr "översikt över lagring, eller detaljer om en enhet (en hel disk: diskfel)"

#: big-mount/usr/lib/big-mount/cli.sh:30
msgid "show what keeps a device busy"
msgstr "visa vad som håller en enhet upptagen"

#: big-mount/usr/lib/big-mount/cli.sh:31
msgid "unmount one filesystem safely"
msgstr "avmontera ett filsystem säkert"

#: big-mount/usr/lib/big-mount/cli.sh:32
msgid "unmount every filesystem of the drive and power it off"
msgstr "avmontera alla filsystem på disken och stäng av den"

#: big-mount/usr/lib/big-mount/cli.sh:33
msgid "with --safe-remove: unmount everything, do not power it off"
msgstr "med --safe-remove: avmontera allt, stäng inte av den"

#: big-mount/usr/lib/big-mount/cli.sh:34
msgid "offer to close the programs that keep it busy"
msgstr "erbjud att stänga programmen som håller den upptagen"

#: big-mount/usr/lib/big-mount/cli.sh:35
msgid "do not ask before closing them or stopping services (scripts)"
msgstr "fråga inte innan de stängs eller tjänster stoppas (skript)"

#: big-mount/usr/lib/big-mount/cli.sh:36
msgid "graphical diagnosis"
msgstr "grafisk diagnos"

#: big-mount/usr/lib/big-mount/cli.sh:37
msgid "graphical safe removal"
msgstr "grafisk säker urkoppling"

#: big-mount/usr/lib/big-mount/cli.sh:38
msgid "erase a whole SATA drive with its own Secure Erase (asks first)"
msgstr "radera en hel SATA-disk med diskens egen säkra radering (Secure Erase, frågar först)"

#: big-mount/usr/lib/big-mount/cli.sh:39
msgid "drive manager and file rescue in the terminal (bigmount --drive --help)"
msgstr "diskhanterare och filräddning i terminalen (bigmount --drive --help)"

#: big-mount/usr/lib/big-mount/cli.sh:40
msgid "the application: drives, health and file rescue"
msgstr "programmet: diskar, hälsa och filräddning"

#: big-mount/usr/lib/big-mount/cli.sh:41
msgid "the same application, opened on the health of the drive"
msgstr "samma program, öppnat på diskens hälsa"

#: big-mount/usr/lib/big-mount/cli.sh:42
msgid "session service: warn about read-only devices"
msgstr "sessionstjänst: varna för skrivskyddade enheter"

#: big-mount/usr/lib/big-mount/cli.sh:43
msgid "check the installation and the storage stack (for bug reports)"
msgstr "kontrollera installationen och lagringsstacken (för felrapporter)"

#: big-mount/usr/lib/big-mount/cli.sh:44
msgid "show the version and the source revision"
msgstr "visa versionen och källkodsrevisionen"

#: big-mount/usr/lib/big-mount/cli.sh:45
msgid "show this help"
msgstr "visa den här hjälpen"

#: big-mount/usr/lib/big-mount/cli.sh:46
msgid "TARGET is a device (/dev/sdb1) or any folder inside a mounted device."
msgstr "TARGET är en enhet (/dev/sdb1) eller valfri mapp på en monterad enhet."

#: big-mount/usr/lib/big-mount/cli.sh:106
#: big-mount/usr/lib/big-mount/cli.sh:799
#: big-mount/usr/lib/big-mount/cli.sh:1070
#: big-mount/usr/lib/big-mount/doctor.sh:449
#: big-mount/usr/lib/big-mount/drive.sh:227
msgid "bigmount: unknown option '%s' (see bigmount --help)"
msgstr "bigmount: okänt alternativ '%s' (se bigmount --help)"

#: big-mount/usr/lib/big-mount/cli.sh:120
#: big-mount/usr/lib/big-mount/cli.sh:1322
msgid "Device ready"
msgstr "Enheten är klar"

#: big-mount/usr/lib/big-mount/cli.sh:121
msgid "You can read and write files on this device."
msgstr "Du kan läsa och skriva filer på den här enheten."

#: big-mount/usr/lib/big-mount/cli.sh:124
msgid "Device not mounted"
msgstr "Enheten är inte monterad"

#: big-mount/usr/lib/big-mount/cli.sh:125
msgid "The filesystem is not mounted at the moment."
msgstr "Filsystemet är inte monterat för tillfället."

#: big-mount/usr/lib/big-mount/cli.sh:126
msgid "Open the device in the file manager (Dolphin) to mount it."
msgstr "Öppna enheten i filhanteraren (Dolphin) för att montera den."

#: big-mount/usr/lib/big-mount/cli.sh:129
#: big-mount/usr/lib/big-mount/cli.sh:135
#: big-mount/usr/lib/big-mount/cli.sh:142
#: big-mount/usr/lib/big-mount/cli.sh:164
msgid "Read-only device"
msgstr "Skrivskyddad enhet"

#: big-mount/usr/lib/big-mount/cli.sh:130
msgid "The device itself is write-protected, so no system can write to it."
msgstr "Själva enheten är skrivskyddad, så inget system kan skriva till den."

#: big-mount/usr/lib/big-mount/cli.sh:131
msgid "SD cards and some USB drives have a small lock switch on the side. Remove the device, move the switch to the unlocked position and connect it again."
msgstr "SD-kort och vissa USB-minnen har ett litet låsreglage på sidan. Ta ur enheten, flytta reglaget till olåst läge och anslut den igen."

#: big-mount/usr/lib/big-mount/cli.sh:132
msgid "If there is no switch, the device may have locked itself because of wear. Copy your files to another place as soon as possible."
msgstr "Om det inte finns något reglage kan enheten ha låst sig själv på grund av slitage. Kopiera dina filer till en annan plats så snart som möjligt."

#: big-mount/usr/lib/big-mount/cli.sh:136
msgid "This kind of filesystem cannot be written on Linux with the driver in use."
msgstr "Den här typen av filsystem kan inte skrivas till i Linux med den drivrutin som används."

#: big-mount/usr/lib/big-mount/cli.sh:137
msgid "CDs, DVDs and disk images (ISO, SquashFS) are read-only by nature."
msgstr "Cd- och dvd-skivor samt diskavbilder (ISO, SquashFS) är skrivskyddade till sin natur."

#: big-mount/usr/lib/big-mount/cli.sh:138
msgid "Drives formatted on a Mac (HFS+ with journaling, APFS) can only be read on Linux."
msgstr "Diskar som formaterats på en Mac (HFS+ med journalföring, APFS) kan bara läsas i Linux."

#: big-mount/usr/lib/big-mount/cli.sh:139
msgid "To write to it, copy the files elsewhere and format the device with a filesystem such as exFAT. Formatting erases everything on it."
msgstr "För att skriva till den, kopiera filerna till en annan plats och formatera enheten med ett filsystem som exFAT. Formatering raderar allt på den."

#: big-mount/usr/lib/big-mount/cli.sh:143
msgid "Windows did not close this NTFS partition properly (hibernation, Fast Startup or an interrupted shutdown). Writing to it now could damage files."
msgstr "Windows stängde inte den här NTFS-partitionen korrekt (viloläge, snabb start eller en avbruten avstängning). Att skriva till den nu kan skada filer."

#: big-mount/usr/lib/big-mount/cli.sh:144
msgid "Start Windows and shut it down completely: hold the Shift key while you click Shut down."
msgstr "Starta Windows och stäng av det helt: håll ned Skift-tangenten medan du klickar på Stäng av."

#: big-mount/usr/lib/big-mount/cli.sh:145
msgid "To avoid this in the future, disable Fast Startup in Windows: Control Panel > Power Options > Choose what the power buttons do."
msgstr "För att undvika detta i framtiden, inaktivera snabb start i Windows: Kontrollpanelen > Energialternativ > Välj vad strömbrytarna ska göra."

#: big-mount/usr/lib/big-mount/cli.sh:146
msgid "If it still happens, check the partition in Windows: open the Command Prompt as administrator and run chkdsk with the /f option for that drive letter."
msgstr "Om det fortfarande händer, kontrollera partitionen i Windows: öppna Kommandotolken som administratör och kör chkdsk med alternativet /f för den enhetsbokstaven."

#: big-mount/usr/lib/big-mount/cli.sh:147
msgid "Big-Mount never repairs NTFS by itself, because the repair tools available on Linux may discard data that Windows still needs."
msgstr "Big-Mount reparerar aldrig NTFS på egen hand, eftersom reparationsverktygen som finns i Linux kan kasta bort data som Windows fortfarande behöver."

#: big-mount/usr/lib/big-mount/cli.sh:150
msgid "The filesystem needs attention"
msgstr "Filsystemet behöver åtgärdas"

#: big-mount/usr/lib/big-mount/cli.sh:151
msgid "The system found errors in the filesystem and stopped writing to it to protect your files."
msgstr "Systemet hittade fel i filsystemet och slutade skriva till det för att skydda dina filer."

#: big-mount/usr/lib/big-mount/cli.sh:152
msgid "First copy your important files to another place."
msgstr "Kopiera först dina viktiga filer till en annan plats."

#: big-mount/usr/lib/big-mount/cli.sh:153
msgid "Then check the filesystem with the device unmounted, for example with KDE Partition Manager (Check)."
msgstr "Kontrollera sedan filsystemet medan enheten är avmonterad, till exempel med KDE Partition Manager (Kontrollera)."

#: big-mount/usr/lib/big-mount/cli.sh:154
msgid "Do not write to the device until it has been checked."
msgstr "Skriv inte till enheten förrän den har kontrollerats."

#: big-mount/usr/lib/big-mount/cli.sh:157
msgid "The device has read or write errors"
msgstr "Enheten har läs- eller skrivfel"

#: big-mount/usr/lib/big-mount/cli.sh:158
msgid "The device reported read or write errors. This is usually a bad cable, a weak USB port or a failing drive."
msgstr "Enheten rapporterade läs- eller skrivfel. Det beror oftast på en dålig kabel, en svag USB-port eller en disk som håller på att gå sönder."

#: big-mount/usr/lib/big-mount/cli.sh:159
#: big-mount/usr/lib/big-mount/cli.sh:920
msgid "Copy your important files to another place as soon as possible."
msgstr "Kopiera dina viktiga filer till en annan plats så snart som möjligt."

#: big-mount/usr/lib/big-mount/cli.sh:160
msgid "Try another cable and connect the device directly to the computer, without a hub."
msgstr "Prova en annan kabel och anslut enheten direkt till datorn, utan hubb."

#: big-mount/usr/lib/big-mount/cli.sh:161
msgid "Check the health of the drive in KDE Partition Manager (SMART status)."
msgstr "Kontrollera diskens hälsa i KDE Partition Manager (SMART-status)."

#: big-mount/usr/lib/big-mount/cli.sh:165
msgid "The filesystem was mounted read-only, but no problem was found with it."
msgstr "Filsystemet monterades skrivskyddat, men inget problem hittades i det."

#: big-mount/usr/lib/big-mount/cli.sh:166
msgid "Mount it again with writing enabled."
msgstr "Montera det igen med skrivåtkomst."

#: big-mount/usr/lib/big-mount/cli.sh:167
msgid "Mount again with writing"
msgstr "Montera om med skrivåtkomst"

#: big-mount/usr/lib/big-mount/cli.sh:168
msgid "The device will be unmounted and mounted again with writing enabled. Nothing on it is changed. Programs using it must be closed first."
msgstr "Enheten avmonteras och monteras igen med skrivåtkomst. Ingenting på den ändras. Program som använder den måste stängas först."

#: big-mount/usr/lib/big-mount/cli.sh:171
#: big-mount/usr/lib/big-mount/cli.sh:179
#: big-mount/usr/lib/big-mount/cli.sh:184
#: big-mount/usr/lib/big-mount/cli.sh:198
msgid "No permission to write"
msgstr "Ingen skrivbehörighet"

#: big-mount/usr/lib/big-mount/cli.sh:172
msgid "The device accepts writing, but its main folder belongs to another user and you are not allowed to change it."
msgstr "Enheten tillåter skrivning, men dess huvudmapp tillhör en annan användare och du får inte ändra den."

#: big-mount/usr/lib/big-mount/cli.sh:173
msgid "You can become the owner of the main folder. Only that folder changes: the files and folders inside it keep their owners."
msgstr "Du kan bli ägare till huvudmappen. Bara den mappen ändras: filerna och mapparna i den behåller sina ägare."

#: big-mount/usr/lib/big-mount/cli.sh:174
msgid "This is the usual fix for drives formatted with a Linux filesystem (ext4, Btrfs, XFS)."
msgstr "Det här är den vanliga lösningen för diskar som formaterats med ett Linux-filsystem (ext4, Btrfs, XFS)."

#: big-mount/usr/lib/big-mount/cli.sh:175
msgid "Become owner of the main folder"
msgstr "Bli ägare till huvudmappen"

#: big-mount/usr/lib/big-mount/cli.sh:176
msgid "The main folder of the device will belong to you (not recursive: the files and folders inside keep their owners). The administrator password may be requested."
msgstr "Enhetens huvudmapp kommer att tillhöra dig (inte rekursivt: filerna och mapparna i den behåller sina ägare). Administratörslösenordet kan efterfrågas."

#: big-mount/usr/lib/big-mount/cli.sh:180
msgid "This partition contains an operating system. Its folders belong to that system and must keep their owners."
msgstr "Den här partitionen innehåller ett operativsystem. Dess mappar tillhör det systemet och måste behålla sina ägare."

#: big-mount/usr/lib/big-mount/cli.sh:181
msgid "Save your files in a folder that belongs to you, for example your home folder on that system."
msgstr "Spara dina filer i en mapp som tillhör dig, till exempel din hemmapp i det systemet."

#: big-mount/usr/lib/big-mount/cli.sh:185
msgid "This folder belongs to %s, and only its owner can create or change files in it."
msgstr "Den här mappen tillhör %s, och bara ägaren kan skapa eller ändra filer i den."

#: big-mount/usr/lib/big-mount/cli.sh:186
msgid "Save your files in a folder of your own, for example in your home folder."
msgstr "Spara dina filer i en egen mapp, till exempel i din hemmapp."

#: big-mount/usr/lib/big-mount/cli.sh:189
msgid "System partition"
msgstr "Systempartition"

#: big-mount/usr/lib/big-mount/cli.sh:190
msgid "This partition holds the operating system that is running now. Only the system and administrators write here."
msgstr "Den här partitionen innehåller operativsystemet som körs nu. Bara systemet och administratörer skriver här."

#: big-mount/usr/lib/big-mount/cli.sh:191
msgid "Save your files in your home folder."
msgstr "Spara dina filer i din hemmapp."

#: big-mount/usr/lib/big-mount/cli.sh:194
msgid "Swap space"
msgstr "Växlingsutrymme"

#: big-mount/usr/lib/big-mount/cli.sh:195
msgid "This partition is used as swap space (virtual memory), not to store files."
msgstr "Den här partitionen används som växlingsutrymme (virtuellt minne), inte för att lagra filer."

#: big-mount/usr/lib/big-mount/cli.sh:199
msgid "The device was mounted for another user, so only that user can write to it."
msgstr "Enheten monterades för en annan användare, så bara den användaren kan skriva till den."

#: big-mount/usr/lib/big-mount/cli.sh:200
msgid "Unmount it and open it again from the file manager while you are logged in."
msgstr "Avmontera den och öppna den igen från filhanteraren medan du är inloggad."

#: big-mount/usr/lib/big-mount/cli.sh:202
msgid "This internal partition is mounted by Big-Mount at boot. An administrator can choose who may write to it with PERMISSIONS in /etc/big-mount.conf."
msgstr "Den här interna partitionen monteras av Big-Mount vid uppstart. En administratör kan välja vem som får skriva till den med PERMISSIONS i /etc/big-mount.conf."

#: big-mount/usr/lib/big-mount/cli.sh:204
msgid "Mount again for my user"
msgstr "Montera om för min användare"

#: big-mount/usr/lib/big-mount/cli.sh:205
msgid "The device will be unmounted and mounted again for your user. Nothing on it is changed. Programs using it must be closed first."
msgstr "Enheten avmonteras och monteras igen för din användare. Ingenting på den ändras. Program som använder den måste stängas först."

#: big-mount/usr/lib/big-mount/cli.sh:208
msgid "Unknown state"
msgstr "Okänt tillstånd"

#: big-mount/usr/lib/big-mount/cli.sh:209
msgid "The state of this device could not be determined."
msgstr "Det gick inte att avgöra enhetens tillstånd."

#: big-mount/usr/lib/big-mount/cli.sh:218
#: big-mount/usr/lib/big-mount/cli.sh:880
#: big-mount/usr/lib/big-mount/doctor.sh:57
msgid "unknown"
msgstr "okänt"

#: big-mount/usr/lib/big-mount/cli.sh:249
msgid "system"
msgstr "systemet"

#: big-mount/usr/lib/big-mount/cli.sh:254
msgid "other"
msgstr "annat"

#: big-mount/usr/lib/big-mount/cli.sh:267
#: big-mount/usr/lib/big-mount/cli.sh:551
#: big-mount/usr/lib/big-mount/drive-diag.sh:289
#: big-mount/usr/lib/big-mount/drive.sh:242
msgid "Device"
msgstr "Enhet"

#: big-mount/usr/lib/big-mount/cli.sh:268
#: big-mount/usr/lib/big-mount/cli.sh:552
#: big-mount/usr/lib/big-mount/drive.sh:256
msgid "Filesystem"
msgstr "Filsystem"

#: big-mount/usr/lib/big-mount/cli.sh:270
#: big-mount/usr/lib/big-mount/cli.sh:553
#: big-mount/usr/lib/big-mount/drive.sh:260
msgid "Mounted at"
msgstr "Monterad på"

#: big-mount/usr/lib/big-mount/cli.sh:271
msgid "Folder"
msgstr "Mapp"

#: big-mount/usr/lib/big-mount/cli.sh:273
msgid "Writable, but not by your user"
msgstr "Skrivbar, men inte för din användare"

#: big-mount/usr/lib/big-mount/cli.sh:273
#: big-mount/usr/lib/big-mount/drive.sh:259
msgid "Status"
msgstr "Status"

#: big-mount/usr/lib/big-mount/cli.sh:277
#: big-mount/usr/lib/big-mount/cli.sh:919
msgid "How to solve:"
msgstr "Så löser du det:"

#: big-mount/usr/lib/big-mount/cli.sh:281
msgid "Attention: the filesystem has recorded errors. Copy important files elsewhere and check it soon."
msgstr "Obs! Filsystemet har registrerat fel. Kopiera viktiga filer till en annan plats och kontrollera det snart."

#: big-mount/usr/lib/big-mount/cli.sh:284
msgid "Attention: the drive that holds this device reported errors since the computer was started. Copy important files elsewhere and check the drive."
msgstr "Obs! Disken som innehåller den här enheten har rapporterat fel sedan datorn startades. Kopiera viktiga filer till en annan plats och kontrollera disken."

#: big-mount/usr/lib/big-mount/cli.sh:356
msgid "To see the errors of the drive: bigmount --diagnose %s"
msgstr "Visa diskens fel: bigmount --diagnose %s"

#: big-mount/usr/lib/big-mount/cli.sh:358
#: big-mount/usr/lib/big-mount/cli.sh:947
msgid "Technical details:"
msgstr "Tekniska detaljer:"

#: big-mount/usr/lib/big-mount/cli.sh:374
#: big-mount/usr/lib/big-mount/drive-tui.sh:87
msgid "DEVICE"
msgstr "ENHET"

#: big-mount/usr/lib/big-mount/cli.sh:374
msgid "LABEL"
msgstr "ETIKETT"

#: big-mount/usr/lib/big-mount/cli.sh:374
msgid "SIZE"
msgstr "STORLEK"

#: big-mount/usr/lib/big-mount/cli.sh:374
msgid "FS"
msgstr "FS"

#: big-mount/usr/lib/big-mount/cli.sh:374
msgid "MANAGED BY"
msgstr "HANTERAS AV"

#: big-mount/usr/lib/big-mount/cli.sh:374
msgid "MOUNTED AT"
msgstr "MONTERAD PÅ"

#: big-mount/usr/lib/big-mount/cli.sh:374
msgid "STATE"
msgstr "TILLSTÅND"

#: big-mount/usr/lib/big-mount/cli.sh:384
msgid "not mounted"
msgstr "inte monterad"

#: big-mount/usr/lib/big-mount/cli.sh:386
msgid "in use by the system"
msgstr "används av systemet"

#: big-mount/usr/lib/big-mount/cli.sh:388
msgid "READ-ONLY"
msgstr "SKRIVSKYDDAD"

#: big-mount/usr/lib/big-mount/cli.sh:390
msgid "read and write"
msgstr "läsa och skriva"

#: big-mount/usr/lib/big-mount/cli.sh:392
msgid "no write permission"
msgstr "ingen skrivbehörighet"

#: big-mount/usr/lib/big-mount/cli.sh:406
msgid "Storage devices"
msgstr "Lagringsenheter"

#: big-mount/usr/lib/big-mount/cli.sh:420
msgid "To find out why a device cannot be written to, run: bigmount --diagnose DEVICE"
msgstr "Ta reda på varför det inte går att skriva till en enhet genom att köra: bigmount --diagnose DEVICE"

#: big-mount/usr/lib/big-mount/cli.sh:422
msgid "Environment"
msgstr "Miljö"

#: big-mount/usr/lib/big-mount/cli.sh:425
msgid "present: automount disabled"
msgstr "finns: automatisk montering inaktiverad"

#: big-mount/usr/lib/big-mount/cli.sh:426
msgid "available"
msgstr "tillgänglig"

#: big-mount/usr/lib/big-mount/cli.sh:426
#: big-mount/usr/lib/big-mount/cli.sh:895
msgid "not available"
msgstr "inte tillgänglig"

#: big-mount/usr/lib/big-mount/cli.sh:429
msgid "installed"
msgstr "installerat"

#: big-mount/usr/lib/big-mount/cli.sh:429
msgid "missing"
msgstr "saknas"

#: big-mount/usr/lib/big-mount/cli.sh:431
msgid "readable"
msgstr "läsbar"

#: big-mount/usr/lib/big-mount/cli.sh:431
msgid "not readable (fewer details for errors)"
msgstr "inte läsbar (färre detaljer om fel)"

#: big-mount/usr/lib/big-mount/cli.sh:432
msgid "kernel log"
msgstr "kärnlogg"

#: big-mount/usr/lib/big-mount/cli.sh:468
msgid "Also mounted at %s"
msgstr "Även monterad på %s"

#: big-mount/usr/lib/big-mount/cli.sh:469
msgid "Another device is mounted inside it: %s"
msgstr "En annan enhet är monterad inuti den: %s"

#: big-mount/usr/lib/big-mount/cli.sh:470
msgid "A swap file on it is in use: %s"
msgstr "En växlingsfil på den används: %s"

#: big-mount/usr/lib/big-mount/cli.sh:471
msgid "It is in use as swap space"
msgstr "Den används som växlingsutrymme"

#: big-mount/usr/lib/big-mount/cli.sh:472
msgid "A disk image stored on it is attached: %s"
msgstr "En diskavbild som är lagrad på den är ansluten: %s"

#: big-mount/usr/lib/big-mount/cli.sh:473
msgid "It is used by %s (encryption, LVM or RAID)"
msgstr "Den används av %s (kryptering, LVM eller RAID)"

#: big-mount/usr/lib/big-mount/cli.sh:474
msgid "Also mounted inside an isolated environment (a container or a sandboxed service): %s"
msgstr "Även monterad i en isolerad miljö (en container eller en tjänst i sandlåda): %s"

#: big-mount/usr/lib/big-mount/cli.sh:503
msgid "A container or a sandboxed service has its own mount of this device (see below). Unmounting it here does not release the device while that mount exists."
msgstr "En container eller en tjänst i sandlåda har en egen montering av den här enheten (se nedan). Att avmontera den här frigör inte enheten så länge den monteringen finns."

#: big-mount/usr/lib/big-mount/cli.sh:504
msgid "Stop that container or service first. Big-Mount waits for it before saying the device can be disconnected."
msgstr "Stoppa den containern eller tjänsten först. Big-Mount väntar på den innan enheten anges som säker att koppla från."

#: big-mount/usr/lib/big-mount/cli.sh:506
msgid "No program is using it, but the system still is (see below)."
msgstr "Inget program använder den, men det gör systemet fortfarande (se nedan)."

#: big-mount/usr/lib/big-mount/cli.sh:507
msgid "Resolve the item listed below, then try again."
msgstr "Åtgärda det som listas nedan och försök sedan igen."

#: big-mount/usr/lib/big-mount/cli.sh:509
msgid "None of your programs is using it. A system service or a program of another user may be holding it, or it was released a moment ago."
msgstr "Inget av dina program använder den. En systemtjänst eller ett program som tillhör en annan användare kan hålla den, eller så frigjordes den alldeles nyss."

#: big-mount/usr/lib/big-mount/cli.sh:510
msgid "Try again. If it is still busy, show the programs of all users."
msgstr "Försök igen. Om den fortfarande är upptagen, visa programmen för alla användare."

#: big-mount/usr/lib/big-mount/cli.sh:516
msgid "%s has a file open for writing on this device."
msgstr "%s har en fil öppen för skrivning på den här enheten."

#: big-mount/usr/lib/big-mount/cli.sh:517
msgid "Let it finish, or cancel the operation in that program, then try again."
msgstr "Låt det bli klart, eller avbryt åtgärden i det programmet, och försök sedan igen."

#: big-mount/usr/lib/big-mount/cli.sh:518
msgid "A terminal is open in a folder of this device."
msgstr "En terminal är öppen i en mapp på den här enheten."

#: big-mount/usr/lib/big-mount/cli.sh:519
msgid "Type cd in that terminal, or close it, then try again."
msgstr "Skriv cd i den terminalen, eller stäng den, och försök sedan igen."

#: big-mount/usr/lib/big-mount/cli.sh:520
msgid "%s is showing or reading files of this device."
msgstr "%s visar eller läser filer på den här enheten."

#: big-mount/usr/lib/big-mount/cli.sh:521
msgid "Close the window or tab that shows the device, then try again."
msgstr "Stäng fönstret eller fliken som visar enheten och försök sedan igen."

#: big-mount/usr/lib/big-mount/cli.sh:522
msgid "The file indexer is reading this device."
msgstr "Filindexeraren läser den här enheten."

#: big-mount/usr/lib/big-mount/cli.sh:523
msgid "It usually finishes in a moment: try again shortly."
msgstr "Den brukar bli klar på ett ögonblick: försök igen om en stund."

#: big-mount/usr/lib/big-mount/cli.sh:524
msgid "%s is running inside a folder of this device."
msgstr "%s körs inuti en mapp på den här enheten."

#: big-mount/usr/lib/big-mount/cli.sh:525
#: big-mount/usr/lib/big-mount/cli.sh:527
msgid "Close that program, then try again."
msgstr "Stäng det programmet och försök sedan igen."

#: big-mount/usr/lib/big-mount/cli.sh:526
msgid "%s is using files on this device."
msgstr "%s använder filer på den här enheten."

#: big-mount/usr/lib/big-mount/cli.sh:530
msgid "In total, %d programs are using it."
msgstr "Antal program som använder den: %d."

#: big-mount/usr/lib/big-mount/cli.sh:543
msgid "In use"
msgstr "Används"

#: big-mount/usr/lib/big-mount/cli.sh:547
msgid "%s is still in use"
msgstr "%s används fortfarande"

#: big-mount/usr/lib/big-mount/cli.sh:557
msgid "Programs using it:"
msgstr "Program som använder den:"

#: big-mount/usr/lib/big-mount/cli.sh:559
#: big-mount/usr/lib/big-mount/cli.sh:561
msgid "Application"
msgstr "Program"

#: big-mount/usr/lib/big-mount/cli.sh:559
#: big-mount/usr/lib/big-mount/cli.sh:561
msgid "process"
msgstr "process"

#: big-mount/usr/lib/big-mount/cli.sh:559
msgid "User"
msgstr "Användare"

#: big-mount/usr/lib/big-mount/cli.sh:559
#: big-mount/usr/lib/big-mount/cli.sh:561
msgid "Activity"
msgstr "Aktivitet"

#: big-mount/usr/lib/big-mount/cli.sh:577
msgid "Also keeping it busy:"
msgstr "Annat som håller den upptagen:"

#: big-mount/usr/lib/big-mount/cli.sh:581
msgid "An open file does not necessarily mean that something is being copied."
msgstr "En öppen fil betyder inte nödvändigtvis att något kopieras."

#: big-mount/usr/lib/big-mount/cli.sh:608
msgid "%s is not in use"
msgstr "%s används inte"

#: big-mount/usr/lib/big-mount/cli.sh:610
msgid "No program and nothing in the system is using it. It can be unmounted."
msgstr "Inget program och ingenting i systemet använder den. Den kan avmonteras."

#: big-mount/usr/lib/big-mount/cli.sh:612
msgid "None of your programs is using %s"
msgstr "Inget av dina program använder %s"

#: big-mount/usr/lib/big-mount/cli.sh:614
msgid "No program of yours, no other mount and no other device is using it. It can probably be unmounted. Programs of other users and of the system are only visible to an administrator."
msgstr "Inget av dina program, ingen annan montering och ingen annan enhet använder den. Den kan troligen avmonteras. Program som tillhör andra användare och systemet syns bara för en administratör."

#: big-mount/usr/lib/big-mount/cli.sh:643
msgid "The device was disconnected or replaced during the operation. Nothing else was done."
msgstr "Enheten kopplades från eller byttes ut under åtgärden. Inget annat gjordes."

#: big-mount/usr/lib/big-mount/cli.sh:702
msgid "%s was mounted again at %s"
msgstr "%s monterades igen på %s"

#: big-mount/usr/lib/big-mount/cli.sh:718
msgid "%s: the encrypted volume could not be locked"
msgstr "%s: den krypterade volymen kunde inte låsas"

#: big-mount/usr/lib/big-mount/cli.sh:760
msgid "They do not start again by themselves when the device comes back."
msgstr "De startar inte igen av sig själva när enheten kommer tillbaka."

#: big-mount/usr/lib/big-mount/cli.sh:762
msgid "They start again by themselves when the device is mounted again."
msgstr "De startar igen av sig själva när enheten monteras igen."

#: big-mount/usr/lib/big-mount/cli.sh:805
#: big-mount/usr/lib/big-mount/drive.sh:478
msgid "Another removal of this drive is in progress. Nothing was done."
msgstr "En annan urkoppling av den här disken pågår. Ingenting gjordes."

#: big-mount/usr/lib/big-mount/cli.sh:821
msgid "Device removed safely. It can be disconnected now."
msgstr "Enheten har kopplats ur säkert. Den kan kopplas från nu."

#: big-mount/usr/lib/big-mount/cli.sh:823
#: big-mount/usr/lib/big-mount/drive.sh:497
msgid "Unmounted. Everything was written to the device."
msgstr "Avmonterad. Allt skrevs till enheten."

#: big-mount/usr/lib/big-mount/cli.sh:835
msgid "These programs can be asked to close (unsaved changes in them may be lost):"
msgstr "Dessa program kan ombes att avslutas (osparade ändringar i dem kan gå förlorade):"

#: big-mount/usr/lib/big-mount/cli.sh:839
#: big-mount/usr/lib/big-mount/cli.sh:1372
msgid "Close them"
msgstr "Stäng dem"

#: big-mount/usr/lib/big-mount/cli.sh:839
#: big-mount/usr/lib/big-mount/cli.sh:852
#: big-mount/usr/lib/big-mount/cli.sh:1132
#: big-mount/usr/lib/big-mount/cli.sh:1145
#: big-mount/usr/lib/big-mount/cli.sh:1296
#: big-mount/usr/lib/big-mount/cli.sh:1348
#: big-mount/usr/lib/big-mount/cli.sh:1372
#: big-mount/usr/lib/big-mount/cli.sh:1445
msgid "Cancel"
msgstr "Avbryt"

#: big-mount/usr/lib/big-mount/cli.sh:842
msgid "Still running: %s"
msgstr "Körs fortfarande: %s"

#: big-mount/usr/lib/big-mount/cli.sh:845
#: big-mount/usr/lib/big-mount/drive.sh:502
msgid "These services use the device and will be stopped when it is unmounted:"
msgstr "Dessa tjänster använder enheten och stoppas när den avmonteras:"

#: big-mount/usr/lib/big-mount/cli.sh:852
#: big-mount/usr/lib/big-mount/cli.sh:1132
msgid "Stop them and continue"
msgstr "Stoppa dem och fortsätt"

#: big-mount/usr/lib/big-mount/cli.sh:855
msgid "Nothing was done. Run again with --assume-yes to stop them."
msgstr "Ingenting gjordes. Kör igen med --assume-yes för att stoppa dem."

#: big-mount/usr/lib/big-mount/cli.sh:859
msgid "Unmounted, but powering the drive off failed (%s). Wait a moment before disconnecting it."
msgstr "Avmonterad, men det gick inte att stänga av disken (%s). Vänta en stund innan du kopplar från den."

#: big-mount/usr/lib/big-mount/cli.sh:860
#: big-mount/usr/lib/big-mount/drive.sh:499
msgid "Refused: this drive holds the running system (%s)."
msgstr "Nekades: den här disken innehåller systemet som körs (%s)."

#: big-mount/usr/lib/big-mount/cli.sh:861
#: big-mount/usr/lib/big-mount/drive.sh:500
msgid "Permission to unmount was not granted."
msgstr "Behörighet att avmontera beviljades inte."

#: big-mount/usr/lib/big-mount/cli.sh:862
msgid "Unmounted, but the drive is still in use (%s), so it was not powered off."
msgstr "Avmonterad, men disken används fortfarande (%s), så den stängdes inte av."

#: big-mount/usr/lib/big-mount/cli.sh:863
msgid "Unmounted. This drive cannot be powered off by the computer; it can be disconnected now."
msgstr "Avmonterad. Datorn kan inte stänga av den här disken; den kan kopplas från nu."

#: big-mount/usr/lib/big-mount/cli.sh:866
#: big-mount/usr/lib/big-mount/drive.sh:506
msgid "Could not unmount: %s"
msgstr "Kunde inte avmontera: %s"

#: big-mount/usr/lib/big-mount/cli.sh:887
msgid "The drive reports errors"
msgstr "Disken rapporterar fel"

#: big-mount/usr/lib/big-mount/cli.sh:887
msgid "No drive errors found"
msgstr "Inga diskfel hittades"

#: big-mount/usr/lib/big-mount/cli.sh:890
#: big-mount/usr/lib/big-mount/cli.sh:973
msgid "Drive"
msgstr "Disk"

#: big-mount/usr/lib/big-mount/cli.sh:891
#: big-mount/usr/lib/big-mount/drive-diag.sh:288
#: big-mount/usr/lib/big-mount/drive.sh:241
msgid "Connection"
msgstr "Anslutning"

#: big-mount/usr/lib/big-mount/cli.sh:893
msgid "no problem reported"
msgstr "inga problem rapporterade"

#: big-mount/usr/lib/big-mount/cli.sh:894
msgid "the drive predicts its own failure"
msgstr "disken förutspår sitt eget haveri"

#: big-mount/usr/lib/big-mount/cli.sh:898
msgid "no failure predicted (%s damaged sectors were replaced by spare ones)"
msgstr "inget haveri förutspått (skadade sektorer som ersatts med reservsektorer: %s)"

#: big-mount/usr/lib/big-mount/cli.sh:900
msgid "SMART status"
msgstr "SMART-status"

#: big-mount/usr/lib/big-mount/cli.sh:903
msgid "Since the computer was started, the system recorded no read, write or connection errors for this drive."
msgstr "Sedan datorn startades har systemet inte registrerat några läs-, skriv- eller anslutningsfel för den här disken."

#: big-mount/usr/lib/big-mount/cli.sh:905
msgid "The kernel log cannot be read by your user, so recent errors of this drive cannot be checked."
msgstr "Kärnloggen kan inte läsas av din användare, så nya fel på den här disken kan inte kontrolleras."

#: big-mount/usr/lib/big-mount/cli.sh:909
msgid "Problems found:"
msgstr "Problem som hittades:"

#: big-mount/usr/lib/big-mount/cli.sh:912
#: big-mount/usr/lib/big-mount/drive-diag.sh:228
msgid "The drive itself reports that it is failing (SMART)."
msgstr "Disken rapporterar själv att den håller på att gå sönder (SMART)."

#: big-mount/usr/lib/big-mount/cli.sh:913
#: big-mount/usr/lib/big-mount/drive-diag.sh:233
msgid "Since the computer was started, it stopped answering and the connection had to be reset (%s kernel messages)."
msgstr "Sedan datorn startades har den slutat svara och anslutningen har fått återställas (kärnmeddelanden: %s)."

#: big-mount/usr/lib/big-mount/cli.sh:914
#: big-mount/usr/lib/big-mount/drive-diag.sh:232
msgid "Since the computer was started, reading or writing failed (%s kernel messages)."
msgstr "Sedan datorn startades har läsning eller skrivning misslyckats (kärnmeddelanden: %s)."

#: big-mount/usr/lib/big-mount/cli.sh:915
#: big-mount/usr/lib/big-mount/drive-diag.sh:235
msgid "Since the computer was started, the connection was slowed down after errors."
msgstr "Sedan datorn startades har anslutningen gjorts långsammare efter fel."

#: big-mount/usr/lib/big-mount/cli.sh:916
#: big-mount/usr/lib/big-mount/drive-diag.sh:234
msgid "Since the computer was started, the USB connection was reset or lost %s times."
msgstr "Sedan datorn startades har USB-anslutningen återställts eller förlorats (antal gånger: %s)."

#: big-mount/usr/lib/big-mount/cli.sh:921
msgid "Check the data and power cables of the drive, or try another SATA port."
msgstr "Kontrollera diskens data- och strömkablar, eller prova en annan SATA-port."

#: big-mount/usr/lib/big-mount/cli.sh:922
msgid "An SSD that fails like this may lock itself in a protection mode: it seems to accept writing, but keeps nothing. Installers then cannot create partitions, and erased partitions come back. The drive's own Secure Erase can bring it back to work, but it erases everything on it."
msgstr "En SSD som går sönder på det här sättet kan låsa sig i ett skyddsläge: den verkar ta emot skrivning, men behåller ingenting. Installationsprogram kan då inte skapa partitioner, och raderade partitioner kommer tillbaka. Diskens egen säkra radering (Secure Erase) kan få den att fungera igen, men den raderar allt på den."

#: big-mount/usr/lib/big-mount/cli.sh:923
msgid "If the errors come back, replace the drive."
msgstr "Om felen kommer tillbaka, byt ut disken."

#: big-mount/usr/lib/big-mount/cli.sh:950
msgid "Secure Erase is available for this drive: bigmount --secure-erase %s"
msgstr "Säker radering (Secure Erase) är tillgänglig för den här disken: bigmount --secure-erase %s"

#: big-mount/usr/lib/big-mount/cli.sh:957
msgid "Secure Erase works on a whole drive, not on a partition."
msgstr "Säker radering fungerar på en hel disk, inte på en partition."

#: big-mount/usr/lib/big-mount/cli.sh:958
msgid "The kernel gives this drive no sequence number, so another drive connected under the same name could not be told apart from it."
msgstr "Kärnan ger den här disken inget sekvensnummer, så en annan disk som ansluts under samma namn skulle inte kunna skiljas från den."

#: big-mount/usr/lib/big-mount/cli.sh:959
msgid "It holds the operating system that is running now. Start the computer from a live USB drive to erase it."
msgstr "Den innehåller operativsystemet som körs nu. Starta datorn från ett live-USB-minne för att radera den."

#: big-mount/usr/lib/big-mount/cli.sh:960
msgid "Secure Erase is only offered for drives connected inside the computer, not through USB."
msgstr "Säker radering erbjuds bara för diskar som är anslutna inuti datorn, inte via USB."

#: big-mount/usr/lib/big-mount/cli.sh:961
msgid "Secure Erase is only available for SATA drives."
msgstr "Säker radering är bara tillgänglig för SATA-diskar."

#: big-mount/usr/lib/big-mount/cli.sh:962
msgid "This drive does not support Secure Erase."
msgstr "Den här disken har inte stöd för säker radering."

#: big-mount/usr/lib/big-mount/cli.sh:963
msgid "A security password is set on this drive. Remove it first, in the firmware setup (BIOS) or with the tool of the manufacturer."
msgstr "Ett säkerhetslösenord är inställt på den här disken. Ta bort det först, i firmware-inställningarna (BIOS) eller med tillverkarens verktyg."

#: big-mount/usr/lib/big-mount/cli.sh:964
msgid "This drive cannot be erased."
msgstr "Den här disken kan inte raderas."

#: big-mount/usr/lib/big-mount/cli.sh:972
msgid "Erase the whole drive"
msgstr "Radera hela disken"

#: big-mount/usr/lib/big-mount/cli.sh:974
msgid "The drive will erase itself completely, with its own Secure Erase command. Every partition and every file on it will be lost for good. This cannot be undone."
msgstr "Disken raderar sig själv helt, med sitt eget kommando för säker radering (Secure Erase). Varje partition och varje fil på den går förlorad för gott. Det här kan inte ångras."

#: big-mount/usr/lib/big-mount/cli.sh:982
msgid "These partitions will be lost:"
msgstr "Dessa partitioner går förlorade:"

#: big-mount/usr/lib/big-mount/cli.sh:986
msgid "The drive announces that erasing takes more than 8 hours."
msgstr "Disken uppger att raderingen tar mer än 8 timmar."

#: big-mount/usr/lib/big-mount/cli.sh:988
msgid "The drive announces that erasing takes about %d minutes."
msgstr "Disken uppger att raderingen tar ungefär %d minuter."

#: big-mount/usr/lib/big-mount/cli.sh:992
msgid "Afterwards an empty %s partition table is written and read back, to check that the drive keeps what is written again."
msgstr "Efteråt skrivs en tom %s-partitionstabell som läses tillbaka, för att kontrollera att disken behåller det som skrivs igen."

#: big-mount/usr/lib/big-mount/cli.sh:994
msgid "Use it to bring back an SSD that no longer keeps what is written, or before giving a drive away. It is not a repair: if the drive fails again, replace it."
msgstr "Använd det för att få tillbaka en SSD som inte längre behåller det som skrivs, eller innan du ger bort en disk. Det är ingen reparation: om disken går sönder igen, byt ut den."

#: big-mount/usr/lib/big-mount/cli.sh:995
msgid "The computer may have to sleep for a moment first."
msgstr "Datorn kan behöva gå in i vänteläge en kort stund först."

#: big-mount/usr/lib/big-mount/cli.sh:996
msgid "The administrator password will be requested."
msgstr "Administratörslösenordet kommer att efterfrågas."

#: big-mount/usr/lib/big-mount/cli.sh:1001
msgid "The drive is locked against erasing"
msgstr "Disken är låst mot radering"

#: big-mount/usr/lib/big-mount/cli.sh:1004
msgid "When the computer starts, its firmware locks the security commands of the drives (they are frozen). Sleeping once usually unlocks them."
msgstr "När datorn startar låser dess firmware diskarnas säkerhetskommandon (de är frysta). Att gå in i vänteläge en gång låser oftast upp dem."

#: big-mount/usr/lib/big-mount/cli.sh:1006
msgid "The computer will sleep and wake up by itself after about 20 seconds."
msgstr "Datorn går in i vänteläge och vaknar av sig själv efter ungefär 20 sekunder."

#: big-mount/usr/lib/big-mount/cli.sh:1008
msgid "The computer will go to sleep. Wake it up with the power button, and unlock the session if asked: the erase continues afterwards."
msgstr "Datorn går in i vänteläge. Väck den med strömbrytaren och lås upp sessionen om du ombeds: raderingen fortsätter sedan."

#: big-mount/usr/lib/big-mount/cli.sh:1016
msgid "Unable to erase the drive"
msgstr "Det gick inte att radera disken"

#: big-mount/usr/lib/big-mount/cli.sh:1020
msgid "Drive erased"
msgstr "Disken har raderats"

#: big-mount/usr/lib/big-mount/cli.sh:1023
msgid "The drive was erased and keeps what is written again. It now has an empty %s partition table: you can install a system or create partitions on it."
msgstr "Disken har raderats och behåller det som skrivs igen. Den har nu en tom %s-partitionstabell: du kan installera ett system eller skapa partitioner på den."

#: big-mount/usr/lib/big-mount/cli.sh:1025
msgid "It failed once: keep a copy of what you store on it, and replace it if the errors come back."
msgstr "Den har gått sönder en gång: behåll en kopia av det du lagrar på den, och byt ut den om felen kommer tillbaka."

#: big-mount/usr/lib/big-mount/cli.sh:1028
msgid "The drive is still locked"
msgstr "Disken är fortfarande låst"

#: big-mount/usr/lib/big-mount/cli.sh:1030
msgid "The drive is still locked against erasing. Nothing was erased."
msgstr "Disken är fortfarande låst mot radering. Ingenting raderades."

#: big-mount/usr/lib/big-mount/cli.sh:1031
msgid "Some computers lock the drives again when they wake up. Try once more, or erase the drive in another computer."
msgstr "Vissa datorer låser diskarna igen när de vaknar. Försök en gång till, eller radera disken i en annan dator."

#: big-mount/usr/lib/big-mount/cli.sh:1032
msgid "If the computer supports hot-plugging SATA drives, disconnecting and connecting the drive while the computer is on also unlocks it."
msgstr "Om datorn stöder hot-plug av SATA-diskar kan du också låsa upp disken genom att koppla från den och ansluta den igen medan datorn är på."

#: big-mount/usr/lib/big-mount/cli.sh:1037
msgid "Drive erased, not verified"
msgstr "Disken har raderats, men inte verifierats"

#: big-mount/usr/lib/big-mount/cli.sh:1039
msgid "The drive was erased, but writing a new partition table failed (%s), so it could not be checked."
msgstr "Disken har raderats, men det gick inte att skriva en ny partitionstabell (%s), så den kunde inte kontrolleras."

#: big-mount/usr/lib/big-mount/cli.sh:1041
msgid "Create a partition table with KDE Partition Manager, and check that it is still there after a restart."
msgstr "Skapa en partitionstabell med KDE Partition Manager och kontrollera att den fortfarande finns kvar efter en omstart."

#: big-mount/usr/lib/big-mount/cli.sh:1044
#: big-mount/usr/lib/big-mount/cli.sh:1049
msgid "The drive is failing"
msgstr "Disken håller på att gå sönder"

#: big-mount/usr/lib/big-mount/cli.sh:1046
