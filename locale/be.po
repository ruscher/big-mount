msgstr "Недаступна: %s"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:717
#, python-format
msgid "Use %s"
msgstr "Выкарыстаць %s"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:719
