<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>BigLinux</vendor>
  <vendor_url>https://www.biglinux.com.br</vendor_url>
  <!-- Read-only: lists the processes of every user that keep one mount point busy -->
  <action id="org.biglinux.big-mount.inspect-processes">
    <description>Show the programs of all users that keep a storage device busy</description>
    <description xml:lang="zh_TW">顯示所有使用者中讓儲存裝置處於忙碌狀態的程式</description>
    <description xml:lang="zh_CN">显示让存储设备处于忙碌状态的所有用户的程序</description>
    <description xml:lang="uk">Показати програми всіх користувачів, що утримують пристрій зберігання зайнятим</description>
    <description xml:lang="tr">Bir depolama aygıtını meşgul eden tüm kullanıcıların programlarını göster</description>
    <description xml:lang="sv">Visa alla användares program som håller en lagringsenhet upptagen</description>
    <description xml:lang="sk">Zobraziť programy všetkých používateľov, ktoré používajú úložné zariadenie</description>
    <description xml:lang="ru">Показать программы всех пользователей, удерживающие устройство хранения</description>
    <description xml:lang="ro">Arată programele tuturor utilizatorilor care țin ocupat un dispozitiv de stocare</description>
    <description xml:lang="pt_BR">Mostrar os programas de todos os usuários que mantêm um dispositivo de armazenamento ocupado</description>
    <description xml:lang="pt">Mostrar os programas de todos os utilizadores que mantêm um dispositivo de armazenamento ocupado</description>
    <description xml:lang="pl">Wyświetlanie programów wszystkich użytkowników, które zajmują urządzenie pamięci masowej</description>
    <description xml:lang="nl">De programma's van alle gebruikers tonen die een opslagapparaat bezet houden</description>
    <description xml:lang="nb">Vis programmene til alle brukere som holder en lagringsenhet opptatt</description>
    <description xml:lang="ko">저장 장치를 사용 중인 모든 사용자의 프로그램 표시</description>
    <description xml:lang="ja">ストレージデバイスを使用中にしている、すべてのユーザーのプログラムを表示します</description>
    <description xml:lang="it">Mostra i programmi di tutti gli utenti che tengono occupato un dispositivo di archiviazione</description>
    <description xml:lang="is">Sýna forrit allra notenda sem halda gagnageymslutæki uppteknu</description>
    <description xml:lang="hu">Az összes felhasználó azon programjainak megjelenítése, amelyek foglalva tartanak egy tárolóeszközt</description>
    <description xml:lang="hr">Prikaži programe svih korisnika koji drže uređaj za pohranu zauzetim</description>
    <description xml:lang="he">הצגת התוכניות של כל המשתמשים שמעסיקות התקן אחסון</description>
    <description xml:lang="fr">Afficher les programmes de tous les utilisateurs qui occupent un périphérique de stockage</description>
    <description xml:lang="fi">Näytä kaikkien käyttäjien ohjelmat, jotka pitävät tallennuslaitetta varattuna</description>
    <description xml:lang="et">Näita kõigi kasutajate programme, mis hoiavad salvestusseadet hõivatuna</description>
    <description xml:lang="es">Mostrar los programas de todos los usuarios que mantienen ocupado un dispositivo de almacenamiento</description>
    <description xml:lang="en">Show the programs of all users that keep a storage device busy</description>
    <description xml:lang="el">Εμφάνιση των προγραμμάτων όλων των χρηστών που κρατούν μια συσκευή αποθήκευσης σε χρήση</description>
    <description xml:lang="de">Programme aller Benutzer anzeigen, die ein Speichergerät belegen</description>
    <description xml:lang="da">Vis alle brugeres programmer, der holder en lagerenhed optaget</description>
    <description xml:lang="cs">Zobrazit programy všech uživatelů, které blokují úložné zařízení</description>
    <description xml:lang="bg">Показване на програмите на всички потребители, които държат заето устройство за съхранение</description>
    <description xml:lang="be">Паказаць праграмы ўсіх карыстальнікаў, якія трымаюць прыладу захоўвання занятай</description>
    <message>Authentication is required to see the programs of all users that are using this device</message>
    <message xml:lang="zh_TW">需要通過身分驗證才能查看所有使用者中正在使用此裝置的程式</message>
    <message xml:lang="zh_CN">查看正在使用此设备的所有用户的程序需要身份验证</message>
    <message xml:lang="uk">Щоб побачити програми всіх користувачів, які використовують цей пристрій, слід пройти розпізнавання</message>
    <message xml:lang="tr">Bu aygıtı kullanan tüm kullanıcıların programlarını görmek için kimlik doğrulama gerekir</message>
    <message xml:lang="sv">Autentisering krävs för att se alla användares program som använder den här enheten</message>
    <message xml:lang="sk">Zobrazenie programov všetkých používateľov, ktoré používajú toto zariadenie, vyžaduje overenie totožnosti</message>
    <message xml:lang="ru">Для просмотра программ всех пользователей, использующих это устройство, требуется аутентификация</message>
    <message xml:lang="ro">Este necesară autentificarea pentru a vedea programele tuturor utilizatorilor care folosesc acest dispozitiv</message>
    <message xml:lang="pt_BR">É necessário autenticar-se para ver os programas de todos os usuários que estão usando este dispositivo</message>
    <message xml:lang="pt">É necessária autenticação para ver os programas de todos os utilizadores que estão a usar este dispositivo</message>
    <message xml:lang="pl">Wymagane jest uwierzytelnienie, aby wyświetlić programy wszystkich użytkowników, które używają tego urządzenia</message>
    <message xml:lang="nl">Authenticatie is vereist om de programma's te zien van alle gebruikers die dit apparaat gebruiken</message>
    <message xml:lang="nb">Autentisering kreves for å se programmene til alle brukere som bruker denne enheten</message>
    <message xml:lang="ko">이 장치를 사용 중인 모든 사용자의 프로그램을 보려면 인증이 필요합니다</message>
    <message xml:lang="ja">このデバイスを使用している、すべてのユーザーのプログラムを表示するには、認証が必要です</message>
    <message xml:lang="it">È richiesta l'autenticazione per vedere i programmi di tutti gli utenti che stanno usando questo dispositivo</message>
    <message xml:lang="is">Auðkenningar er krafist til að sjá forrit allra notenda sem nota þetta tæki</message>
    <message xml:lang="hu">Hitelesítés szükséges az összes felhasználó azon programjainak megtekintéséhez, amelyek ezt az eszközt használják</message>
    <message xml:lang="hr">Potrebna je ovjera za prikaz programa svih korisnika koji koriste ovaj uređaj</message>
    <message xml:lang="he">נדרש אימות כדי לראות את התוכניות של כל המשתמשים שמשתמשות בהתקן הזה</message>
    <message xml:lang="fr">Une authentification est nécessaire pour voir les programmes de tous les utilisateurs qui utilisent ce périphérique</message>
    <message xml:lang="fi">Kaikkien käyttäjien tätä laitetta käyttävien ohjelmien näkeminen vaatii tunnistautumisen</message>
    <message xml:lang="et">Autentimine on vajalik, et näha kõigi kasutajate programme, mis seda seadet kasutavad</message>
    <message xml:lang="es">Se requiere autenticación para ver los programas de todos los usuarios que están usando este dispositivo</message>
    <message xml:lang="en">Authentication is required to see the programs of all users that are using this device</message>
    <message xml:lang="el">Απαιτείται πιστοποίηση για να δείτε τα προγράμματα όλων των χρηστών που χρησιμοποιούν αυτή τη συσκευή</message>
    <message xml:lang="de">Legitimierung ist erforderlich, um die Programme aller Benutzer anzuzeigen, die dieses Gerät verwenden</message>
    <message xml:lang="da">Der kræves godkendelse for at se alle brugeres programmer, der bruger denne enhed</message>
    <message xml:lang="cs">Pro zobrazení programů všech uživatelů, které toto zařízení používají, je vyžadováno ověření</message>
    <message xml:lang="bg">За да видите програмите на всички потребители, които използват това устройство, е необходима идентификация</message>
    <message xml:lang="be">Каб убачыць праграмы ўсіх карыстальнікаў, якія выкарыстоўваюць гэтую прыладу, патрабуецца аўтэнтыфікацыя</message>
    <icon_name>big-mount</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/big-mount/bigmount-holders</annotate>
  </action>
  <!-- Blocks or allows writing on a device, reads SMART, images a disk: never changes data on it -->
  <action id="org.biglinux.big-mount.drive-helper">
    <description>Protect a storage device, read its health or make a disk image</description>
    <description xml:lang="zh_TW">保護儲存裝置、讀取其健康狀態或製作磁碟映像檔</description>
    <description xml:lang="zh_CN">保护存储设备、读取其健康状况或制作磁盘映像</description>
    <description xml:lang="uk">Захистити пристрій зберігання, прочитати його стан або створити образ диска</description>
    <description xml:lang="tr">Bir depolama aygıtını koru, sağlık durumunu oku ya da disk görüntüsü oluştur</description>
    <description xml:lang="sv">Skydda en lagringsenhet, läsa dess hälsa eller skapa en diskavbild</description>
    <description xml:lang="sk">Chrániť úložné zariadenie, čítať jeho zdravotný stav alebo vytvoriť obraz disku</description>
    <description xml:lang="ru">Защитить устройство хранения, прочитать его состояние или создать образ диска</description>
    <description xml:lang="ro">Protejează un dispozitiv de stocare, citește-i sănătatea sau creează o imagine de disc</description>
    <description xml:lang="pt_BR">Proteger um dispositivo de armazenamento, ler a saúde dele ou fazer uma imagem de disco</description>
    <description xml:lang="pt">Proteger um dispositivo de armazenamento, ler a sua saúde ou criar uma imagem de disco</description>
    <description xml:lang="pl">Ochrona urządzenia pamięci masowej, odczyt jego kondycji lub tworzenie obrazu dysku</description>
    <description xml:lang="nl">Een opslagapparaat beveiligen, de gezondheid ervan lezen of een schijfkopie maken</description>
    <description xml:lang="nb">Beskytt en lagringsenhet, les helsen eller lag et diskbilde</description>
    <description xml:lang="ko">저장 장치 보호, 건강 상태 읽기 또는 디스크 이미지 만들기</description>
    <description xml:lang="ja">ストレージデバイスを保護し、健康状態を読み取り、ディスクイメージを作成します</description>
    <description xml:lang="it">Proteggi un dispositivo di archiviazione, leggine lo stato di salute o creane un'immagine disco</description>
    <description xml:lang="is">Vernda gagnageymslutæki, lesa ástand þess eða búa til diskmynd</description>
    <description xml:lang="hu">Tárolóeszköz védelme, egészségi állapotának beolvasása vagy lemezkép készítése</description>
    <description xml:lang="hr">Zaštiti uređaj za pohranu, pročitaj njegovo zdravlje ili izradi sliku diska</description>
    <description xml:lang="he">הגנה על התקן אחסון, קריאת הבריאות שלו או יצירת דמות כונן</description>
    <description xml:lang="fr">Protéger un périphérique de stockage, lire sa santé ou créer une image disque</description>
    <description xml:lang="fi">Suojaa tallennuslaite, lue sen kunto tai tee levykuva</description>
    <description xml:lang="et">Kaitse salvestusseadet, loe selle seisundit või tee kettatõmmis</description>
    <description xml:lang="es">Proteger un dispositivo de almacenamiento, leer su salud o crear una imagen de disco</description>
    <description xml:lang="en">Protect a storage device, read its health or make a disk image</description>
    <description xml:lang="el">Προστασία συσκευής αποθήκευσης, ανάγνωση της υγείας της ή δημιουργία εικόνας δίσκου</description>
    <description xml:lang="de">Ein Speichergerät schützen, seinen Zustand lesen oder ein Laufwerksabbild erstellen</description>
    <description xml:lang="da">Beskyt en lagerenhed, læs dens tilstand, eller lav et diskaftryk</description>
    <description xml:lang="cs">Chránit úložné zařízení, číst jeho stav zdraví nebo vytvořit obraz disku</description>
    <description xml:lang="bg">Защита на устройство за съхранение, прочитане на състоянието му или създаване на образ на диск</description>
    <description xml:lang="be">Абараніць прыладу захоўвання, прачытаць звесткі пра яе здароўе або стварыць вобраз дыска</description>
    <message>Authentication is required to protect this storage device, read its health or make a disk image</message>
    <message xml:lang="zh_TW">需要通過身分驗證才能保護此儲存裝置、讀取其健康狀態或製作磁碟映像檔</message>
    <message xml:lang="zh_CN">保护此存储设备、读取其健康状况或制作磁盘映像需要身份验证</message>
    <message xml:lang="uk">Щоб захистити цей пристрій зберігання, прочитати його стан або створити образ диска, слід пройти розпізнавання</message>
    <message xml:lang="tr">Bu depolama aygıtını korumak, sağlık durumunu okumak ya da disk görüntüsü oluşturmak için kimlik doğrulama gerekir</message>
    <message xml:lang="sv">Autentisering krävs för att skydda den här lagringsenheten, läsa dess hälsa eller skapa en diskavbild</message>
    <message xml:lang="sk">Ochrana tohto úložného zariadenia, čítanie jeho zdravotného stavu alebo vytvorenie obrazu disku vyžaduje overenie totožnosti</message>
    <message xml:lang="ru">Для защиты этого устройства хранения, чтения его состояния или создания образа диска требуется аутентификация</message>
    <message xml:lang="ro">Este necesară autentificarea pentru a proteja acest dispozitiv de stocare, a-i citi sănătatea sau a crea o imagine de disc</message>
    <message xml:lang="pt_BR">É necessário autenticar-se para proteger este dispositivo de armazenamento, ler a saúde dele ou fazer uma imagem de disco</message>
    <message xml:lang="pt">É necessária autenticação para proteger este dispositivo de armazenamento, ler a sua saúde ou criar uma imagem de disco</message>
    <message xml:lang="pl">Wymagane jest uwierzytelnienie, aby chronić to urządzenie pamięci masowej, odczytać jego kondycję lub utworzyć obraz dysku</message>
    <message xml:lang="nl">Authenticatie is vereist om dit opslagapparaat te beveiligen, de gezondheid ervan te lezen of een schijfkopie te maken</message>
    <message xml:lang="nb">Autentisering kreves for å beskytte denne lagringsenheten, lese helsen eller lage et diskbilde</message>
    <message xml:lang="ko">이 저장 장치를 보호하거나, 건강 상태를 읽거나, 디스크 이미지를 만들려면 인증이 필요합니다</message>
    <message xml:lang="ja">このストレージデバイスを保護する、健康状態を読み取る、またはディスクイメージを作成するには、認証が必要です</message>
    <message xml:lang="it">È richiesta l'autenticazione per proteggere questo dispositivo di archiviazione, leggerne lo stato di salute o crearne un'immagine disco</message>
    <message xml:lang="is">Auðkenningar er krafist til að vernda þetta gagnageymslutæki, lesa ástand þess eða búa til diskmynd</message>
    <message xml:lang="hu">Hitelesítés szükséges a tárolóeszköz védelméhez, egészségi állapotának beolvasásához vagy lemezkép készítéséhez</message>
    <message xml:lang="hr">Potrebna je ovjera za zaštitu ovog uređaja za pohranu, čitanje njegova zdravlja ili izradu slike diska</message>
    <message xml:lang="he">נדרש אימות כדי להגן על התקן האחסון הזה, לקרוא את הבריאות שלו או ליצור דמות כונן</message>
    <message xml:lang="fr">Une authentification est nécessaire pour protéger ce périphérique de stockage, lire sa santé ou créer une image disque</message>
    <message xml:lang="fi">Tämän tallennuslaitteen suojaaminen, sen kunnon lukeminen tai levykuvan tekeminen vaatii tunnistautumisen</message>
    <message xml:lang="et">Autentimine on vajalik, et kaitsta seda salvestusseadet, lugeda selle seisundit või teha kettatõmmis</message>
    <message xml:lang="es">Se requiere autenticación para proteger este dispositivo de almacenamiento, leer su salud o crear una imagen de disco</message>
    <message xml:lang="en">Authentication is required to protect this storage device, read its health or make a disk image</message>
    <message xml:lang="el">Απαιτείται πιστοποίηση για την προστασία αυτής της συσκευής αποθήκευσης, την ανάγνωση της υγείας της ή τη δημιουργία εικόνας δίσκου</message>
    <message xml:lang="de">Legitimierung ist erforderlich, um dieses Speichergerät zu schützen, seinen Zustand zu lesen oder ein Laufwerksabbild zu erstellen</message>
    <message xml:lang="da">Der kræves godkendelse for at beskytte denne lagerenhed, læse dens tilstand eller lave et diskaftryk</message>
    <message xml:lang="cs">Pro ochranu tohoto úložného zařízení, čtení jeho stavu zdraví nebo vytvoření obrazu disku je vyžadováno ověření</message>
    <message xml:lang="bg">За да защитите това устройство за съхранение, да прочетете състоянието му или да създадете образ на диск, е необходима идентификация</message>
    <message xml:lang="be">Каб абараніць гэтую прыладу захоўвання, прачытаць звесткі пра яе здароўе або стварыць вобраз дыска, патрабуецца аўтэнтыфікацыя</message>
    <icon_name>big-mount</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/big-mount/bigmount-drive-helper</annotate>
  </action>
</policyconfig>
