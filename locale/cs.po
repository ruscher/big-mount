msgstr "JMENOVKA"

#: big-mount/usr/lib/big-mount/cli.sh:374
msgid "SIZE"
msgstr "VELIKOST"

#: big-mount/usr/lib/big-mount/cli.sh:374
msgid "FS"
msgstr "FS"

#: big-mount/usr/lib/big-mount/cli.sh:374
msgid "MANAGED BY"
msgstr "SPRAVUJE"

#: big-mount/usr/lib/big-mount/cli.sh:374
msgid "MOUNTED AT"
msgstr "PŘIPOJENO DO"

#: big-mount/usr/lib/big-mount/cli.sh:374
msgid "STATE"
msgstr "STAV"

#: big-mount/usr/lib/big-mount/cli.sh:384
msgid "not mounted"
msgstr "nepřipojeno"

#: big-mount/usr/lib/big-mount/cli.sh:386
