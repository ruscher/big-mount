#: big-mount/usr/lib/big-mount/doctor.sh:272
msgid "Partitions handled by Big-Mount at boot: %d"
msgstr "Particije kojima Big-Mount upravlja pri pokretanju: %d"

#: big-mount/usr/lib/big-mount/doctor.sh:273
msgid "Failed at boot"
msgstr "Nije uspjelo pri pokretanju"

#: big-mount/usr/lib/big-mount/doctor.sh:274
msgid "Mounted read-only at boot"
msgstr "Montirano samo za čitanje pri pokretanju"

#: big-mount/usr/lib/big-mount/doctor.sh:280
msgid "Configuration: PERMISSIONS=%s"
msgstr "Konfiguracija: PERMISSIONS=%s"

#: big-mount/usr/lib/big-mount/doctor.sh:281
