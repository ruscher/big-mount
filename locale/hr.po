#, python-format
msgid "%d item you marked"
msgid_plural "%d items you marked"
msgstr[0] "%d stavka koju ste označili"
msgstr[1] "%d stavke koje ste označili"
msgstr[2] "%d stavki koje ste označili"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1014
msgid "If a file already exists"
msgstr "Ako datoteka već postoji"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1019
msgid "Check the result"
msgstr "Provjeri rezultat"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1021
msgid "Basic: rsync confirms each file as it is copied"
msgstr "Osnovno: rsync potvrđuje svaku datoteku tijekom kopiranja"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1021
msgid "Names, sizes and dates compared at the end"
msgstr "Nazivi, veličine i datumi uspoređuju se na kraju"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1022
msgid "Content compared at the end (reads the source again)"
msgstr "Sadržaj se uspoređuje na kraju (ponovno čita izvor)"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1026
msgid "Set aside a stuck file after (seconds)"
msgstr "Odgodi zapelu datoteku nakon (sekundi)"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1028
msgid "A file that does not advance for this long is set aside, so that the others are saved first. 0: never."
msgstr "Datoteka koja toliko dugo ne napreduje odgađa se kako bi se ostale najprije spremile. 0: nikada."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1032
msgid "Limit the reading speed (kB/s)"
msgstr "Ograniči brzinu čitanja (kB/s)"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1034
