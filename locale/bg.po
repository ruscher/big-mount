msgstr "Изход"

#: big-mount/usr/lib/big-mount/drive-tui.sh:59
msgid "Choose a device [1-%s]:"
msgstr "Изберете устройство [1-%s]:"

#: big-mount/usr/lib/big-mount/drive-tui.sh:89
msgid "Complete information"
msgstr "Пълна информация"

#: big-mount/usr/lib/big-mount/drive-tui.sh:90
msgid "Storage diagnosis"
msgstr "Диагностика на съхранението"

#: big-mount/usr/lib/big-mount/drive-tui.sh:91
msgid "Mount safely (read-only)"
msgstr "Безопасно монтиране (само за четене)"

#: big-mount/usr/lib/big-mount/drive-tui.sh:92
msgid "Explore files"
msgstr "Разглеждане на файловете"

#: big-mount/usr/lib/big-mount/drive-tui.sh:93
msgid "Copy files to another disk"
msgstr "Копиране на файлове на друг диск"

#: big-mount/usr/lib/big-mount/drive-tui.sh:94
msgid "Advanced recovery"
msgstr "Разширено възстановяване"

#: big-mount/usr/lib/big-mount/drive-tui.sh:95
msgid "Unmount safely"
msgstr "Безопасно демонтиране"

