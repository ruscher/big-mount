# Big-Mount install messages. Nothing is restarted automatically: the boot
# service is enabled by big-mount.hook, the notifier starts with the session.

post_install() {
    echo ":: Big-Mount mounts the internal partitions at the next boot."
    echo "   To mount them now: sudo systemctl start big-mount"
    echo ":: The read-only notifier starts at your next login."
    echo "   Diagnosis: bigmount --diagnose   |   Dolphin: right-click > Storage device"
}

post_upgrade() {
    echo ":: Big-Mount was updated. The new version runs at the next boot."
    echo "   To apply it now (mounted NTFS volumes stay mounted): sudo systemctl restart big-mount"
    echo ":: The notifier picks up the new version at your next login."
}
