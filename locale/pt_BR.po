msgid "APFS driver apfs-fuse installed (also encrypted volumes)"
msgstr "Driver APFS apfs-fuse instalado (também volumes criptografados)"

#: big-mount/usr/lib/big-mount/cli.sh:312
msgid "APFS kernel driver installed (no encrypted volumes)"
msgstr "Driver APFS do kernel instalado (sem volumes criptografados)"

