msgstr "Gestionarul de unități, %s: %s nu este instalat"

#: big-mount/usr/lib/big-mount/doctor.sh:309
msgid "Application and dialogs: GTK 4 and libadwaita"
msgstr "Aplicația și dialogurile: GTK 4 și libadwaita"

#: big-mount/usr/lib/big-mount/doctor.sh:310
msgid "The application and the dialogs need gtk4, libadwaita 1.5 or later and python-gobject: bigmount --gui-drive cannot open and questions are asked in the terminal. bigmount --drive works without them"
msgstr "Aplicația și dialogurile necesită gtk4, libadwaita 1.5 sau mai nou și python-gobject: bigmount --gui-drive nu se poate deschide, iar întrebările sunt puse în terminal. bigmount --drive funcționează fără ele"

#: big-mount/usr/lib/big-mount/doctor.sh:312
msgid "Notifications: notify-send"
msgstr "Notificări: notify-send"

#: big-mount/usr/lib/big-mount/doctor.sh:313
