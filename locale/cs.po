msgstr "%s čte /var/lib/sddm/state.conf, aniž by ověřil, že smí: při spuštění uživatelem hlásí „Permission denied“"

#: big-mount/usr/lib/big-mount/doctor.sh:132
msgid "Update the big-mount package. Never change the permissions of the files of SDDM to work around it."
msgstr "Aktualizujte balíček big-mount. Nikdy kvůli tomu neměňte oprávnění souborů SDDM."

#: big-mount/usr/lib/big-mount/doctor.sh:135
msgid "%s has no diagnosis or safe removal: every option is ignored and it tries to mount the internal partitions instead"
msgstr "%s nemá diagnostiku ani bezpečné odebrání: ignoruje všechny volby a místo toho se pokusí připojit interní oddíly"

