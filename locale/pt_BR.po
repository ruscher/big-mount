#: big-mount/usr/bin/bigmount:83
msgid "bigmount: mounting the internal partitions needs administrator rights. big-mount.service does it at every boot."
msgstr "bigmount: montar as partições internas exige direitos de administrador. O big-mount.service faz isso a cada inicialização."

#: big-mount/usr/bin/bigmount:84
msgid "To mount them now:            sudo systemctl restart big-mount"
msgstr "Para montá-las agora:          sudo systemctl restart big-mount"

#: big-mount/usr/bin/bigmount:85
msgid "To see what would be mounted: bigmount --dry-run"
msgstr "Para ver o que seria montado:  bigmount --dry-run"

#: big-mount/usr/bin/bigmount:86
msgid "To check the installation:    bigmount --doctor"
msgstr "Para verificar a instalação:   bigmount --doctor"

#: big-mount/usr/bin/bigmount:92
msgid "cannot open the lock file /run/lock/big-mount.lock, giving up"
msgstr "não foi possível abrir o arquivo de trava /run/lock/big-mount.lock, desistindo"

#: big-mount/usr/bin/bigmount:96
msgid "another bigmount is still running, giving up"
msgstr "outro bigmount ainda está em execução, desistindo"

#: big-mount/usr/bin/bigmount:138
msgid "last login '%s' is not a known account, ignoring it"
msgstr "o último login '%s' não é uma conta conhecida; ignorando"

#: big-mount/usr/bin/bigmount:159
msgid "/etc/big-mount.conf: unknown value '%s', using shared"
msgstr "/etc/big-mount.conf: valor desconhecido '%s', usando shared"

#: big-mount/usr/bin/bigmount:278
msgid "%s: skipped, %s is not a filesystem"
msgstr "%s: ignorado, %s não é um sistema de arquivos"

#: big-mount/usr/bin/bigmount:284
msgid "%s: skipped, virtual device"
msgstr "%s: ignorado, dispositivo virtual"

#: big-mount/usr/bin/bigmount:291
msgid "%s: skipped, already mounted"
msgstr "%s: ignorado, já está montado"

#: big-mount/usr/bin/bigmount:327
msgid "waiting for udev to finish processing %s"
msgstr "aguardando o udev terminar de processar %s"

#: big-mount/usr/bin/bigmount:377
msgid "%s: udev has no information about it yet, not mounting"
msgstr "%s: o udev ainda não tem informações sobre ele, não será montado"

#: big-mount/usr/bin/bigmount:381
msgid "%s: skipped, hidden by udev/UDisks (UDISKS_IGNORE)"
msgstr "%s: ignorado, oculto pelo udev/UDisks (UDISKS_IGNORE)"

#: big-mount/usr/bin/bigmount:389
msgid "%s: left to UDisks, external device (%s)"
msgstr "%s: deixado para o UDisks, dispositivo externo (%s)"

#: big-mount/usr/bin/bigmount:395
msgid "%s: skipped, listed in /etc/fstab"
msgstr "%s: ignorado, listado no /etc/fstab"

#: big-mount/usr/bin/bigmount:447
msgid "%s: device changed during the scan, not mounting"
msgstr "%s: o dispositivo mudou durante a varredura, não será montado"

#: big-mount/usr/bin/bigmount:473
msgid "%s: NTFS refused read-write mount (%s), retrying read-only"
msgstr "%s: o NTFS recusou a montagem com gravação (%s), tentando somente leitura"

#: big-mount/usr/bin/bigmount:490
msgid "%s: mount of %s on %s failed (exit %s)"
msgstr "%s: a montagem de %s em %s falhou (código %s)"

#: big-mount/usr/bin/bigmount:511
msgid "%s: the driver mounted %s read-only on its own (%s)"
msgstr "%s: o driver montou %s somente para leitura por conta própria (%s)"

#: big-mount/usr/bin/bigmount:518
msgid "%s: would be mounted %s on %s (%s)"
msgstr "%s: seria montado como %s em %s (%s)"

#: big-mount/usr/bin/bigmount:520
msgid "%s: mounted %s on %s (%s)"
msgstr "%s: %s montado em %s (%s)"

#: big-mount/usr/lib/big-mount/cli.sh:24
msgid "Usage: bigmount [OPTION] [DEVICE|FOLDER]"
msgstr "Uso: bigmount [OPÇÃO] [DISPOSITIVO|PASTA]"

#: big-mount/usr/lib/big-mount/cli.sh:27
msgid "(none)"
msgstr "(nenhuma)"

#: big-mount/usr/lib/big-mount/cli.sh:27
msgid "mount internal partitions (run at boot by big-mount.service)"
msgstr "monta as partições internas (executado no boot pelo big-mount.service)"

#: big-mount/usr/lib/big-mount/cli.sh:28
msgid "show what would be mounted, change nothing"
msgstr "mostra o que seria montado, sem alterar nada"

#: big-mount/usr/lib/big-mount/cli.sh:29
msgid "storage overview, or details of one device (a whole disk: drive errors)"
msgstr "visão geral do armazenamento, ou detalhes de um dispositivo (um disco inteiro: erros da unidade)"

#: big-mount/usr/lib/big-mount/cli.sh:30
msgid "show what keeps a device busy"
msgstr "mostra o que mantém um dispositivo ocupado"

#: big-mount/usr/lib/big-mount/cli.sh:31
msgid "unmount one filesystem safely"
msgstr "desmonta um sistema de arquivos com segurança"

#: big-mount/usr/lib/big-mount/cli.sh:32
msgid "unmount every filesystem of the drive and power it off"
msgstr "desmonta todos os sistemas de arquivos da unidade e a desliga"

#: big-mount/usr/lib/big-mount/cli.sh:33
msgid "with --safe-remove: unmount everything, do not power it off"
msgstr "com --safe-remove: desmonta tudo, sem desligar a unidade"

#: big-mount/usr/lib/big-mount/cli.sh:34
msgid "offer to close the programs that keep it busy"
msgstr "oferece fechar os programas que o mantêm ocupado"

#: big-mount/usr/lib/big-mount/cli.sh:35
msgid "do not ask before closing them or stopping services (scripts)"
msgstr "não pergunta antes de fechá-los ou de parar serviços (para scripts)"

#: big-mount/usr/lib/big-mount/cli.sh:36
msgid "graphical diagnosis"
msgstr "diagnóstico gráfico"

#: big-mount/usr/lib/big-mount/cli.sh:37
msgid "graphical safe removal"
msgstr "remoção segura gráfica"

#: big-mount/usr/lib/big-mount/cli.sh:38
msgid "erase a whole SATA drive with its own Secure Erase (asks first)"
msgstr "apaga uma unidade SATA inteira com o Secure Erase dela mesma (pergunta antes)"

#: big-mount/usr/lib/big-mount/cli.sh:39
msgid "drive manager and file rescue in the terminal (bigmount --drive --help)"
msgstr "gerenciador de unidades e resgate de arquivos no terminal (bigmount --drive --help)"

#: big-mount/usr/lib/big-mount/cli.sh:40
msgid "graphical drive manager and file rescue"
msgstr "gerenciador gráfico de unidades e resgate de arquivos"

#: big-mount/usr/lib/big-mount/cli.sh:41
msgid "graphical drive check, with Secure Erase"
msgstr "verificação gráfica de uma unidade, com Secure Erase"

#: big-mount/usr/lib/big-mount/cli.sh:42
msgid "session service: warn about read-only devices"
msgstr "serviço da sessão: avisa sobre dispositivos somente leitura"

#: big-mount/usr/lib/big-mount/cli.sh:43
msgid "check the installation and the storage stack (for bug reports)"
msgstr "verifica a instalação e o sistema de armazenamento (para relatar problemas)"

#: big-mount/usr/lib/big-mount/cli.sh:44
msgid "show the version and the source revision"
msgstr "mostra a versão e a revisão do código-fonte"

#: big-mount/usr/lib/big-mount/cli.sh:45
msgid "show this help"
msgstr "mostra esta ajuda"

#: big-mount/usr/lib/big-mount/cli.sh:46
msgid "TARGET is a device (/dev/sdb1) or any folder inside a mounted device."
msgstr "ALVO é um dispositivo (/dev/sdb1) ou qualquer pasta dentro de um dispositivo montado."

#: big-mount/usr/lib/big-mount/cli.sh:93 big-mount/usr/lib/big-mount/cli.sh:786
#: big-mount/usr/lib/big-mount/cli.sh:1056
#: big-mount/usr/lib/big-mount/doctor.sh:448
#: big-mount/usr/lib/big-mount/drive.sh:184
msgid "bigmount: unknown option '%s' (see bigmount --help)"
msgstr "bigmount: opção desconhecida '%s' (veja bigmount --help)"

#: big-mount/usr/lib/big-mount/cli.sh:107
#: big-mount/usr/lib/big-mount/cli.sh:1411
msgid "Device ready"
msgstr "Dispositivo pronto"

#: big-mount/usr/lib/big-mount/cli.sh:108
msgid "You can read and write files on this device."
msgstr "Você pode ler e gravar arquivos neste dispositivo."

#: big-mount/usr/lib/big-mount/cli.sh:111
msgid "Device not mounted"
msgstr "Dispositivo não montado"

#: big-mount/usr/lib/big-mount/cli.sh:112
msgid "The filesystem is not mounted at the moment."
msgstr "O sistema de arquivos não está montado no momento."

#: big-mount/usr/lib/big-mount/cli.sh:113
msgid "Open the device in the file manager (Dolphin) to mount it."
msgstr "Abra o dispositivo no gerenciador de arquivos (Dolphin) para montá-lo."

#: big-mount/usr/lib/big-mount/cli.sh:116
#: big-mount/usr/lib/big-mount/cli.sh:122
#: big-mount/usr/lib/big-mount/cli.sh:129
#: big-mount/usr/lib/big-mount/cli.sh:151
msgid "Read-only device"
msgstr "Dispositivo somente leitura"

#: big-mount/usr/lib/big-mount/cli.sh:117
msgid "The device itself is write-protected, so no system can write to it."
msgstr "O próprio dispositivo está protegido contra gravação, então nenhum sistema consegue gravar nele."

#: big-mount/usr/lib/big-mount/cli.sh:118
msgid "SD cards and some USB drives have a small lock switch on the side. Remove the device, move the switch to the unlocked position and connect it again."
msgstr "Cartões SD e alguns pendrives têm uma pequena trava na lateral. Retire o dispositivo, mova a trava para a posição destravada e conecte-o novamente."

#: big-mount/usr/lib/big-mount/cli.sh:119
msgid "If there is no switch, the device may have locked itself because of wear. Copy your files to another place as soon as possible."
msgstr "Se não houver trava, o dispositivo pode ter se bloqueado sozinho por desgaste. Copie seus arquivos para outro lugar o quanto antes."

#: big-mount/usr/lib/big-mount/cli.sh:123
msgid "This kind of filesystem cannot be written on Linux with the driver in use."
msgstr "Este tipo de sistema de arquivos não pode ser gravado no Linux com o driver em uso."

#: big-mount/usr/lib/big-mount/cli.sh:124
msgid "CDs, DVDs and disk images (ISO, SquashFS) are read-only by nature."
msgstr "CDs, DVDs e imagens de disco (ISO, SquashFS) são somente leitura por natureza."

#: big-mount/usr/lib/big-mount/cli.sh:125
msgid "Drives formatted on a Mac (HFS+ with journaling, APFS) can only be read on Linux."
msgstr "Unidades formatadas em um Mac (HFS+ com journaling, APFS) só podem ser lidas no Linux."

#: big-mount/usr/lib/big-mount/cli.sh:126
msgid "To write to it, copy the files elsewhere and format the device with a filesystem such as exFAT. Formatting erases everything on it."
msgstr "Para gravar, copie os arquivos para outro lugar e formate o dispositivo com um sistema de arquivos como o exFAT. A formatação apaga tudo o que estiver nele."

#: big-mount/usr/lib/big-mount/cli.sh:130
msgid "Windows did not close this NTFS partition properly (hibernation, Fast Startup or an interrupted shutdown). Writing to it now could damage files."
msgstr "O Windows não fechou esta partição NTFS corretamente (hibernação, Inicialização Rápida ou um desligamento interrompido). Gravar nela agora poderia danificar arquivos."

#: big-mount/usr/lib/big-mount/cli.sh:131
msgid "Start Windows and shut it down completely: hold the Shift key while you click Shut down."
msgstr "Inicie o Windows e desligue-o completamente: segure a tecla Shift enquanto clica em Desligar."

#: big-mount/usr/lib/big-mount/cli.sh:132
msgid "To avoid this in the future, disable Fast Startup in Windows: Control Panel > Power Options > Choose what the power buttons do."
msgstr "Para evitar isso no futuro, desative a Inicialização Rápida no Windows: Painel de Controle > Opções de Energia > Escolher a função dos botões de energia."

#: big-mount/usr/lib/big-mount/cli.sh:133
msgid "If it still happens, check the partition in Windows: open the Command Prompt as administrator and run chkdsk with the /f option for that drive letter."
msgstr "Se continuar acontecendo, verifique a partição no Windows: abra o Prompt de Comando como administrador e execute o chkdsk com a opção /f para a letra dessa unidade."

#: big-mount/usr/lib/big-mount/cli.sh:134
msgid "Big-Mount never repairs NTFS by itself, because the repair tools available on Linux may discard data that Windows still needs."
msgstr "O Big-Mount nunca repara NTFS por conta própria, porque as ferramentas de reparo disponíveis no Linux podem descartar dados de que o Windows ainda precisa."

#: big-mount/usr/lib/big-mount/cli.sh:137
msgid "The filesystem needs attention"
msgstr "O sistema de arquivos precisa de atenção"

#: big-mount/usr/lib/big-mount/cli.sh:138
msgid "The system found errors in the filesystem and stopped writing to it to protect your files."
msgstr "O sistema encontrou erros no sistema de arquivos e parou de gravar nele para proteger seus arquivos."

#: big-mount/usr/lib/big-mount/cli.sh:139
msgid "First copy your important files to another place."
msgstr "Primeiro copie seus arquivos importantes para outro lugar."

#: big-mount/usr/lib/big-mount/cli.sh:140
msgid "Then check the filesystem with the device unmounted, for example with KDE Partition Manager (Check)."
msgstr "Depois verifique o sistema de arquivos com o dispositivo desmontado, por exemplo no Gerenciador de Partições do KDE (Verificar)."

#: big-mount/usr/lib/big-mount/cli.sh:141
msgid "Do not write to the device until it has been checked."
msgstr "Não grave no dispositivo até que ele seja verificado."

#: big-mount/usr/lib/big-mount/cli.sh:144
msgid "The device has read or write errors"
msgstr "O dispositivo tem erros de leitura ou gravação"

#: big-mount/usr/lib/big-mount/cli.sh:145
msgid "The device reported read or write errors. This is usually a bad cable, a weak USB port or a failing drive."
msgstr "O dispositivo relatou erros de leitura ou gravação. Normalmente a causa é um cabo ruim, uma porta USB fraca ou uma unidade com defeito."

#: big-mount/usr/lib/big-mount/cli.sh:146
#: big-mount/usr/lib/big-mount/cli.sh:907
msgid "Copy your important files to another place as soon as possible."
msgstr "Copie seus arquivos importantes para outro lugar o quanto antes."

#: big-mount/usr/lib/big-mount/cli.sh:147
msgid "Try another cable and connect the device directly to the computer, without a hub."
msgstr "Experimente outro cabo e conecte o dispositivo direto no computador, sem hub."

#: big-mount/usr/lib/big-mount/cli.sh:148
msgid "Check the health of the drive in KDE Partition Manager (SMART status)."
msgstr "Verifique a saúde da unidade no Gerenciador de Partições do KDE (estado SMART)."

#: big-mount/usr/lib/big-mount/cli.sh:152
msgid "The filesystem was mounted read-only, but no problem was found with it."
msgstr "O sistema de arquivos foi montado somente para leitura, mas nenhum problema foi encontrado nele."

#: big-mount/usr/lib/big-mount/cli.sh:153
msgid "Mount it again with writing enabled."
msgstr "Monte-o novamente com a gravação ativada."

#: big-mount/usr/lib/big-mount/cli.sh:154
msgid "Mount again with writing"
msgstr "Montar novamente com gravação"

#: big-mount/usr/lib/big-mount/cli.sh:155
msgid "The device will be unmounted and mounted again with writing enabled. Nothing on it is changed. Programs using it must be closed first."
msgstr "O dispositivo será desmontado e montado novamente com a gravação ativada. Nada nele é alterado. Os programas que o estiverem usando precisam ser fechados antes."

#: big-mount/usr/lib/big-mount/cli.sh:158
#: big-mount/usr/lib/big-mount/cli.sh:166
#: big-mount/usr/lib/big-mount/cli.sh:171
#: big-mount/usr/lib/big-mount/cli.sh:185
msgid "No permission to write"
msgstr "Sem permissão para gravar"

#: big-mount/usr/lib/big-mount/cli.sh:159
msgid "The device accepts writing, but its main folder belongs to another user and you are not allowed to change it."
msgstr "O dispositivo aceita gravação, mas a pasta principal pertence a outro usuário e você não tem permissão para alterá-la."

#: big-mount/usr/lib/big-mount/cli.sh:160
msgid "You can become the owner of the main folder. Only that folder changes: the files and folders inside it keep their owners."
msgstr "Você pode se tornar o proprietário da pasta principal. Somente essa pasta muda: os arquivos e pastas dentro dela continuam com os seus proprietários."

#: big-mount/usr/lib/big-mount/cli.sh:161
msgid "This is the usual fix for drives formatted with a Linux filesystem (ext4, Btrfs, XFS)."
msgstr "Essa é a solução comum para unidades formatadas com um sistema de arquivos do Linux (ext4, Btrfs, XFS)."

#: big-mount/usr/lib/big-mount/cli.sh:162
msgid "Become owner of the main folder"
msgstr "Tornar-me proprietário da pasta principal"

#: big-mount/usr/lib/big-mount/cli.sh:163
msgid "The main folder of the device will belong to you (not recursive: the files and folders inside keep their owners). The administrator password may be requested."
msgstr "A pasta principal do dispositivo passará a pertencer a você (sem recursão: os arquivos e pastas dentro dela continuam com os seus proprietários). A senha de administrador pode ser solicitada."

#: big-mount/usr/lib/big-mount/cli.sh:167
msgid "This partition contains an operating system. Its folders belong to that system and must keep their owners."
msgstr "Esta partição contém um sistema operacional. As pastas dela pertencem a esse sistema e precisam manter os seus proprietários."

#: big-mount/usr/lib/big-mount/cli.sh:168
msgid "Save your files in a folder that belongs to you, for example your home folder on that system."
msgstr "Salve seus arquivos em uma pasta que pertença a você, por exemplo a sua pasta pessoal nesse sistema."

#: big-mount/usr/lib/big-mount/cli.sh:172
msgid "This folder belongs to %s, and only its owner can create or change files in it."
msgstr "Esta pasta pertence a %s, e só o dono dela pode criar ou alterar arquivos nela."

#: big-mount/usr/lib/big-mount/cli.sh:173
msgid "Save your files in a folder of your own, for example in your home folder."
msgstr "Salve seus arquivos em uma pasta sua, por exemplo na sua pasta pessoal."

#: big-mount/usr/lib/big-mount/cli.sh:176
msgid "System partition"
msgstr "Partição do sistema"

#: big-mount/usr/lib/big-mount/cli.sh:177
msgid "This partition holds the operating system that is running now. Only the system and administrators write here."
msgstr "Esta partição contém o sistema operacional em uso agora. Só o sistema e os administradores gravam nela."

#: big-mount/usr/lib/big-mount/cli.sh:178
msgid "Save your files in your home folder."
msgstr "Salve seus arquivos na sua pasta pessoal."

#: big-mount/usr/lib/big-mount/cli.sh:181
msgid "Swap space"
msgstr "Espaço de troca (swap)"

#: big-mount/usr/lib/big-mount/cli.sh:182
msgid "This partition is used as swap space (virtual memory), not to store files."
msgstr "Esta partição é usada como espaço de troca (memória virtual), não para guardar arquivos."

#: big-mount/usr/lib/big-mount/cli.sh:186
msgid "The device was mounted for another user, so only that user can write to it."
msgstr "O dispositivo foi montado para outro usuário, então somente esse usuário pode gravar nele."

#: big-mount/usr/lib/big-mount/cli.sh:187
msgid "Unmount it and open it again from the file manager while you are logged in."
msgstr "Desmonte-o e abra-o novamente pelo gerenciador de arquivos com a sua sessão."

#: big-mount/usr/lib/big-mount/cli.sh:189
msgid "This internal partition is mounted by Big-Mount at boot. An administrator can choose who may write to it with PERMISSIONS in /etc/big-mount.conf."
msgstr "Esta partição interna é montada pelo Big-Mount no boot. Um administrador pode escolher quem pode gravar nela com a opção PERMISSIONS em /etc/big-mount.conf."

#: big-mount/usr/lib/big-mount/cli.sh:191
msgid "Mount again for my user"
msgstr "Montar novamente para o meu usuário"

#: big-mount/usr/lib/big-mount/cli.sh:192
msgid "The device will be unmounted and mounted again for your user. Nothing on it is changed. Programs using it must be closed first."
msgstr "O dispositivo será desmontado e montado novamente para o seu usuário. Nada nele é alterado. Os programas que o estiverem usando precisam ser fechados antes."

#: big-mount/usr/lib/big-mount/cli.sh:195
msgid "Unknown state"
msgstr "Estado desconhecido"

#: big-mount/usr/lib/big-mount/cli.sh:196
msgid "The state of this device could not be determined."
msgstr "Não foi possível determinar o estado deste dispositivo."

#: big-mount/usr/lib/big-mount/cli.sh:205
#: big-mount/usr/lib/big-mount/cli.sh:867
#: big-mount/usr/lib/big-mount/doctor.sh:57
msgid "unknown"
msgstr "desconhecido"

#: big-mount/usr/lib/big-mount/cli.sh:236
msgid "system"
msgstr "sistema"

#: big-mount/usr/lib/big-mount/cli.sh:241
msgid "other"
msgstr "outro"

#: big-mount/usr/lib/big-mount/cli.sh:254
#: big-mount/usr/lib/big-mount/cli.sh:538
#: big-mount/usr/lib/big-mount/drive-diag.sh:200
#: big-mount/usr/lib/big-mount/drive.sh:199
msgid "Device"
msgstr "Dispositivo"

#: big-mount/usr/lib/big-mount/cli.sh:255
#: big-mount/usr/lib/big-mount/cli.sh:539
#: big-mount/usr/lib/big-mount/drive.sh:213
msgid "Filesystem"
msgstr "Sistema de arquivos"

#: big-mount/usr/lib/big-mount/cli.sh:257
#: big-mount/usr/lib/big-mount/cli.sh:540
#: big-mount/usr/lib/big-mount/drive.sh:217
msgid "Mounted at"
msgstr "Montado em"

#: big-mount/usr/lib/big-mount/cli.sh:258
msgid "Folder"
msgstr "Pasta"

#: big-mount/usr/lib/big-mount/cli.sh:260
msgid "Writable, but not by your user"
msgstr "Gravável, mas não pelo seu usuário"

#: big-mount/usr/lib/big-mount/cli.sh:260
#: big-mount/usr/lib/big-mount/drive.sh:216
msgid "Status"
msgstr "Estado"

#: big-mount/usr/lib/big-mount/cli.sh:264
#: big-mount/usr/lib/big-mount/cli.sh:906
msgid "How to solve:"
msgstr "Como resolver:"

#: big-mount/usr/lib/big-mount/cli.sh:268
msgid "Attention: the filesystem has recorded errors. Copy important files elsewhere and check it soon."
msgstr "Atenção: o sistema de arquivos registrou erros. Copie os arquivos importantes para outro lugar e verifique-o em breve."

#: big-mount/usr/lib/big-mount/cli.sh:271
msgid "Attention: the drive that holds this device reported errors since the computer was started. Copy important files elsewhere and check the drive."
msgstr "Atenção: a unidade que contém este dispositivo relatou erros desde que o computador foi ligado. Copie os arquivos importantes para outro lugar e verifique a unidade."

#: big-mount/usr/lib/big-mount/cli.sh:343
msgid "To see the errors of the drive: bigmount --diagnose %s"
msgstr "Para ver os erros da unidade: bigmount --diagnose %s"

#: big-mount/usr/lib/big-mount/cli.sh:345
#: big-mount/usr/lib/big-mount/cli.sh:934
msgid "Technical details:"
msgstr "Detalhes técnicos:"

#: big-mount/usr/lib/big-mount/cli.sh:361
#: big-mount/usr/lib/big-mount/drive-tui.sh:87
msgid "DEVICE"
msgstr "DISPOSITIVO"

#: big-mount/usr/lib/big-mount/cli.sh:361
msgid "LABEL"
msgstr "RÓTULO"

#: big-mount/usr/lib/big-mount/cli.sh:361
msgid "SIZE"
msgstr "TAMANHO"

#: big-mount/usr/lib/big-mount/cli.sh:361
msgid "FS"
msgstr "SA"

#: big-mount/usr/lib/big-mount/cli.sh:361
msgid "MANAGED BY"
msgstr "GERENCIADO POR"

#: big-mount/usr/lib/big-mount/cli.sh:361
msgid "MOUNTED AT"
msgstr "MONTADO EM"

#: big-mount/usr/lib/big-mount/cli.sh:361
msgid "STATE"
msgstr "ESTADO"

#: big-mount/usr/lib/big-mount/cli.sh:371
msgid "not mounted"
msgstr "não montado"

#: big-mount/usr/lib/big-mount/cli.sh:373
msgid "in use by the system"
msgstr "em uso pelo sistema"

#: big-mount/usr/lib/big-mount/cli.sh:375
msgid "READ-ONLY"
msgstr "SOMENTE LEITURA"

#: big-mount/usr/lib/big-mount/cli.sh:377
msgid "read and write"
msgstr "leitura e gravação"

#: big-mount/usr/lib/big-mount/cli.sh:379
msgid "no write permission"
msgstr "sem permissão de gravação"

#: big-mount/usr/lib/big-mount/cli.sh:393
msgid "Storage devices"
msgstr "Dispositivos de armazenamento"

#: big-mount/usr/lib/big-mount/cli.sh:407
msgid "To find out why a device cannot be written to, run: bigmount --diagnose DEVICE"
msgstr "Para saber por que um dispositivo não aceita gravação, execute: bigmount --diagnose DISPOSITIVO"

#: big-mount/usr/lib/big-mount/cli.sh:409
msgid "Environment"
msgstr "Ambiente"

#: big-mount/usr/lib/big-mount/cli.sh:412
msgid "present: automount disabled"
msgstr "presente: montagem automática desativada"

#: big-mount/usr/lib/big-mount/cli.sh:413
msgid "available"
msgstr "disponível"

#: big-mount/usr/lib/big-mount/cli.sh:413
#: big-mount/usr/lib/big-mount/cli.sh:882
msgid "not available"
msgstr "indisponível"

#: big-mount/usr/lib/big-mount/cli.sh:416
msgid "installed"
msgstr "instalado"

#: big-mount/usr/lib/big-mount/cli.sh:416
msgid "missing"
msgstr "ausente"

#: big-mount/usr/lib/big-mount/cli.sh:418
msgid "readable"
msgstr "acessível"

#: big-mount/usr/lib/big-mount/cli.sh:418
msgid "not readable (fewer details for errors)"
msgstr "inacessível (menos detalhes sobre erros)"

#: big-mount/usr/lib/big-mount/cli.sh:419
msgid "kernel log"
msgstr "log do kernel"

#: big-mount/usr/lib/big-mount/cli.sh:455
msgid "Also mounted at %s"
msgstr "Também está montado em %s"

#: big-mount/usr/lib/big-mount/cli.sh:456
msgid "Another device is mounted inside it: %s"
msgstr "Outro dispositivo está montado dentro dele: %s"

#: big-mount/usr/lib/big-mount/cli.sh:457
msgid "A swap file on it is in use: %s"
msgstr "Um arquivo de swap nele está em uso: %s"

#: big-mount/usr/lib/big-mount/cli.sh:458
msgid "It is in use as swap space"
msgstr "Está em uso como área de swap"

#: big-mount/usr/lib/big-mount/cli.sh:459
msgid "A disk image stored on it is attached: %s"
msgstr "Uma imagem de disco guardada nele está conectada: %s"

#: big-mount/usr/lib/big-mount/cli.sh:460
msgid "It is used by %s (encryption, LVM or RAID)"
msgstr "Está sendo usado por %s (criptografia, LVM ou RAID)"

#: big-mount/usr/lib/big-mount/cli.sh:461
msgid "Also mounted inside an isolated environment (a container or a sandboxed service): %s"
msgstr "Também montado dentro de um ambiente isolado (um contêiner ou um serviço em sandbox): %s"

#: big-mount/usr/lib/big-mount/cli.sh:490
msgid "A container or a sandboxed service has its own mount of this device (see below). Unmounting it here does not release the device while that mount exists."
msgstr "Um contêiner ou um serviço em sandbox tem a sua própria montagem deste dispositivo (veja abaixo). Desmontá-lo aqui não libera o dispositivo enquanto essa montagem existir."

#: big-mount/usr/lib/big-mount/cli.sh:491
msgid "Stop that container or service first. Big-Mount waits for it before saying the device can be disconnected."
msgstr "Pare esse contêiner ou serviço primeiro. O Big-Mount espera por isso antes de dizer que o dispositivo pode ser desconectado."

#: big-mount/usr/lib/big-mount/cli.sh:493
msgid "No program is using it, but the system still is (see below)."
msgstr "Nenhum programa o está usando, mas o sistema ainda está (veja abaixo)."

#: big-mount/usr/lib/big-mount/cli.sh:494
msgid "Resolve the item listed below, then try again."
msgstr "Resolva o item listado abaixo e tente novamente."

#: big-mount/usr/lib/big-mount/cli.sh:496
msgid "None of your programs is using it. A system service or a program of another user may be holding it, or it was released a moment ago."
msgstr "Nenhum programa seu está usando o dispositivo. Um serviço do sistema ou um programa de outro usuário pode estar ocupando-o, ou ele acabou de ser liberado."

#: big-mount/usr/lib/big-mount/cli.sh:497
msgid "Try again. If it is still busy, show the programs of all users."
msgstr "Tente novamente. Se continuar ocupado, mostre os programas de todos os usuários."

#: big-mount/usr/lib/big-mount/cli.sh:503
msgid "%s has a file open for writing on this device."
msgstr "%s está com um arquivo aberto para gravação neste dispositivo."

#: big-mount/usr/lib/big-mount/cli.sh:504
msgid "Let it finish, or cancel the operation in that program, then try again."
msgstr "Aguarde terminar, ou cancele a operação nesse programa, e tente novamente."

#: big-mount/usr/lib/big-mount/cli.sh:505
msgid "A terminal is open in a folder of this device."
msgstr "Um terminal está aberto numa pasta deste dispositivo."

#: big-mount/usr/lib/big-mount/cli.sh:506
msgid "Type cd in that terminal, or close it, then try again."
msgstr "Digite cd nesse terminal, ou feche-o, e tente novamente."

#: big-mount/usr/lib/big-mount/cli.sh:507
msgid "%s is showing or reading files of this device."
msgstr "%s está mostrando ou lendo arquivos deste dispositivo."

#: big-mount/usr/lib/big-mount/cli.sh:508
msgid "Close the window or tab that shows the device, then try again."
msgstr "Feche a janela ou aba que mostra o dispositivo e tente novamente."

#: big-mount/usr/lib/big-mount/cli.sh:509
msgid "The file indexer is reading this device."
msgstr "O indexador de arquivos está lendo este dispositivo."

#: big-mount/usr/lib/big-mount/cli.sh:510
msgid "It usually finishes in a moment: try again shortly."
msgstr "Normalmente termina em instantes: tente novamente daqui a pouco."

#: big-mount/usr/lib/big-mount/cli.sh:511
msgid "%s is running inside a folder of this device."
msgstr "%s está em execução dentro de uma pasta deste dispositivo."

#: big-mount/usr/lib/big-mount/cli.sh:512
#: big-mount/usr/lib/big-mount/cli.sh:514
msgid "Close that program, then try again."
msgstr "Feche esse programa e tente novamente."

#: big-mount/usr/lib/big-mount/cli.sh:513
msgid "%s is using files on this device."
msgstr "%s está usando arquivos deste dispositivo."

#: big-mount/usr/lib/big-mount/cli.sh:517
msgid "In total, %d programs are using it."
msgstr "No total, %d programas estão usando o dispositivo."

#: big-mount/usr/lib/big-mount/cli.sh:530
msgid "In use"
msgstr "Em uso"

#: big-mount/usr/lib/big-mount/cli.sh:534
msgid "%s is still in use"
msgstr "%s ainda está em uso"

#: big-mount/usr/lib/big-mount/cli.sh:544
msgid "Programs using it:"
msgstr "Programas usando o dispositivo:"

#: big-mount/usr/lib/big-mount/cli.sh:546
#: big-mount/usr/lib/big-mount/cli.sh:548
msgid "Application"
msgstr "Aplicativo"

#: big-mount/usr/lib/big-mount/cli.sh:546
#: big-mount/usr/lib/big-mount/cli.sh:548
msgid "process"
msgstr "processo"

#: big-mount/usr/lib/big-mount/cli.sh:546
msgid "User"
msgstr "Usuário"

#: big-mount/usr/lib/big-mount/cli.sh:546
#: big-mount/usr/lib/big-mount/cli.sh:548
msgid "Activity"
msgstr "Atividade"

#: big-mount/usr/lib/big-mount/cli.sh:564
msgid "Also keeping it busy:"
msgstr "Também o mantém ocupado:"

#: big-mount/usr/lib/big-mount/cli.sh:568
msgid "An open file does not necessarily mean that something is being copied."
msgstr "Um arquivo aberto não significa necessariamente que algo está sendo copiado."

#: big-mount/usr/lib/big-mount/cli.sh:595
msgid "%s is not in use"
msgstr "%s não está em uso"

#: big-mount/usr/lib/big-mount/cli.sh:597
msgid "No program and nothing in the system is using it. It can be unmounted."
msgstr "Nenhum programa e nada no sistema está usando o dispositivo. Ele pode ser desmontado."

#: big-mount/usr/lib/big-mount/cli.sh:599
msgid "None of your programs is using %s"
msgstr "Nenhum programa seu está usando %s"

#: big-mount/usr/lib/big-mount/cli.sh:601
msgid "No program of yours, no other mount and no other device is using it. It can probably be unmounted. Programs of other users and of the system are only visible to an administrator."
msgstr "Nenhum programa seu, nenhuma outra montagem e nenhum outro dispositivo está usando o dispositivo. Provavelmente ele pode ser desmontado. Programas de outros usuários e do sistema só ficam visíveis para um administrador."

#: big-mount/usr/lib/big-mount/cli.sh:630
msgid "The device was disconnected or replaced during the operation. Nothing else was done."
msgstr "O dispositivo foi desconectado ou substituído durante a operação. Nada mais foi feito."

#: big-mount/usr/lib/big-mount/cli.sh:689
msgid "%s was mounted again at %s"
msgstr "%s foi montado novamente em %s"

#: big-mount/usr/lib/big-mount/cli.sh:705
msgid "%s: the encrypted volume could not be locked"
msgstr "%s: não foi possível bloquear o volume criptografado"

#: big-mount/usr/lib/big-mount/cli.sh:747
msgid "They do not start again by themselves when the device comes back."
msgstr "Eles não voltam a funcionar sozinhos quando o dispositivo for conectado de novo."

#: big-mount/usr/lib/big-mount/cli.sh:749
msgid "They start again by themselves when the device is mounted again."
msgstr "Eles voltam a funcionar sozinhos quando o dispositivo for montado de novo."

#: big-mount/usr/lib/big-mount/cli.sh:792
#: big-mount/usr/lib/big-mount/drive.sh:392
msgid "Another removal of this drive is in progress. Nothing was done."
msgstr "Outra remoção desta unidade está em andamento. Nada foi feito."

#: big-mount/usr/lib/big-mount/cli.sh:808
msgid "Device removed safely. It can be disconnected now."
msgstr "Dispositivo removido com segurança. Ele já pode ser desconectado."

#: big-mount/usr/lib/big-mount/cli.sh:810
#: big-mount/usr/lib/big-mount/drive.sh:404
msgid "Unmounted. Everything was written to the device."
msgstr "Desmontado. Tudo foi gravado no dispositivo."

#: big-mount/usr/lib/big-mount/cli.sh:822
msgid "These programs can be asked to close (unsaved changes in them may be lost):"
msgstr "Estes programas podem ser solicitados a fechar (alterações não salvas neles podem ser perdidas):"

#: big-mount/usr/lib/big-mount/cli.sh:826
#: big-mount/usr/lib/big-mount/cli.sh:1461
msgid "Close them"
msgstr "Fechar programas"

#: big-mount/usr/lib/big-mount/cli.sh:826
#: big-mount/usr/lib/big-mount/cli.sh:839
#: big-mount/usr/lib/big-mount/cli.sh:1108
#: big-mount/usr/lib/big-mount/cli.sh:1121
#: big-mount/usr/lib/big-mount/cli.sh:1197
#: big-mount/usr/lib/big-mount/cli.sh:1220
#: big-mount/usr/lib/big-mount/cli.sh:1230
#: big-mount/usr/lib/big-mount/cli.sh:1385
#: big-mount/usr/lib/big-mount/cli.sh:1437
#: big-mount/usr/lib/big-mount/cli.sh:1461
#: big-mount/usr/lib/big-mount/cli.sh:1534
msgid "Cancel"
msgstr "Cancelar"

#: big-mount/usr/lib/big-mount/cli.sh:829
msgid "Still running: %s"
msgstr "Ainda em execução: %s"

#: big-mount/usr/lib/big-mount/cli.sh:832
#: big-mount/usr/lib/big-mount/drive.sh:409
msgid "These services use the device and will be stopped when it is unmounted:"
msgstr "Estes serviços usam o dispositivo e serão parados quando ele for desmontado:"

#: big-mount/usr/lib/big-mount/cli.sh:839
#: big-mount/usr/lib/big-mount/cli.sh:1108
#: big-mount/usr/lib/big-mount/cli.sh:1220
msgid "Stop them and continue"
msgstr "Parar e continuar"

#: big-mount/usr/lib/big-mount/cli.sh:842
msgid "Nothing was done. Run again with --assume-yes to stop them."
msgstr "Nada foi feito. Execute de novo com --assume-yes para pará-los."

#: big-mount/usr/lib/big-mount/cli.sh:846
msgid "Unmounted, but powering the drive off failed (%s). Wait a moment before disconnecting it."
msgstr "Desmontado, mas não foi possível desligar a unidade (%s). Aguarde um momento antes de desconectá-la."

#: big-mount/usr/lib/big-mount/cli.sh:847
#: big-mount/usr/lib/big-mount/drive.sh:406
msgid "Refused: this drive holds the running system (%s)."
msgstr "Recusado: esta unidade contém o sistema em execução (%s)."

#: big-mount/usr/lib/big-mount/cli.sh:848
#: big-mount/usr/lib/big-mount/drive.sh:407
msgid "Permission to unmount was not granted."
msgstr "A permissão para desmontar não foi concedida."

#: big-mount/usr/lib/big-mount/cli.sh:849
msgid "Unmounted, but the drive is still in use (%s), so it was not powered off."
msgstr "Desmontado, mas a unidade ainda está em uso (%s), por isso não foi desligada."

#: big-mount/usr/lib/big-mount/cli.sh:850
msgid "Unmounted. This drive cannot be powered off by the computer; it can be disconnected now."
msgstr "Desmontado. Esta unidade não pode ser desligada pelo computador; ela já pode ser desconectada."

#: big-mount/usr/lib/big-mount/cli.sh:853
#: big-mount/usr/lib/big-mount/drive.sh:413
msgid "Could not unmount: %s"
msgstr "Não foi possível desmontar: %s"

#: big-mount/usr/lib/big-mount/cli.sh:874
msgid "The drive reports errors"
msgstr "A unidade relata erros"

#: big-mount/usr/lib/big-mount/cli.sh:874
msgid "No drive errors found"
msgstr "Nenhum erro da unidade encontrado"

#: big-mount/usr/lib/big-mount/cli.sh:877
#: big-mount/usr/lib/big-mount/cli.sh:959
msgid "Drive"
msgstr "Unidade"

#: big-mount/usr/lib/big-mount/cli.sh:878
#: big-mount/usr/lib/big-mount/drive-diag.sh:199
#: big-mount/usr/lib/big-mount/drive.sh:198
msgid "Connection"
msgstr "Conexão"

#: big-mount/usr/lib/big-mount/cli.sh:880
msgid "no problem reported"
msgstr "nenhum problema relatado"

#: big-mount/usr/lib/big-mount/cli.sh:881
msgid "the drive predicts its own failure"
msgstr "a unidade prevê a própria falha"

#: big-mount/usr/lib/big-mount/cli.sh:885
msgid "no failure predicted (%s damaged sectors were replaced by spare ones)"
msgstr "nenhuma falha prevista (%s setores danificados foram substituídos por setores reserva)"

#: big-mount/usr/lib/big-mount/cli.sh:887
msgid "SMART status"
msgstr "Estado SMART"

#: big-mount/usr/lib/big-mount/cli.sh:890
msgid "Since the computer was started, the system recorded no read, write or connection errors for this drive."
msgstr "Desde que o computador foi ligado, o sistema não registrou erros de leitura, gravação ou conexão desta unidade."

#: big-mount/usr/lib/big-mount/cli.sh:892
msgid "The kernel log cannot be read by your user, so recent errors of this drive cannot be checked."
msgstr "O seu usuário não pode ler o log do kernel, então os erros recentes desta unidade não podem ser verificados."

#: big-mount/usr/lib/big-mount/cli.sh:896
msgid "Problems found:"
msgstr "Problemas encontrados:"

#: big-mount/usr/lib/big-mount/cli.sh:899
#: big-mount/usr/lib/big-mount/drive-diag.sh:148
msgid "The drive itself reports that it is failing (SMART)."
msgstr "A própria unidade informa que está falhando (SMART)."

#: big-mount/usr/lib/big-mount/cli.sh:900
#: big-mount/usr/lib/big-mount/drive-diag.sh:153
msgid "Since the computer was started, it stopped answering and the connection had to be reset (%s kernel messages)."
msgstr "Desde que o computador foi ligado, ela parou de responder e a conexão precisou ser reiniciada (%s mensagens do kernel)."

#: big-mount/usr/lib/big-mount/cli.sh:901
#: big-mount/usr/lib/big-mount/drive-diag.sh:152
msgid "Since the computer was started, reading or writing failed (%s kernel messages)."
msgstr "Desde que o computador foi ligado, a leitura ou a gravação falhou (%s mensagens do kernel)."

#: big-mount/usr/lib/big-mount/cli.sh:902
#: big-mount/usr/lib/big-mount/drive-diag.sh:155
msgid "Since the computer was started, the connection was slowed down after errors."
msgstr "Desde que o computador foi ligado, a conexão foi reduzida a uma velocidade menor depois de erros."

#: big-mount/usr/lib/big-mount/cli.sh:903
#: big-mount/usr/lib/big-mount/drive-diag.sh:154
msgid "Since the computer was started, the USB connection was reset or lost %s times."
msgstr "Desde que o computador foi ligado, a conexão USB foi reiniciada ou perdida %s vezes."

#: big-mount/usr/lib/big-mount/cli.sh:908
msgid "Check the data and power cables of the drive, or try another SATA port."
msgstr "Verifique os cabos de dados e de energia da unidade, ou experimente outra porta SATA."

#: big-mount/usr/lib/big-mount/cli.sh:909
msgid "An SSD that fails like this may lock itself in a protection mode: it seems to accept writing, but keeps nothing. Installers then cannot create partitions, and erased partitions come back. The drive's own Secure Erase can bring it back to work, but it erases everything on it."
msgstr "Um SSD que falha assim pode se travar num modo de proteção: parece aceitar gravações, mas não guarda nada. Os instaladores então não conseguem criar partições, e partições apagadas reaparecem. O Secure Erase da própria unidade pode fazê-la voltar a funcionar, mas apaga tudo o que há nela."

#: big-mount/usr/lib/big-mount/cli.sh:910
msgid "If the errors come back, replace the drive."
msgstr "Se os erros voltarem, troque a unidade."

#: big-mount/usr/lib/big-mount/cli.sh:937
msgid "Secure Erase is available for this drive: bigmount --secure-erase %s"
msgstr "O Secure Erase está disponível para esta unidade: bigmount --secure-erase %s"

#: big-mount/usr/lib/big-mount/cli.sh:944
msgid "Secure Erase works on a whole drive, not on a partition."
msgstr "O Secure Erase atua sobre uma unidade inteira, não sobre uma partição."

#: big-mount/usr/lib/big-mount/cli.sh:945
msgid "It holds the operating system that is running now. Start the computer from a live USB drive to erase it."
msgstr "Ela contém o sistema operacional em uso agora. Inicie o computador por um pendrive live para apagá-la."

#: big-mount/usr/lib/big-mount/cli.sh:946
msgid "Secure Erase is only offered for drives connected inside the computer, not through USB."
msgstr "O Secure Erase só é oferecido para unidades conectadas dentro do computador, não por USB."

#: big-mount/usr/lib/big-mount/cli.sh:947
msgid "Secure Erase is only available for SATA drives."
msgstr "O Secure Erase só está disponível para unidades SATA."

#: big-mount/usr/lib/big-mount/cli.sh:948
msgid "This drive does not support Secure Erase."
msgstr "Esta unidade não tem suporte a Secure Erase."

#: big-mount/usr/lib/big-mount/cli.sh:949
msgid "A security password is set on this drive. Remove it first, in the firmware setup (BIOS) or with the tool of the manufacturer."
msgstr "Esta unidade tem uma senha de segurança definida. Remova-a antes, na configuração do firmware (BIOS) ou com a ferramenta do fabricante."

#: big-mount/usr/lib/big-mount/cli.sh:950
msgid "This drive cannot be erased."
msgstr "Esta unidade não pode ser apagada."

#: big-mount/usr/lib/big-mount/cli.sh:958
#: big-mount/usr/lib/big-mount/cli.sh:1197
#: big-mount/usr/lib/big-mount/cli.sh:1199
#: big-mount/usr/lib/big-mount/cli.sh:1201
#: big-mount/usr/lib/big-mount/cli.sh:1205
msgid "Erase the whole drive"
msgstr "Apagar a unidade inteira"

#: big-mount/usr/lib/big-mount/cli.sh:960
msgid "The drive will erase itself completely, with its own Secure Erase command. Every partition and every file on it will be lost for good. This cannot be undone."
msgstr "A unidade vai se apagar por completo, com o próprio comando Secure Erase. Todas as partições e todos os arquivos nela serão perdidos para sempre. Isso não pode ser desfeito."

#: big-mount/usr/lib/big-mount/cli.sh:968
msgid "These partitions will be lost:"
msgstr "Estas partições serão perdidas:"

#: big-mount/usr/lib/big-mount/cli.sh:972
msgid "The drive announces that erasing takes more than 8 hours."
msgstr "A unidade informa que o apagamento leva mais de 8 horas."

#: big-mount/usr/lib/big-mount/cli.sh:974
msgid "The drive announces that erasing takes about %d minutes."
msgstr "A unidade informa que o apagamento leva cerca de %d minutos."

#: big-mount/usr/lib/big-mount/cli.sh:978
msgid "Afterwards an empty %s partition table is written and read back, to check that the drive keeps what is written again."
msgstr "Depois, uma tabela de partições %s vazia é gravada e lida de volta, para conferir se a unidade voltou a guardar o que é gravado."

#: big-mount/usr/lib/big-mount/cli.sh:980
msgid "Use it to bring back an SSD that no longer keeps what is written, or before giving a drive away. It is not a repair: if the drive fails again, replace it."
msgstr "Use para recuperar um SSD que não guarda mais o que é gravado, ou antes de passar uma unidade adiante. Não é um conserto: se a unidade falhar de novo, troque-a."

#: big-mount/usr/lib/big-mount/cli.sh:981
msgid "The computer may have to sleep for a moment first."
msgstr "Talvez o computador precise entrar em suspensão por um instante antes."

#: big-mount/usr/lib/big-mount/cli.sh:982
msgid "The administrator password will be requested."
msgstr "A senha de administrador será solicitada."

#: big-mount/usr/lib/big-mount/cli.sh:987
msgid "The drive is locked against erasing"
msgstr "A unidade está travada contra apagamento"

#: big-mount/usr/lib/big-mount/cli.sh:990
msgid "When the computer starts, its firmware locks the security commands of the drives (they are frozen). Sleeping once usually unlocks them."
msgstr "Quando o computador liga, o firmware trava os comandos de segurança das unidades (elas ficam congeladas, \"frozen\"). Entrar em suspensão uma vez normalmente as destrava."

#: big-mount/usr/lib/big-mount/cli.sh:992
msgid "The computer will sleep and wake up by itself after about 20 seconds."
msgstr "O computador vai entrar em suspensão e acordar sozinho depois de cerca de 20 segundos."

#: big-mount/usr/lib/big-mount/cli.sh:994
msgid "The computer will go to sleep. Wake it up with the power button, and unlock the session if asked: the erase continues afterwards."
msgstr "O computador vai entrar em suspensão. Acorde-o com o botão de energia e desbloqueie a sessão se for pedido: o apagamento continua em seguida."

#: big-mount/usr/lib/big-mount/cli.sh:1002
msgid "Unable to erase the drive"
msgstr "Não foi possível apagar a unidade"

#: big-mount/usr/lib/big-mount/cli.sh:1006
msgid "Drive erased"
msgstr "Unidade apagada"

#: big-mount/usr/lib/big-mount/cli.sh:1009
msgid "The drive was erased and keeps what is written again. It now has an empty %s partition table: you can install a system or create partitions on it."
msgstr "A unidade foi apagada e voltou a guardar o que é gravado. Agora ela tem uma tabela de partições %s vazia: você pode instalar um sistema ou criar partições nela."

#: big-mount/usr/lib/big-mount/cli.sh:1011
msgid "It failed once: keep a copy of what you store on it, and replace it if the errors come back."
msgstr "Ela já falhou uma vez: mantenha uma cópia do que guardar nela, e troque-a se os erros voltarem."

#: big-mount/usr/lib/big-mount/cli.sh:1014
msgid "The drive is still locked"
msgstr "A unidade continua travada"

#: big-mount/usr/lib/big-mount/cli.sh:1016
msgid "The drive is still locked against erasing. Nothing was erased."
msgstr "A unidade continua travada contra apagamento. Nada foi apagado."

#: big-mount/usr/lib/big-mount/cli.sh:1017
msgid "Some computers lock the drives again when they wake up. Try once more, or erase the drive in another computer."
msgstr "Alguns computadores travam as unidades de novo ao acordar. Tente mais uma vez, ou apague a unidade em outro computador."

#: big-mount/usr/lib/big-mount/cli.sh:1018
msgid "If the computer supports hot-plugging SATA drives, disconnecting and connecting the drive while the computer is on also unlocks it."
msgstr "Se o computador permitir conectar unidades SATA com ele ligado (hot-plug), desconectar e conectar a unidade com o computador ligado também a destrava."

#: big-mount/usr/lib/big-mount/cli.sh:1023
msgid "Drive erased, not verified"
msgstr "Unidade apagada, sem verificação"

#: big-mount/usr/lib/big-mount/cli.sh:1025
msgid "The drive was erased, but writing a new partition table failed (%s), so it could not be checked."
msgstr "A unidade foi apagada, mas a gravação de uma nova tabela de partições falhou (%s), então não foi possível conferi-la."

#: big-mount/usr/lib/big-mount/cli.sh:1027
msgid "Create a partition table with KDE Partition Manager, and check that it is still there after a restart."
msgstr "Crie uma tabela de partições com o Gerenciador de Partições do KDE e confira se ela continua lá depois de reiniciar."

#: big-mount/usr/lib/big-mount/cli.sh:1030
#: big-mount/usr/lib/big-mount/cli.sh:1035
msgid "The drive is failing"
msgstr "A unidade está falhando"

