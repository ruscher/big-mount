# Maintainer: Bruno Goncalves <bigbruno@gmail.com>

pkgname=big-mount
# The version is the date and time (UTC) of the commit the package is built
# from, set by pkgver() below: the same source always gives the same
# version, and it keeps growing like the build dates used before
# (26.10.25.1342 > 26.10.22-1342). The commit itself goes into
# /usr/lib/big-mount/version, shown by "bigmount --version".
# makepkg writes the result of pkgver() on the next line with
# ${line/#pkgver=*([^ ])/...}: it must stay a single word, never $(date ...)
pkgver=26.10.26.0137
pkgrel=1
arch=('any')
license=('GPL')
depends=('bash' 'udisks2' 'util-linux' 'ntfs-3g' 'lsof')
optdepends=('kdialog: dialogs on KDE Plasma'
            'zenity: dialogs on GNOME and other desktops'
            'libnotify: desktop notifications (otherwise kdialog --passivepopup is used)')
provides=('big-mount-git')
conflicts=('big-mount-git')
replaces=('big-mount-git')
backup=('etc/big-mount.conf')
install=big-mount.install
# The development of Big-Mount happens in this fork; it is merged into
# biglinux/big-mount later. Point url/source back to biglinux/big-mount once
# the official repository carries the same code.
url="https://github.com/ruscher/big-mount"
pkgdesc="Mounts internal partitions at boot; diagnoses read-only and busy devices and removes them safely"
source=("git+https://github.com/ruscher/big-mount.git")
makedepends=("git")
md5sums=(SKIP)

pkgver() {
    cd "${srcdir}/${pkgname}" || return 1
    TZ=UTC git log -1 --date=format-local:%y.%m.%d.%H%M --format=%cd
}

package() {
    # Verify default folder
    if [ -d "${srcdir}/${pkgname}/${pkgname}" ]; then
        InternalDir="${srcdir}/${pkgname}/${pkgname}"
    else
        InternalDir="${srcdir}/${pkgname}"
    fi

    # Copy files
    if [ -d "${InternalDir}/usr" ]; then
        cp -r "${InternalDir}/usr" "${pkgdir}/"
    fi

    if [ -d "${InternalDir}/etc" ]; then
        cp -r "${InternalDir}/etc" "${pkgdir}/"
    fi

    if [ -d "${InternalDir}/opt" ]; then
        cp -r "${InternalDir}/opt" "${pkgdir}/"
    fi

    # The revision this package was built from (bigmount --version, --doctor)
    local rev
    if rev="$(git -C "${srcdir}/${pkgname}" rev-parse HEAD 2>/dev/null)"; then
        {
            printf 'revision=%s\n' "$rev"
            printf 'date=%s\n' "$(TZ=UTC git -C "${srcdir}/${pkgname}" log -1 --date=format-local:%Y-%m-%dT%H:%M:%SZ --format=%cd)"
            printf 'source=%s\n' "$url"
        } > "${pkgdir}/usr/lib/big-mount/version"
        chmod 644 "${pkgdir}/usr/lib/big-mount/version"
    fi
}
