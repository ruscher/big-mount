msgstr "Sem D-Bus de sessão: as notificações não podem ser exibidas"

#: big-mount/usr/lib/big-mount/doctor.sh:322
msgid "The read-only notifier is running"
msgstr "O notificador de somente leitura está em execução"

#: big-mount/usr/lib/big-mount/doctor.sh:324
msgid "The read-only notifier is not running"
msgstr "O notificador de somente leitura não está em execução"

#: big-mount/usr/lib/big-mount/doctor.sh:324
msgid "It starts at login (/etc/xdg/autostart/big-mount-notifier.desktop)."
msgstr "Ele inicia no login (/etc/xdg/autostart/big-mount-notifier.desktop)."

#: big-mount/usr/lib/big-mount/doctor.sh:335
msgid "Storage stack"
msgstr "Sistema de armazenamento"

#: big-mount/usr/lib/big-mount/doctor.sh:346
msgid "Missing program: %s"
msgstr "Programa ausente: %s"

#: big-mount/usr/lib/big-mount/doctor.sh:347
msgid "Install the dependencies of big-mount (util-linux, udisks2, lsof, glib2)."
msgstr "Instale as dependências do big-mount (util-linux, udisks2, lsof, glib2)."

#: big-mount/usr/lib/big-mount/doctor.sh:350
msgid "UDisks2 answers on the system D-Bus"
msgstr "O UDisks2 responde no D-Bus do sistema"

#: big-mount/usr/lib/big-mount/doctor.sh:352
msgid "UDisks2 does not answer on the system D-Bus"
msgstr "O UDisks2 não responde no D-Bus do sistema"

#: big-mount/usr/lib/big-mount/doctor.sh:352
msgid "Plasma and Big-Mount cannot mount or remove devices. Check: systemctl status udisks2"
msgstr "O Plasma e o Big-Mount não conseguem montar nem remover dispositivos. Verifique: systemctl status udisks2"

#: big-mount/usr/lib/big-mount/doctor.sh:356
msgid "Polkit knows the action of Big-Mount"
msgstr "O polkit conhece a ação do Big-Mount"

#: big-mount/usr/lib/big-mount/doctor.sh:358
msgid "Polkit does not know org.biglinux.big-mount.inspect-processes"
msgstr "O polkit não conhece org.biglinux.big-mount.inspect-processes"

#: big-mount/usr/lib/big-mount/doctor.sh:358
msgid "'Show programs of all users' will not work. Reinstall the big-mount package."
msgstr "'Mostrar programas de todos os usuários' não funcionará. Reinstale o pacote big-mount."

#: big-mount/usr/lib/big-mount/doctor.sh:362
msgid "Kernel log readable (needed to explain read-only devices)"
msgstr "Log do kernel legível (necessário para explicar dispositivos somente leitura)"

#: big-mount/usr/lib/big-mount/doctor.sh:364
msgid "Kernel log not readable by this user: read-only causes are explained with fewer details"
msgstr "Log do kernel não legível por este usuário: as causas de somente leitura são explicadas com menos detalhes"

#: big-mount/usr/lib/big-mount/doctor.sh:377
msgid "%s: %s, %s, removable"
msgstr "%s: %s, %s, removível"

#: big-mount/usr/lib/big-mount/doctor.sh:379
msgid "%s: %s, %s, internal"
msgstr "%s: %s, %s, interno"

#: big-mount/usr/lib/big-mount/doctor.sh:383
msgid "The kernel has no /sys/block entry for it"
msgstr "O kernel não tem uma entrada em /sys/block para ele"

#: big-mount/usr/lib/big-mount/doctor.sh:385
msgid "UDisks2 does not know this device: Plasma and Big-Mount cannot manage it"
msgstr "O UDisks2 não conhece este dispositivo: o Plasma e o Big-Mount não conseguem gerenciá-lo"

#: big-mount/usr/lib/big-mount/doctor.sh:392
msgid "%s: the drive reports problems (%s)"
msgstr "%s: a unidade relata problemas (%s)"

#: big-mount/usr/lib/big-mount/doctor.sh:393
msgid "For details: bigmount --diagnose %s"
msgstr "Para detalhes: bigmount --diagnose %s"

#: big-mount/usr/lib/big-mount/doctor.sh:404
msgid "NVMe controller /dev/%s: storage %s"
msgstr "Controlador NVMe /dev/%s: armazenamento %s"

#: big-mount/usr/lib/big-mount/doctor.sh:417
msgid "Mounted read-only: %s"
msgstr "Montados somente leitura: %s"

#: big-mount/usr/lib/big-mount/doctor.sh:417
msgid "To know why: bigmount --diagnose DEVICE"
msgstr "Para saber o motivo: bigmount --diagnose DISPOSITIVO"

#: big-mount/usr/lib/big-mount/doctor.sh:425
msgid "Outside Big-Mount (for reference)"
msgstr "Fora do Big-Mount (para referência)"

#: big-mount/usr/lib/big-mount/doctor.sh:431
msgid "Settings files that do not belong to you (Plasma cannot save them, so settings seem to reset)"
msgstr "Arquivos de configuração que não pertencem a você (o Plasma não consegue salvá-los, e as configurações parecem voltar ao padrão)"

#: big-mount/usr/lib/big-mount/doctor.sh:432
msgid "Usually left by a graphical program run with sudo. An administrator can give them back with chown."
msgstr "Normalmente deixados por um programa gráfico executado com sudo. Um administrador pode devolvê-los com chown."

#: big-mount/usr/lib/big-mount/doctor.sh:434
msgid "All your settings files belong to you"
msgstr "Todos os seus arquivos de configuração pertencem a você"

#: big-mount/usr/lib/big-mount/doctor.sh:440
msgid "%d packages have newer versions in the last synchronized package list"
msgstr "%d pacotes têm versões mais novas na última lista de pacotes sincronizada"

#: big-mount/usr/lib/big-mount/doctor.sh:441
msgid "Keep the system consistent: update everything at once (sudo pacman -Syu), never only some packages."
msgstr "Mantenha o sistema consistente: atualize tudo de uma vez (sudo pacman -Syu), nunca apenas alguns pacotes."

#: big-mount/usr/lib/big-mount/doctor.sh:454
msgid "Big-Mount check (nothing is changed; labels, serial numbers, UUIDs and personal paths are left out)"
msgstr "Verificação do Big-Mount (nada é alterado; rótulos, números de série, UUIDs e caminhos pessoais ficam de fora)"

#: big-mount/usr/lib/big-mount/doctor.sh:461
msgid "Result: %d problem(s), %d warning(s)."
msgstr "Resultado: %d problema(s), %d aviso(s)."

#: big-mount/usr/lib/big-mount/doctor.sh:462
msgid "Big-Mount and the storage stack look healthy."
msgstr "O Big-Mount e o sistema de armazenamento parecem saudáveis."

#: big-mount/usr/lib/big-mount/doctor.sh:463
msgid "To report a problem, attach this output: bigmount --doctor > big-mount-report.txt"
msgstr "Para relatar um problema, anexe esta saída: bigmount --doctor > relatorio-big-mount.txt"

#: big-mount/usr/lib/big-mount/drive-copy.sh:98
msgid "rsync is not installed, and it does the copying. Install the package rsync."
msgstr "O rsync não está instalado, e é ele quem faz a cópia. Instale o pacote rsync."

#: big-mount/usr/lib/big-mount/drive-copy.sh:99
msgid "A path has a line break in its name. It cannot be handled safely."
msgstr "Um caminho tem uma quebra de linha no nome. Ele não pode ser tratado com segurança."

#: big-mount/usr/lib/big-mount/drive-copy.sh:100
msgid "The source folder does not exist or cannot be read."
msgstr "A pasta de origem não existe ou não pode ser lida."

#: big-mount/usr/lib/big-mount/drive-copy.sh:101
msgid "The source did not answer in time. The drive may be stuck on a damaged area: wait, or unplug it and try again."
msgstr "A origem não respondeu a tempo. A unidade pode estar presa em uma área danificada: aguarde, ou desconecte-a e tente de novo."

#: big-mount/usr/lib/big-mount/drive-copy.sh:102
msgid "A selected item is outside the source folder."
msgstr "Um item selecionado está fora da pasta de origem."

#: big-mount/usr/lib/big-mount/drive-copy.sh:103
msgid "A selected item does not exist in the source folder."
msgstr "Um item selecionado não existe na pasta de origem."

#: big-mount/usr/lib/big-mount/drive-copy.sh:104
msgid "The source and the destination are the same folder."
msgstr "A origem e o destino são a mesma pasta."

#: big-mount/usr/lib/big-mount/drive-copy.sh:105
msgid "The destination is inside the source. The copy would copy itself."
msgstr "O destino está dentro da origem. A cópia copiaria a si mesma."

#: big-mount/usr/lib/big-mount/drive-copy.sh:106
msgid "The source is inside the destination, which could overwrite the source."
msgstr "A origem está dentro do destino, o que poderia sobrescrever a origem."

#: big-mount/usr/lib/big-mount/drive-copy.sh:107
msgid "The source and the destination are on the same filesystem. A copy there does not protect the data."
msgstr "A origem e o destino estão no mesmo sistema de arquivos. Uma cópia ali não protege os dados."

#: big-mount/usr/lib/big-mount/drive-copy.sh:108
msgid "The destination is on the same physical disk as the source. If that disk fails, both are lost. To accept that, allow it explicitly."
msgstr "O destino está no mesmo disco físico da origem. Se esse disco falhar, os dois se perdem. Para aceitar isso, autorize explicitamente."

#: big-mount/usr/lib/big-mount/drive-copy.sh:109
msgid "The destination folder could not be created."
msgstr "Não foi possível criar a pasta de destino."

#: big-mount/usr/lib/big-mount/drive-copy.sh:110
msgid "The destination is read-only."
msgstr "O destino é somente leitura."

#: big-mount/usr/lib/big-mount/drive-copy.sh:111
msgid "You do not have permission to write to the destination."
msgstr "Você não tem permissão para gravar no destino."

#: big-mount/usr/lib/big-mount/drive-copy.sh:112
msgid "The destination did not answer in time."
msgstr "O destino não respondeu a tempo."

#: big-mount/usr/lib/big-mount/drive-copy.sh:113
msgid "The destination is on a drive with critical alerts. To accept that, allow it explicitly."
msgstr "O destino está em uma unidade com alertas críticos. Para aceitar isso, autorize explicitamente."

#: big-mount/usr/lib/big-mount/drive-copy.sh:114
msgid "This drive is at risk and is mounted with writing enabled. Mount it read-only first, so that nothing changes it during the copy. To accept the risk, allow it explicitly."
msgstr "Esta unidade está em risco e montada com gravação ativada. Monte-a primeiro como somente leitura, para que nada a altere durante a cópia. Para aceitar o risco, autorize explicitamente."

#: big-mount/usr/lib/big-mount/drive-copy.sh:115
msgid "There is not enough free space at the destination."
msgstr "Não há espaço livre suficiente no destino."

#: big-mount/usr/lib/big-mount/drive-copy.sh:116
#: big-mount/usr/lib/big-mount/drive-copy.sh:419
msgid "GNU ddrescue is not installed (package ddrescue). It makes the disk image."
msgstr "O GNU ddrescue não está instalado (pacote ddrescue). É ele quem faz a imagem de disco."

#: big-mount/usr/lib/big-mount/drive-copy.sh:117
#: big-mount/usr/lib/big-mount/drive-recovery.sh:807
msgid "PhotoRec is not installed (package testdisk)."
msgstr "O PhotoRec não está instalado (pacote testdisk)."

#: big-mount/usr/lib/big-mount/drive-copy.sh:118
#: big-mount/usr/lib/big-mount/drive-recovery.sh:602
msgid "TestDisk is not installed (package testdisk)."
msgstr "O TestDisk não está instalado (pacote testdisk)."

#: big-mount/usr/lib/big-mount/drive-copy.sh:119
#: big-mount/usr/lib/big-mount/drive-copy.sh:418
#: big-mount/usr/lib/big-mount/drive-recovery.sh:630
#: big-mount/usr/lib/big-mount/drive.sh:602
msgid "Permission was not granted."
msgstr "A permissão não foi concedida."

#: big-mount/usr/lib/big-mount/drive-copy.sh:120
#: big-mount/usr/lib/big-mount/drive-recovery.sh:814
msgid "This device cannot be read by your user. Make a disk image first (bigmount --drive image), and search in the image: it also spares the disk."
msgstr "Seu usuário não consegue ler este dispositivo. Faça antes uma imagem de disco (bigmount --drive image) e busque na imagem: isso também poupa o disco."

#: big-mount/usr/lib/big-mount/drive-copy.sh:121
msgid "The image cannot be stored on the disk being read."
msgstr "A imagem não pode ficar no disco que está sendo lido."

#: big-mount/usr/lib/big-mount/drive-copy.sh:122
msgid "An image of another disk already exists in that place. Continuing it would mix the two: choose another name."
msgstr "Já existe nesse lugar uma imagem de outro disco. Continuá-la misturaria os dois: escolha outro nome."

#: big-mount/usr/lib/big-mount/drive-copy.sh:123
#: big-mount/usr/lib/big-mount/drive-diag.sh:387
#: big-mount/usr/lib/big-mount/drive-tui.sh:78
msgid "The device was disconnected or replaced. Nothing was done."
msgstr "O dispositivo foi desconectado ou substituído. Nada foi feito."

#: big-mount/usr/lib/big-mount/drive-copy.sh:124
#: big-mount/usr/lib/big-mount/drive-diag.sh:378
msgid "This computer has no driver for this filesystem. Installing the right package may solve it."
msgstr "Este computador não tem driver para este sistema de arquivos. Instalar o pacote certo pode resolver."

#: big-mount/usr/lib/big-mount/drive-copy.sh:125
#: big-mount/usr/lib/big-mount/drive-diag.sh:383
msgid "This volume is encrypted. Unlock it first."
msgstr "Este volume é criptografado. Desbloqueie-o primeiro."

#: big-mount/usr/lib/big-mount/drive-copy.sh:126
#: big-mount/usr/lib/big-mount/drive-diag.sh:384
msgid "This is a part of a larger volume (RAID, LVM or similar), not a filesystem of its own. Its volume must be assembled first."
msgstr "Isto é parte de um volume maior (RAID, LVM ou semelhante), não um sistema de arquivos próprio. O volume precisa ser montado antes."

#: big-mount/usr/lib/big-mount/drive-copy.sh:127
#: big-mount/usr/lib/big-mount/drive-diag.sh:386
msgid "This is swap space, not a place for files."
msgstr "Isto é área de swap, não um lugar para arquivos."

#: big-mount/usr/lib/big-mount/drive-copy.sh:128
msgid "No filesystem was recognized on it, so its files cannot be listed."
msgstr "Nenhum sistema de arquivos foi reconhecido nele, então os arquivos não podem ser listados."

#: big-mount/usr/lib/big-mount/drive-copy.sh:129
msgid "Choose one of the volumes of this drive to see its files."
msgstr "Escolha um dos volumes deste disco para ver os arquivos."

#: big-mount/usr/lib/big-mount/drive-copy.sh:130
msgid "This is already a disk image."
msgstr "Isto já é uma imagem de disco."

#: big-mount/usr/lib/big-mount/drive-copy.sh:131
msgid "The copy was refused."
msgstr "A cópia foi recusada."

#: big-mount/usr/lib/big-mount/drive-copy.sh:148
msgid "The source is mounted with writing enabled. Mounting it read-only is safer."
msgstr "A origem está montada com gravação ativada. Montá-la como somente leitura é mais seguro."

#: big-mount/usr/lib/big-mount/drive-copy.sh:149
msgid "The source drive reported problems. Files that do not advance are set aside so the rest is saved first."
msgstr "A unidade de origem relatou problemas. Arquivos que não avançam são deixados de lado para salvar o resto primeiro."

#: big-mount/usr/lib/big-mount/drive-copy.sh:150
msgid "The total is not measured on a drive at risk, to avoid extra reads. Progress shows what was copied so far."
msgstr "O total não é medido em uma unidade em risco, para evitar leituras extras. O progresso mostra o que já foi copiado."

#: big-mount/usr/lib/big-mount/drive-copy.sh:151
msgid "The total is the used space of the volume: an approximation."
msgstr "O total é o espaço usado do volume: uma aproximação."

#: big-mount/usr/lib/big-mount/drive-copy.sh:152
msgid "The destination is FAT32, which cannot store files of 4 GiB or more. Those files will be listed as failed."
msgstr "O destino é FAT32, que não guarda arquivos de 4 GiB ou mais. Esses arquivos serão listados como falhas."

#: big-mount/usr/lib/big-mount/drive-copy.sh:153
msgid "The destination does not store Linux permissions. Names and dates are kept, permissions are not."
msgstr "O destino não guarda permissões do Linux. Nomes e datas são mantidos, as permissões não."

#: big-mount/usr/lib/big-mount/drive-copy.sh:154
msgid "Some files already exist at the destination with different content. See the option for existing files."
msgstr "Alguns arquivos já existem no destino com conteúdo diferente. Veja a opção para arquivos existentes."

#: big-mount/usr/lib/big-mount/drive-copy.sh:155
msgid "This version of rsync cannot sync each file to the disk (it needs 3.2.4 or later). After a power cut, the last files copied should be checked."
msgstr "Esta versão do rsync não consegue sincronizar cada arquivo com o disco (precisa da 3.2.4 ou mais nova). Depois de uma queda de energia, confira os últimos arquivos copiados."

#: big-mount/usr/lib/big-mount/drive-copy.sh:156
msgid "The full check reads every file of the source again. On a drive at risk that is extra wear."
msgstr "A verificação completa lê de novo todos os arquivos da origem. Em uma unidade em risco, isso é desgaste extra."

#: big-mount/usr/lib/big-mount/drive-copy.sh:386
msgid "Making the disk image"
msgstr "Fazendo a imagem do disco"

#: big-mount/usr/lib/big-mount/drive-copy.sh:387
msgid "Disk image complete"
msgstr "Imagem de disco concluída"

#: big-mount/usr/lib/big-mount/drive-copy.sh:388
msgid "Listing the files"
msgstr "Listando os arquivos"

#: big-mount/usr/lib/big-mount/drive-copy.sh:389
msgid "List of files complete"
msgstr "Lista de arquivos concluída"

#: big-mount/usr/lib/big-mount/drive-copy.sh:390
msgid "Searching by content"
msgstr "Procurando pelo conteúdo"

#: big-mount/usr/lib/big-mount/drive-copy.sh:391
msgid "Search complete"
msgstr "Busca concluída"

#: big-mount/usr/lib/big-mount/drive-copy.sh:394
msgid "Waiting to start"
msgstr "Aguardando o início"

#: big-mount/usr/lib/big-mount/drive-copy.sh:395
msgid "Measuring what will be copied"
msgstr "Medindo o que será copiado"

#: big-mount/usr/lib/big-mount/drive-copy.sh:396
msgid "Copying"
msgstr "Copiando"

#: big-mount/usr/lib/big-mount/drive-copy.sh:397
msgid "Checking the result"
msgstr "Verificando o resultado"

#: big-mount/usr/lib/big-mount/drive-copy.sh:398
msgid "Stopping: waiting for the disk to answer"
msgstr "Parando: aguardando o disco responder"

#: big-mount/usr/lib/big-mount/drive-copy.sh:399
msgid "Paused"
msgstr "Pausada"

#: big-mount/usr/lib/big-mount/drive-copy.sh:400
msgid "Completed and checked"
msgstr "Concluída e verificada"

#: big-mount/usr/lib/big-mount/drive-copy.sh:401
msgid "Cancelled"
msgstr "Cancelada"

#: big-mount/usr/lib/big-mount/drive-copy.sh:402
msgid "Failed"
msgstr "Falhou"

#: big-mount/usr/lib/big-mount/drive-copy.sh:403
msgid "Finished, needs your attention"
msgstr "Terminou, precisa da sua atenção"

#: big-mount/usr/lib/big-mount/drive-copy.sh:404
msgid "Interrupted (it can be resumed)"
msgstr "Interrompida (pode ser retomada)"

#: big-mount/usr/lib/big-mount/drive-copy.sh:411
msgid "The source drive was disconnected or unmounted. Connect and mount it again, then resume."
msgstr "A unidade de origem foi desconectada ou desmontada. Conecte e monte de novo, depois retome."

#: big-mount/usr/lib/big-mount/drive-copy.sh:412
msgid "The destination was disconnected or unmounted. Connect and mount it again, then resume."
msgstr "O destino foi desconectado ou desmontado. Conecte e monte de novo, depois retome."

#: big-mount/usr/lib/big-mount/drive-copy.sh:413
msgid "The destination ran out of space. Free some space or choose another place, then resume."
msgstr "O destino ficou sem espaço. Libere espaço ou escolha outro lugar, depois retome."

#: big-mount/usr/lib/big-mount/drive-copy.sh:414
msgid "%s files were set aside because they did not advance. The drive may be getting worse, so the copy stopped."
msgstr "%s arquivos foram deixados de lado porque não avançavam. A unidade pode estar piorando, por isso a cópia parou."

#: big-mount/usr/lib/big-mount/drive-copy.sh:415
msgid "Some files were not copied. See the list below."
msgstr "Alguns arquivos não foram copiados. Veja a lista abaixo."

#: big-mount/usr/lib/big-mount/drive-copy.sh:416
msgid "The check found differences between source and destination."
msgstr "A verificação encontrou diferenças entre origem e destino."

#: big-mount/usr/lib/big-mount/drive-copy.sh:417
msgid "rsync stopped with an error. See the log."
msgstr "O rsync parou com um erro. Veja o registro."

#: big-mount/usr/lib/big-mount/drive-copy.sh:420
msgid "Some areas of the disk could not be read. The image holds everything that could be."
msgstr "Algumas áreas do disco não puderam ser lidas. A imagem guarda tudo o que foi possível ler."

#: big-mount/usr/lib/big-mount/drive-copy.sh:421
msgid "Some folders could not be read, so the list may be incomplete. See the log."
msgstr "Algumas pastas não puderam ser lidas, então a lista pode estar incompleta. Veja o registro."

#: big-mount/usr/lib/big-mount/drive-copy.sh:422
msgid "PhotoRec stopped with an error. See the log."
msgstr "O PhotoRec parou com um erro. Veja o registro."

#: big-mount/usr/lib/big-mount/drive-copy.sh:423
msgid "No file was recognized by its content. That does not prove there is nothing to recover: another method, or a professional, may find more."
msgstr "Nenhum arquivo foi reconhecido pelo conteúdo. Isso não prova que não há nada a recuperar: outro método, ou um profissional, pode encontrar mais."

#: big-mount/usr/lib/big-mount/drive-copy.sh:513
msgid "its content could not be read"
msgstr "seu conteúdo não pôde ser lido"

#: big-mount/usr/lib/big-mount/drive-copy.sh:959
#: big-mount/usr/lib/big-mount/drive-recovery.sh:889
msgid "Source:"
msgstr "Origem:"

#: big-mount/usr/lib/big-mount/drive-copy.sh:959
#: big-mount/usr/lib/big-mount/drive-recovery.sh:894
msgid "Destination:"
msgstr "Destino:"

#: big-mount/usr/lib/big-mount/drive-copy.sh:961
#: big-mount/usr/lib/big-mount/drive-copy.sh:963
msgid "Files:"
msgstr "Arquivos:"

#: big-mount/usr/lib/big-mount/drive-copy.sh:973
#: big-mount/usr/lib/big-mount/drive-copy.sh:974
msgid "Copied:"
msgstr "Copiado:"

#: big-mount/usr/lib/big-mount/drive-copy.sh:978
msgid "Speed:"
msgstr "Velocidade:"

#: big-mount/usr/lib/big-mount/drive-copy.sh:978
msgid "average"
msgstr "média"

#: big-mount/usr/lib/big-mount/drive-copy.sh:979
#: big-mount/usr/lib/big-mount/drive-recovery.sh:902
msgid "Elapsed:"
msgstr "Decorrido:"

#: big-mount/usr/lib/big-mount/drive-copy.sh:980
msgid "Remaining:"
msgstr "Restante:"

#: big-mount/usr/lib/big-mount/drive-copy.sh:981
msgid "Waiting for the disk to answer, for %s seconds"
msgstr "Aguardando o disco responder há %s segundos"

#: big-mount/usr/lib/big-mount/drive-copy.sh:982
msgid "Current file:"
msgstr "Arquivo atual:"

#: big-mount/usr/lib/big-mount/drive-copy.sh:983
msgid "Set aside:"
msgstr "Deixados de lado:"

#: big-mount/usr/lib/big-mount/drive-copy.sh:984
msgid "Failed:"
msgstr "Falharam:"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1024
msgid "Cancelled. Files already copied stay at the destination, and the copy can be resumed."
msgstr "Cancelada. Os arquivos já copiados ficam no destino, e a cópia pode ser retomada."

#: big-mount/usr/lib/big-mount/drive-copy.sh:1040
msgid "Source"
msgstr "Origem"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1045
#: big-mount/usr/lib/big-mount/drive-recovery.sh:916
msgid "Destination"
msgstr "Destino"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1046
