msgstr "Na tomto disku probíhá jiná operace. Nic se neprovedlo."

#: big-mount/usr/lib/big-mount/cli.sh:1110
msgid "To confirm, type the name of the drive (%s):"
msgstr "Pro potvrzení zadejte název disku (%s):"

#: big-mount/usr/lib/big-mount/cli.sh:1112
#: big-mount/usr/lib/big-mount/cli.sh:1127
#: big-mount/usr/lib/big-mount/drive-erase.sh:159
msgid "Nothing was erased."
msgstr "Nic nebylo vymazáno."

#: big-mount/usr/lib/big-mount/cli.sh:1118
#: big-mount/usr/lib/big-mount/drive-erase.sh:79
#: big-mount/usr/lib/big-mount/drive-erase.sh:128
#: big-mount/usr/lib/big-mount/drive-erase.sh:201
#: big-mount/usr/lib/big-mount/drive-erase.sh:204
#: big-mount/usr/lib/big-mount/drive-erase.sh:221
#: big-mount/usr/lib/big-mount/lib.sh:1331
msgid "The drive was disconnected or replaced. Nothing was erased."
msgstr "Disk byl vypojen nebo vyměněn. Nic nebylo vymazáno."

#: big-mount/usr/lib/big-mount/cli.sh:1129
msgid "These services use the drive and will be stopped:"
msgstr "Tyto služby používají disk a budou zastaveny:"

#: big-mount/usr/lib/big-mount/cli.sh:1145
msgid "Sleep now"
msgstr "Uspat nyní"

#: big-mount/usr/lib/big-mount/cli.sh:1152
msgid "Erasing %s. Do not turn off the computer or disconnect the drive."
msgstr "Probíhá mazání %s. Nevypínejte počítač ani nevypojujte disk."

#: big-mount/usr/lib/big-mount/cli.sh:1158
msgid "Without a graphical session, run it as administrator: sudo bigmount --secure-erase DISK"
msgstr "Bez grafického sezení jej spusťte jako správce: sudo bigmount --secure-erase DISK"

