#: big-mount/usr/lib/big-mount/doctor.sh:260
msgid "A copy in /etc/systemd/system overrides the package: remove it unless it is intended."
msgstr "Kopija u /etc/systemd/system nadjačava paket: uklonite je ako nije namjerna."

#: big-mount/usr/lib/big-mount/doctor.sh:262
