[Desktop Entry]
Type=Application
Name[pt_BR]=Diagnóstico de Armazenamento
Name=Storage Diagnostics
GenericName[pt_BR]=Diagnóstico de dispositivos de armazenamento
GenericName=Storage device diagnostics
Comment[pt_BR]=Descubra por que uma unidade está somente leitura ou ocupada e remova-a com segurança
Comment=Find out why a drive is read-only or busy, and remove it safely
Exec=/usr/bin/bigmount --gui
Icon=big-mount
Terminal=false
Categories=System;Filesystem;
Keywords[pt_BR]=disco;unidade;usb;pendrive;montar;desmontar;somente leitura;ocupado;ejetar;ssd;apagar;
Keywords=disk;drive;usb;mount;unmount;read-only;busy;eject;ssd;erase;
Actions=checkDrive;

[Desktop Action checkDrive]
Name[pt_BR]=Verificar uma unidade (erros, Secure Erase)
Name=Check a drive (errors, Secure Erase)
Icon=drive-harddisk
Exec=/usr/bin/bigmount --gui-drive
