#: locale/templates/big-mount.desktop.in:15
msgid "Storage Diagnostics"
msgstr "Diagnosticarea stocării"

#: locale/templates/big-mount-notifier.desktop.in:3
msgid "Big-Mount notifier"
msgstr "Notificator Big-Mount"

#: locale/templates/big-mount-notifier.desktop.in:4
msgid "Explains why a storage device cannot be written to"
msgstr "Explică de ce nu se poate scrie pe un dispozitiv de stocare"

#: locale/templates/big-mount-servicemenu.desktop.in:6
msgid "Storage device"
msgstr "Dispozitiv de stocare"

#: locale/templates/big-mount-servicemenu.desktop.in:16
msgid "Safely remove (shows what keeps it busy)"
msgstr "Scoate în siguranță (arată ce îl ține ocupat)"

#: locale/templates/big-mount-servicemenu.desktop.in:21
msgid "Diagnose the drive and rescue files"
msgstr "Diagnostichează unitatea și salvează fișiere"

#: locale/templates/org.biglinux.big-mount.policy.in:11
msgid "Show the programs of all users that keep a storage device busy"
msgstr "Arată programele tuturor utilizatorilor care țin ocupat un dispozitiv de stocare"

#: locale/templates/org.biglinux.big-mount.policy.in:12
msgid "Authentication is required to see the programs of all users that are using this device"
msgstr "Este necesară autentificarea pentru a vedea programele tuturor utilizatorilor care folosesc acest dispozitiv"

#: locale/templates/org.biglinux.big-mount.policy.in:24
msgid "Protect a storage device, read its health or make a disk image"
msgstr "Protejează un dispozitiv de stocare, citește-i sănătatea sau creează o imagine de disc"

#: locale/templates/org.biglinux.big-mount.policy.in:25
msgid "Authentication is required to protect this storage device, read its health or make a disk image"
msgstr "Este necesară autentificarea pentru a proteja acest dispozitiv de stocare, a-i citi sănătatea sau a crea o imagine de disc"
