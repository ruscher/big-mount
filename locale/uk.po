msgstr "Скопійовано:"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1019
msgid "average"
msgstr "у середньому"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1019
msgid "Speed:"
msgstr "Швидкість:"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1020
#: big-mount/usr/lib/big-mount/drive-recovery.sh:948
msgid "Elapsed:"
msgstr "Минуло:"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1021
msgid "Remaining:"
msgstr "Залишилося:"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1025
msgid "Current file:"
msgstr "Поточний файл:"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1026
msgid "Set aside:"
msgstr "Відкладено:"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1027
msgid "Failed:"
msgstr "Не скопійовано:"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1067
msgid "Cancelled. Files already copied stay at the destination, and the copy can be resumed."
msgstr "Скасовано. Уже скопійовані файли залишаються в місці призначення, і копіювання можна продовжити."

#: big-mount/usr/lib/big-mount/drive-copy.sh:1083
msgid "Source"
msgstr "Джерело"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1088
#: big-mount/usr/lib/big-mount/drive-recovery.sh:962
msgid "Destination"
msgstr "Призначення"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1089
msgid "Files copied"
msgstr "Скопійовано файлів"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1090
msgid "Data copied"
msgstr "Скопійовано даних"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1091
#: big-mount/usr/lib/big-mount/drive-recovery.sh:966
msgid "Elapsed"
msgstr "Минуло"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1093
#: big-mount/usr/lib/big-mount/drive-copy.sh:1094
#: big-mount/usr/lib/big-mount/drive-copy.sh:1095
#: big-mount/usr/lib/big-mount/drive-copy.sh:1096
msgid "Check"
msgstr "Перевірка"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1093
msgid "source and destination match"
msgstr "джерело і призначення збігаються"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1095
msgid "did not finish"
msgstr "не завершено"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1096
msgid "rsync confirmed each file as it was copied; no second comparison was made"
msgstr "rsync підтверджував кожен файл під час копіювання; повторного порівняння не виконувалося"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1098
msgid "Already at the destination, with different content"
msgstr "Уже є в місці призначення, з іншим вмістом"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1102
msgid "Set aside because they did not advance (damaged area of the disk):"
msgstr "Відкладено, бо копіювання не просувалося (пошкоджена ділянка диска):"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1105
msgid "To try them again, which puts more strain on the disk: bigmount --drive resume %s --retry-deferred"
msgstr "Щоб спробувати їх ще раз (це сильніше навантажує диск): bigmount --drive resume %s --retry-deferred"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1109
msgid "Not copied:"
msgstr "Не скопійовано:"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1114
msgid "Different at the destination:"
msgstr "Відрізняються в місці призначення:"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1117
msgid "Log:"
msgstr "Журнал:"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1141
#: big-mount/usr/lib/big-mount/drive.sh:239
msgid "Serial number"
msgstr "Серійний номер"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1141
#: big-mount/usr/lib/big-mount/drive.sh:255
msgid "Label"
msgstr "Мітка"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1173
msgid "'%s' already exists. Nothing was written."
msgstr "«%s» вже існує. Нічого не записано."

#: big-mount/usr/lib/big-mount/drive-copy.sh:1189
msgid "Kernel messages:"
msgstr "Повідомлення ядра:"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1197
msgid "'%s' is a folder. Nothing was written."
msgstr "«%s» — це тека. Нічого не записано."

#: big-mount/usr/lib/big-mount/drive-copy.sh:1205
msgid "Report written to %s"
msgstr "Звіт записано до %s"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1258
#: big-mount/usr/lib/big-mount/drive-copy.sh:1265
msgid "free"
msgstr "вільно"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1261
msgid "drive with critical alerts"
msgstr "диск із критичними попередженнями"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1262
msgid "same physical disk as the source"
msgstr "той самий фізичний диск, що й джерело"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1263
msgid "not enough space"
msgstr "недостатньо місця"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1279
msgid "Home folder"
msgstr "Домашня тека"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1326
#: big-mount/usr/lib/big-mount/drive-copy.sh:1482
#: big-mount/usr/lib/big-mount/drive-copy.sh:1494
#: big-mount/usr/lib/big-mount/drive-copy.sh:1539
#: big-mount/usr/lib/big-mount/drive-recovery.sh:986
msgid "There is no job '%s'."
msgstr "Завдання «%s» не існує."

#: big-mount/usr/lib/big-mount/drive-copy.sh:1329
msgid "Only the results of a search by content can be copied this way."
msgstr "Таким чином можна копіювати лише результати пошуку за вмістом."

#: big-mount/usr/lib/big-mount/drive-copy.sh:1336
#: big-mount/usr/lib/big-mount/drive-recovery.sh:521
#: big-mount/usr/lib/big-mount/drive-recovery.sh:847
msgid "Both --source and --destination are needed."
msgstr "Потрібні обидва параметри: --source і --destination."

#: big-mount/usr/lib/big-mount/drive-copy.sh:1430
msgid "The copy could not be started."
msgstr "Не вдалося почати копіювання."

#: big-mount/usr/lib/big-mount/drive-copy.sh:1435
#: big-mount/usr/lib/big-mount/drive-copy.sh:1566
#: big-mount/usr/lib/big-mount/drive-recovery.sh:291
msgid "Copy started: %s"
msgstr "Копіювання розпочато: %s"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1437
#: big-mount/usr/lib/big-mount/drive-recovery.sh:293
msgid "To follow it: bigmount --drive status %s --watch"
msgstr "Щоб стежити за ним: bigmount --drive status %s --watch"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1468
