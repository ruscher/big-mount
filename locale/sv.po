msgstr "(tom, eller så kunde den inte läsas)"

#: big-mount/usr/lib/big-mount/drive-tui.sh:212
msgid "NUMBER: open a folder | m NUMBER: mark or unmark | u: up | d: done | 0: back"
msgstr "NUMMER: öppna en mapp | m NUMMER: markera eller avmarkera | u: upp | d: klar | 0: tillbaka"

