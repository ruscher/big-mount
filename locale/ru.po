msgstr "безопасно остановить (можно продолжить позже)"

#: big-mount/usr/lib/big-mount/drive.sh:147
msgid "continue it, also after a shutdown; optionally try what was set aside"
msgstr "продолжить, в том числе после выключения; по желанию повторить отложенное"

