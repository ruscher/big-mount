[Desktop Entry]
Type=Service
MimeType=inode/directory;
X-KDE-Protocols=file
X-KDE-RequiredNumberOfUrls=1
X-KDE-Submenu[be]=Прылада захоўвання
X-KDE-Submenu[bg]=Устройство за съхранение
X-KDE-Submenu[cs]=Úložné zařízení
