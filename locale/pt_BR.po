msgstr "continua, inclusive depois de desligar; opcionalmente tenta o que ficou de lado"

#: big-mount/usr/lib/big-mount/drive.sh:141
msgid "report of a drive or of a copy (--output FILE)"
msgstr "relatório de uma unidade ou cópia (--output ARQUIVO)"

#: big-mount/usr/lib/big-mount/drive.sh:142
msgid "make a disk image with GNU ddrescue"
msgstr "faz uma imagem de disco com o GNU ddrescue"

#: big-mount/usr/lib/big-mount/drive.sh:143
msgid "look for partitions with TestDisk, changing nothing"
msgstr "procura partições com o TestDisk, sem alterar nada"

#: big-mount/usr/lib/big-mount/drive.sh:144
msgid "search for files by content with PhotoRec"
msgstr "busca arquivos por conteúdo com o PhotoRec"

#: big-mount/usr/lib/big-mount/drive.sh:145
msgid "machine-readable output"
msgstr "saída para programas"

#: big-mount/usr/lib/big-mount/drive.sh:146
msgid "say what would be done, change nothing"
msgstr "diz o que seria feito, sem alterar nada"

#: big-mount/usr/lib/big-mount/drive.sh:147
msgid "TARGET is a device (/dev/sdb1) or a folder inside a mounted device."
msgstr "ALVO é um dispositivo (/dev/sdb1) ou uma pasta dentro de um dispositivo montado."

#: big-mount/usr/lib/big-mount/drive.sh:179
msgid "The list of devices could not be read."
msgstr "Não foi possível ler a lista de dispositivos."

#: big-mount/usr/lib/big-mount/drive.sh:194
msgid "Manufacturer"
msgstr "Fabricante"

#: big-mount/usr/lib/big-mount/drive.sh:195
msgid "Model"
msgstr "Modelo"

#: big-mount/usr/lib/big-mount/drive.sh:200
msgid "Partition table"
msgstr "Tabela de partições"

#: big-mount/usr/lib/big-mount/drive.sh:214
msgid "Size"
msgstr "Tamanho"

#: big-mount/usr/lib/big-mount/drive.sh:221
msgid "Space"
msgstr "Espaço"

#: big-mount/usr/lib/big-mount/drive.sh:223
msgid "Writing"
msgstr "Gravação"

#: big-mount/usr/lib/big-mount/drive.sh:223
msgid "blocked on the device"
msgstr "bloqueada no dispositivo"

#: big-mount/usr/lib/big-mount/drive.sh:310
msgid "smartctl is not installed (package smartmontools), so SMART details cannot be read."
msgstr "O smartctl não está instalado (pacote smartmontools), então os detalhes de SMART não podem ser lidos."

#: big-mount/usr/lib/big-mount/drive.sh:315
msgid "Permission to read SMART was not granted."
msgstr "A permissão para ler o SMART não foi concedida."

#: big-mount/usr/lib/big-mount/drive.sh:316
#: big-mount/usr/lib/big-mount/drive-tui.sh:120
msgid "The drive did not report SMART data. Many USB adapters do not pass it through."
msgstr "A unidade não informou dados de SMART. Muitos adaptadores USB não os repassam."

#: big-mount/usr/lib/big-mount/drive.sh:339
msgid "Mounted read-only at %s"
msgstr "Montado somente leitura em %s"

#: big-mount/usr/lib/big-mount/drive.sh:340
msgid "Mounted at %s"
msgstr "Montado em %s"

#: big-mount/usr/lib/big-mount/drive.sh:342
msgid "Writing is also blocked on the device itself until it is disconnected."
msgstr "A gravação também está bloqueada no próprio dispositivo até ele ser desconectado."

#: big-mount/usr/lib/big-mount/drive.sh:363
#: big-mount/usr/lib/big-mount/drive.sh:421
#: big-mount/usr/lib/big-mount/drive.sh:440
msgid "Name a device, such as /dev/sdb1."
msgstr "Informe um dispositivo, como /dev/sdb1."

#: big-mount/usr/lib/big-mount/drive.sh:411
msgid "Nothing was done. Use bigmount --unmount to confirm stopping them."
msgstr "Nada foi feito. Use bigmount --unmount para confirmar a parada deles."

#: big-mount/usr/lib/big-mount/drive.sh:426
msgid "Writing is now blocked on this device until it is disconnected."
msgstr "A gravação agora está bloqueada neste dispositivo até ele ser desconectado."

#: big-mount/usr/lib/big-mount/drive.sh:427
msgid "Writing is allowed on this device again."
msgstr "A gravação está liberada de novo neste dispositivo."

#: big-mount/usr/lib/big-mount/drive.sh:430
msgid "Another volume of this drive is mounted with writing enabled. Unmount it first."
msgstr "Outro volume desta unidade está montado com gravação ativada. Desmonte-o primeiro."

#: big-mount/usr/lib/big-mount/drive.sh:431
msgid "Refused: this drive holds the running system."
msgstr "Recusado: esta unidade contém o sistema em execução."

#: big-mount/usr/lib/big-mount/drive.sh:433
msgid "The helper failed (exit %s)."
msgstr "O auxiliar falhou (saída %s)."

#: big-mount/usr/lib/big-mount/drive.sh:442
msgid "Unlocking in the terminal needs an interactive terminal."
msgstr "Desbloquear no terminal exige um terminal interativo."

#: big-mount/usr/lib/big-mount/drive-tui.sh:35
msgid "Press Enter to continue."
msgstr "Pressione Enter para continuar."

#: big-mount/usr/lib/big-mount/drive-tui.sh:49
msgid "The interactive manager needs a terminal. For scripts, see bigmount --drive --help."
msgstr "O gerenciador interativo precisa de um terminal. Para scripts, veja bigmount --drive --help."

#: big-mount/usr/lib/big-mount/drive-tui.sh:55
msgid "Safe diagnosis and recovery"
msgstr "Diagnóstico e recuperação segura"

#: big-mount/usr/lib/big-mount/drive-tui.sh:56
msgid "Devices found: %s"
msgstr "Dispositivos encontrados: %s"

