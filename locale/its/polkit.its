<?xml version="1.0"?>
<!-- Copy of the ITS rules shipped by polkit, so the catalog can be built where
     polkit is not installed (CI). -->
<its:rules xmlns:its="http://www.w3.org/2005/11/its"
           version="2.0">
  <its:translateRule selector="//*" translate="no"/>
  <its:translateRule selector="//action/description |
                               //action/message"
                     translate="yes"/>
</its:rules>
