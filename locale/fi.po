#: locale/templates/big-mount.desktop.in:5
msgid "See how your drives are doing, rescue files from them and remove them safely"
msgstr "Katso asemiesi kunto, pelasta niiltä tiedostoja ja poista ne turvallisesti"

#: locale/templates/big-mount.desktop.in:11
msgid "disk;drive;usb;mount;unmount;read-only;busy;eject;ssd;erase;recover;rescue;backup;smart;storage;diagnostics;"
msgstr "levy;asema;usb;liitä;irrota;vain luku;varattu;poista asemasta;ssd;tyhjennä;palauta;pelasta;varmuuskopio;smart;tallennus;diagnostiikka;"

#: locale/templates/big-mount.desktop.in:15
msgid "Storage Diagnostics"
msgstr "Tallennuslaitteiden diagnostiikka"

#: locale/templates/big-mount-notifier.desktop.in:3
msgid "Big-Mount notifier"
msgstr "Big-Mountin ilmoitin"

#: locale/templates/big-mount-notifier.desktop.in:4
msgid "Explains why a storage device cannot be written to"
msgstr "Selittää, miksi tallennuslaitteelle ei voi kirjoittaa"

#: locale/templates/big-mount-servicemenu.desktop.in:6
msgid "Storage device"
msgstr "Tallennuslaite"

#: locale/templates/big-mount-servicemenu.desktop.in:16
msgid "Safely remove (shows what keeps it busy)"
msgstr "Poista turvallisesti (näyttää, mikä pitää sen varattuna)"

#: locale/templates/big-mount-servicemenu.desktop.in:21
msgid "Diagnose the drive and rescue files"
msgstr "Diagnosoi asema ja pelasta tiedostot"

#: locale/templates/org.biglinux.big-mount.policy.in:11
msgid "Show the programs of all users that keep a storage device busy"
msgstr "Näytä kaikkien käyttäjien ohjelmat, jotka pitävät tallennuslaitetta varattuna"

#: locale/templates/org.biglinux.big-mount.policy.in:12
msgid "Authentication is required to see the programs of all users that are using this device"
msgstr "Kaikkien käyttäjien tätä laitetta käyttävien ohjelmien näkeminen vaatii tunnistautumisen"

#: locale/templates/org.biglinux.big-mount.policy.in:24
msgid "Protect a storage device, read its health or make a disk image"
msgstr "Suojaa tallennuslaite, lue sen kunto tai tee levykuva"

#: locale/templates/org.biglinux.big-mount.policy.in:25
msgid "Authentication is required to protect this storage device, read its health or make a disk image"
msgstr "Tämän tallennuslaitteen suojaaminen, sen kunnon lukeminen tai levykuvan tekeminen vaatii tunnistautumisen"
