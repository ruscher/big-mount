msgstr "會要求輸入管理員密碼。"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:704
#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:829
#, python-format
msgid "Not available: %s"
msgstr "無法使用：%s"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:717
#, python-format
msgid "Use %s"
msgstr "使用 %s"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:719
