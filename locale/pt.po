msgstr "Sessão: %s, ambiente de trabalho: %s, idioma: %s"

#: big-mount/usr/lib/big-mount/doctor.sh:303
msgid "copying files off a drive"
msgstr "copiar ficheiros de uma unidade"

#: big-mount/usr/lib/big-mount/doctor.sh:303
msgid "SMART details"
msgstr "detalhes SMART"

#: big-mount/usr/lib/big-mount/doctor.sh:303
