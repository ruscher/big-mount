msgid "Select"
msgstr "Seleccionar"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:534
msgid "Preview"
msgstr "Vista previa"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:600
msgid "It cannot be copied"
msgstr "No se puede copiar"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:603
#, python-format
msgid "%d file with a line break in its name was left out. It cannot be handled safely."
msgid_plural "%d files with a line break in their names were left out. They cannot be handled safely."
msgstr[0] "Se omitió %d archivo con un salto de línea en su nombre. No se puede tratar con seguridad."
msgstr[1] "Se omitieron %d archivos con un salto de línea en su nombre. No se pueden tratar con seguridad."

