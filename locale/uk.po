msgid "%d shown"
msgid_plural "%d shown"
msgstr[0] "Показано %d файл"
msgstr[1] "Показано %d файли"
msgstr[2] "Показано %d файлів"
msgstr[3] "Показано %d файл"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:494
