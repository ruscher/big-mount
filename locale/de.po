msgstr "nur diese Typen: photos,videos,documents,audio,archives (Standard: alle)"

#: big-mount/usr/lib/big-mount/drive.sh:155
msgid "what a search found"
msgstr "was eine Suche gefunden hat"

#: big-mount/usr/lib/big-mount/drive.sh:156
