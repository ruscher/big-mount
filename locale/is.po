#: big-mount/usr/bin/bigmount:84
msgid "bigmount: mounting the internal partitions needs administrator rights. big-mount.service does it at every boot."
msgstr "bigmount: kerfisstjóraréttindi þarf til að tengja innri disksneiðarnar. big-mount.service gerir það við hverja ræsingu."

#: big-mount/usr/bin/bigmount:85
msgid "To mount them now:            sudo systemctl restart big-mount"
msgstr "Til að tengja þær núna:      sudo systemctl restart big-mount"

#: big-mount/usr/bin/bigmount:86
msgid "To see what would be mounted: bigmount --dry-run"
msgstr "Til að sjá hvað yrði tengt:  bigmount --dry-run"

#: big-mount/usr/bin/bigmount:87
msgid "To check the installation:    bigmount --doctor"
msgstr "Til að athuga uppsetninguna: bigmount --doctor"

#: big-mount/usr/bin/bigmount:97
msgid "cannot open the lock file /run/lock/big-mount.lock, giving up"
msgstr "get ekki opnað læsingarskrána /run/lock/big-mount.lock, hætti við"

#: big-mount/usr/bin/bigmount:102
msgid "another bigmount is still running, giving up"
msgstr "annað bigmount-ferli er enn í gangi, hætti við"

#: big-mount/usr/bin/bigmount:144
msgid "last login '%s' is not a known account, ignoring it"
msgstr "síðasti innskráði notandi '%s' er ekki þekktur aðgangur, hunsa hann"

#: big-mount/usr/bin/bigmount:165
msgid "/etc/big-mount.conf: unknown value '%s', using shared"
msgstr "/etc/big-mount.conf: óþekkt gildi '%s', nota shared"

#: big-mount/usr/bin/bigmount:304
msgid "%s: skipped, %s is not a filesystem"
msgstr "%s: sleppt, %s er ekki skráakerfi"

#: big-mount/usr/bin/bigmount:310
msgid "%s: skipped, virtual device"
msgstr "%s: sleppt, sýndartæki"

#: big-mount/usr/bin/bigmount:317
msgid "%s: skipped, already mounted"
msgstr "%s: sleppt, er þegar tengt"

#: big-mount/usr/bin/bigmount:353
msgid "waiting for udev to finish processing %s"
msgstr "bíð eftir að udev ljúki vinnslu á %s"

#: big-mount/usr/bin/bigmount:420
msgid "%s: udev has no information about it yet, not mounting"
msgstr "%s: udev hefur engar upplýsingar um það enn, tengi það ekki"

#: big-mount/usr/bin/bigmount:424
msgid "%s: skipped, hidden by udev/UDisks (UDISKS_IGNORE)"
msgstr "%s: sleppt, falið af udev/UDisks (UDISKS_IGNORE)"

#: big-mount/usr/bin/bigmount:432
msgid "%s: left to UDisks, external device (%s)"
msgstr "%s: látið UDisks eftir, ytra tæki (%s)"

#: big-mount/usr/bin/bigmount:438
msgid "%s: skipped, listed in /etc/fstab"
msgstr "%s: sleppt, skráð í /etc/fstab"

#: big-mount/usr/bin/bigmount:484
msgid "%s: %s is a link or already in use, not mounting"
msgstr "%s: %s er tengill eða þegar í notkun, ekki tengt"

#: big-mount/usr/bin/bigmount:494
msgid "%s: device changed during the scan, not mounting"
msgstr "%s: tækið breyttist á meðan leitað var, tengi það ekki"

#: big-mount/usr/bin/bigmount:520
msgid "%s: NTFS refused read-write mount (%s), retrying read-only"
msgstr "%s: NTFS hafnaði tengingu með skrifaðgangi (%s), reyni aftur aðeins til lestrar"

#: big-mount/usr/bin/bigmount:537
msgid "%s: mount of %s on %s failed (exit %s)"
msgstr "%s: mistókst að tengja %s í %s (útgangskóði %s)"

#: big-mount/usr/bin/bigmount:559
msgid "%s: the driver mounted %s read-only on its own (%s)"
msgstr "%s: rekillinn tengdi %s aðeins til lestrar af sjálfsdáðum (%s)"

#: big-mount/usr/bin/bigmount:566
msgid "%s: would be mounted %s on %s (%s)"
msgstr "%s: %s yrði tengt í %s (%s)"

#: big-mount/usr/bin/bigmount:568
msgid "%s: mounted %s on %s (%s)"
msgstr "%s: %s tengt í %s (%s)"

#: big-mount/usr/lib/big-mount/cli.sh:29
msgid "Usage: bigmount [OPTION]"
msgstr "Notkun: bigmount [VALKOSTUR]"

#: big-mount/usr/lib/big-mount/cli.sh:32
msgid "(none)"
msgstr "(ekkert)"

#: big-mount/usr/lib/big-mount/cli.sh:32
msgid "mount internal partitions (run at boot by big-mount.service)"
msgstr "tengja innri disksneiðar (keyrt við ræsingu af big-mount.service)"

#: big-mount/usr/lib/big-mount/cli.sh:34
msgid "show what would be mounted, change nothing"
msgstr "sýna hvað yrði tengt, breyta engu"

#: big-mount/usr/lib/big-mount/cli.sh:35
msgid "check the boot service and what it did in this boot"
msgstr "athuga ræsiþjónustuna og hvað hún gerði í þessari ræsingu"

#: big-mount/usr/lib/big-mount/cli.sh:36
msgid "show the version and the source revision"
msgstr "sýna útgáfuna og endurskoðun frumkóðans"

#: big-mount/usr/lib/big-mount/cli.sh:37
msgid "show this help"
msgstr "sýna þessa hjálp"

#: big-mount/usr/lib/big-mount/cli.sh:38
msgid "Configuration: /etc/big-mount.conf. To mount again now: sudo systemctl restart big-mount"
msgstr "Stillingar: /etc/big-mount.conf. Til að tengja aftur núna: sudo systemctl restart big-mount"

#: big-mount/usr/lib/big-mount/cli.sh:39
msgid "Diagnosis of devices, safe removal and file rescue: big-storage-rescue (package big-storage-rescue)."
msgstr "Greining tækja, örugg fjarlæging og björgun skráa: big-storage-rescue (pakkinn big-storage-rescue)."

#: big-mount/usr/lib/big-mount/cli.sh:57 big-mount/usr/lib/big-mount/cli.sh:289
msgid "bigmount: unknown option '%s' (see bigmount --help)"
msgstr "bigmount: óþekktur valkostur '%s' (sjá bigmount --help)"

#: big-mount/usr/lib/big-mount/cli.sh:73
msgid "bigmount: Secure Erase is no longer part of Big-Mount."
msgstr "bigmount: Secure Erase er ekki lengur hluti af Big-Mount."

#: big-mount/usr/lib/big-mount/cli.sh:79
msgid "bigmount: %s moved to Big Storage Rescue. Use: %s"
msgstr "bigmount: %s hefur verið flutt í Big Storage Rescue. Notaðu: %s"

#: big-mount/usr/lib/big-mount/cli.sh:81
msgid "Install it with: sudo pacman -S big-storage-rescue"
msgstr "Settu pakkann upp með: sudo pacman -S big-storage-rescue"

#: big-mount/usr/lib/big-mount/cli.sh:128
msgid "source checkout (not installed by a package)"
msgstr "afrit af frumkóða (ekki sett upp með pakka)"

#: big-mount/usr/lib/big-mount/cli.sh:137
msgid "package:"
msgstr "pakki:"

#: big-mount/usr/lib/big-mount/cli.sh:137
msgid "revision:"
msgstr "endurskoðun:"

#: big-mount/usr/lib/big-mount/cli.sh:137
msgid "source:"
msgstr "frumkóði:"

#: big-mount/usr/lib/big-mount/cli.sh:145
msgid "unknown"
msgstr "óþekkt"

#: big-mount/usr/lib/big-mount/cli.sh:188
msgid "Missing file of the package: %s"
msgstr "Skrá úr pakkanum vantar: %s"

#: big-mount/usr/lib/big-mount/cli.sh:189
#: big-mount/usr/lib/big-mount/cli.sh:198
#: big-mount/usr/lib/big-mount/cli.sh:220
msgid "Reinstall the big-mount package."
msgstr "Settu big-mount-pakkann upp aftur."

#: big-mount/usr/lib/big-mount/cli.sh:197
msgid "Unsafe owner or permissions: %s (%s)"
msgstr "Óöruggur eigandi eða heimildir: %s (%s)"

#: big-mount/usr/lib/big-mount/cli.sh:205
msgid "Boot service (big-mount.service)"
msgstr "Ræsiþjónusta (big-mount.service)"

#: big-mount/usr/lib/big-mount/cli.sh:207
msgid "/etc/bigmountall-no exists: mounting at boot is disabled on purpose"
msgstr "/etc/bigmountall-no er til: slökkt er á tengingu við ræsingu af ásettu ráði"

#: big-mount/usr/lib/big-mount/cli.sh:219
msgid "Enabled at boot"
msgstr "Virk við ræsingu"

#: big-mount/usr/lib/big-mount/cli.sh:220
msgid "Not found by systemd"
msgstr "systemd finnur hana ekki"

#: big-mount/usr/lib/big-mount/cli.sh:221
msgid "Not enabled at boot (%s)"
msgstr "Ekki virk við ræsingu (%s)"

#: big-mount/usr/lib/big-mount/cli.sh:221
msgid "Enable it: sudo systemctl enable big-mount"
msgstr "Virkjaðu hana: sudo systemctl enable big-mount"

#: big-mount/usr/lib/big-mount/cli.sh:224
msgid "Ran in this boot"
msgstr "Keyrði í þessari ræsingu"

#: big-mount/usr/lib/big-mount/cli.sh:226
msgid "State in this boot: %s (%s)"
msgstr "Staða í þessari ræsingu: %s (%s)"

#: big-mount/usr/lib/big-mount/cli.sh:227
msgid "See: journalctl -b -u big-mount"
msgstr "Sjá: journalctl -b -u big-mount"

#: big-mount/usr/lib/big-mount/cli.sh:230
msgid "The unit is replaced by %s"
msgstr "Einingunni er skipt út fyrir %s"

#: big-mount/usr/lib/big-mount/cli.sh:231
msgid "A copy in /etc/systemd/system overrides the package: remove it unless it is intended."
msgstr "Afrit í /etc/systemd/system hefur forgang fram yfir pakkann: fjarlægðu það nema það sé ætlunin."

#: big-mount/usr/lib/big-mount/cli.sh:233
msgid "Drop-in files change the unit: %s"
msgstr "Viðbótarskrár (drop-in) breyta einingunni: %s"

#: big-mount/usr/lib/big-mount/cli.sh:243
msgid "Partitions handled by Big-Mount at boot: %d"
msgstr "Disksneiðar sem Big-Mount sér um við ræsingu: %d"

#: big-mount/usr/lib/big-mount/cli.sh:244
msgid "Failed at boot"
msgstr "Mistókst við ræsingu"

#: big-mount/usr/lib/big-mount/cli.sh:245
msgid "Mounted read-only at boot"
msgstr "Tengt aðeins til lestrar við ræsingu"

#: big-mount/usr/lib/big-mount/cli.sh:251
msgid "Configuration: PERMISSIONS=%s"
msgstr "Stillingar: PERMISSIONS=%s"

#: big-mount/usr/lib/big-mount/cli.sh:252
msgid "Configuration: unknown PERMISSIONS value, shared is used"
msgstr "Stillingar: óþekkt PERMISSIONS-gildi, shared er notað"

#: big-mount/usr/lib/big-mount/cli.sh:260
msgid "Warnings in the journal of this boot"
msgstr "Viðvaranir í annál þessarar ræsingar"

#: big-mount/usr/lib/big-mount/cli.sh:263
msgid "The journal is not readable by this user: boot messages not checked"
msgstr "Þessi notandi getur ekki lesið annálinn: ræsiskilaboð voru ekki athuguð"

#: big-mount/usr/lib/big-mount/cli.sh:278
msgid "%s is mounted on top of %s, whose files are hidden under it"
msgstr "%s er tengt ofan á %s, og skrár þess eru faldar undir því"

#: big-mount/usr/lib/big-mount/cli.sh:280
msgid "Unmount the one on top (sudo umount %s), then mount again: sudo systemctl restart big-mount"
msgstr "Aftengdu það efra (sudo umount %s) og tengdu aftur: sudo systemctl restart big-mount"

#: big-mount/usr/lib/big-mount/cli.sh:294
msgid "Big-Mount check (nothing is changed; labels and mount points are left out)"
msgstr "Athugun Big-Mount (engu er breytt; merkjum og tengipunktum er sleppt)"

#: big-mount/usr/lib/big-mount/cli.sh:299
msgid "Result: %d problem(s), %d warning(s)."
msgstr "Niðurstaða: vandamál: %d, viðvaranir: %d."

#: big-mount/usr/lib/big-mount/cli.sh:301
msgid "Why a partition is read-only or failed to mount, and the health of its drive: big-storage-rescue --diagnose DEVICE"
msgstr "Hvers vegna disksneið er aðeins til lestrar eða ekki tókst að tengja hana, og ástand drifsins sem hún er á: big-storage-rescue --diagnose TÆKI"

#: big-mount/usr/lib/big-mount/cli.sh:303
msgid "To find out why a partition is read-only or failed to mount, install big-storage-rescue."
msgstr "Til að komast að því hvers vegna disksneið er aðeins til lestrar eða ekki tókst að tengja hana skaltu setja upp big-storage-rescue."
