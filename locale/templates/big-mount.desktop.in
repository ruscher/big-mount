[Desktop Entry]
Type=Application
Name=Big-Mount
GenericName=Drive manager and file rescue
Comment=See how your drives are doing, rescue files from them and remove them safely
Exec=/usr/bin/bigmount --gui-drive
StartupWMClass=org.biglinux.big-mount
Icon=big-mount
Terminal=false
Categories=System;Filesystem;
Keywords=disk;drive;usb;mount;unmount;read-only;busy;eject;ssd;erase;recover;rescue;backup;smart;storage;diagnostics;
Actions=storageDiagnostics;

[Desktop Action storageDiagnostics]
Name=Storage Diagnostics
Icon=drive-harddisk
Exec=/usr/bin/bigmount --gui
