msgstr[0] "%d элемент пазначаны. Агульны аб’ём вымяраецца на наступных кроках."
msgstr[1] "%d элементы пазначаны. Агульны аб’ём вымяраецца на наступных кроках."
msgstr[2] "%d элементаў пазначана. Агульны аб’ём вымяраецца на наступных кроках."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:304
msgid "Mark what to copy. A marked folder takes everything inside. Only the folders you open are read."
msgstr "Пазначце, што скапіяваць. Пазначаны каталог уключае ўсё, што ў ім ёсць. Чытаюцца толькі тыя каталогі, якія вы адкрываеце."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:327
#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:397
msgid "Next"
msgstr "Далей"

