#, python-format
msgid "It can be saved here: %s free."
msgstr "Dá para salvar aqui: %s livres."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:869
msgid "It cannot be saved here."
msgstr "Não dá para salvar aqui."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:928
msgid "Checking the source and the destination…"
msgstr "Verificando a origem e o destino…"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:937
msgid "It cannot be started."
msgstr "Não pode começar."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:957
msgid "Method"
msgstr "Método"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:960
msgid "What"
msgstr "O quê"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:963
msgid "Space it will use"
msgstr "Espaço que vai usar"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:965
#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:967
msgid "To copy"
msgstr "A copiar"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:965
#, python-format
msgid "%(files)s files, %(size)s"
msgstr "%(files)s arquivos, %(size)s"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:969
msgid "Free at the destination"
msgstr "Livre no destino"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:971
msgid "Already there, with different content"
msgstr "Já lá, com conteúdo diferente"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:974
msgid "Your files will be copied with their names. Nothing is written to the source."
msgstr "Seus arquivos serão copiados com os nomes. Nada é gravado na origem."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:975
msgid "First a list of what exists is made. Then you choose what to copy. Nothing is written to the source."
msgstr "Primeiro é feita uma lista do que existe. Depois você escolhe o que copiar. Nada é gravado na origem."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:976
msgid "Files will be searched for by their content. Names and folders are lost, some files may come out incomplete, and finding nothing is possible. Nothing is written to the source."
msgstr "Os arquivos serão procurados pelo conteúdo. Nomes e pastas se perdem, alguns arquivos podem sair incompletos, e é possível não encontrar nada. Nada é gravado na origem."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:977
msgid "The disk is read once, into a file. Nothing is written to it."
msgstr "O disco é lido uma vez, para um arquivo. Nada é gravado nele."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:982
msgid "After the image, the search needs your confirmation. It can also be started later."
msgstr "Depois da imagem, a busca precisa da sua confirmação. Ela também pode ser iniciada mais tarde."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:984
msgid "Good to know"
msgstr "Bom saber"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:994
#, python-format
msgid "%d items you marked"
msgstr "%d itens que você marcou"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1004
msgid "If a file already exists"
msgstr "Se um arquivo já existir"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1009
msgid "Check the result"
msgstr "Verificar o resultado"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1011
msgid "Basic: rsync confirms each file as it is copied"
msgstr "Básica: o rsync confirma cada arquivo ao copiar"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1011
msgid "Names, sizes and dates compared at the end"
msgstr "Nomes, tamanhos e datas comparados no final"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1012
msgid "Content compared at the end (reads the source again)"
msgstr "Conteúdo comparado no final (lê a origem de novo)"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1016
msgid "Set aside a stuck file after (seconds)"
msgstr "Deixar de lado um arquivo preso após (segundos)"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1018
msgid "A file that does not advance for this long is set aside, so that the others are saved first. 0: never."
msgstr "Um arquivo que não avança por este tempo é deixado de lado, para salvar os outros primeiro. 0: nunca."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1022
msgid "Limit the reading speed (kB/s)"
msgstr "Limitar a velocidade de leitura (kB/s)"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1024
msgid "0: no limit"
msgstr "0: sem limite"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1035
msgid "Starting…"
msgstr "Começando…"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1044
#: big-mount/usr/lib/big-mount/gui/pages/results.py:608
msgid "It did not start"
msgstr "Não começou"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1085
msgid "Read the partition table"
msgstr "Ler a tabela de partições"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1086
msgid "Analyze the whole disk"
msgstr "Analisar o disco inteiro"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1087
msgid "It reads all of the disk. On a drive with problems this is extra wear."
msgstr "Lê o disco inteiro. Em um disco com problemas, isso é desgaste extra."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1090
msgid "This drive reported problems: analyzing all of it is extra wear. A disk image first spares it."
msgstr "Este disco relatou problemas: analisá-lo inteiro é desgaste extra. Fazer antes uma imagem de disco o poupa."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1103
msgid "Volumes this drive already has"
msgstr "Volumes que este disco já tem"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1104
msgid "They are not lost. To recover their files, copying them is faster and reads the disk less than any analysis."
msgstr "Eles não estão perdidos. Para recuperar os arquivos deles, copiar é mais rápido e lê o disco menos que qualquer análise."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1109
msgid "Recover its files"
msgstr "Recuperar os arquivos"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1121
msgid "Looking for partitions…"
msgstr "Procurando partições…"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1125
msgid "TestDisk does not say how far it has gone, so there is no percentage. Analyzing a whole disk reads all of it and can take hours; the drive can be used for nothing else meanwhile."
msgstr "O TestDisk não informa quanto já avançou, por isso não há porcentagem. Analisar um disco inteiro lê o disco todo e pode levar horas; enquanto isso, o disco não pode ser usado para mais nada."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1133
#, python-format
msgid "Elapsed: %s"
msgstr "Decorrido: %s"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1149
msgid "The search failed."
msgstr "A busca falhou."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1152
msgid "What TestDisk found"
msgstr "O que o TestDisk encontrou"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1158
msgid "Big-Mount does not rewrite partition tables, on purpose: a mistake there can lose everything. A disk image, or a search by content, recovers files without that risk."
msgstr "O Big-Mount não regrava tabelas de partições, de propósito: um erro ali pode perder tudo. Uma imagem de disco, ou uma busca por conteúdo, recupera arquivos sem esse risco."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1160
msgid "The analysis did not recognize any partition. That does not prove there is no data: a search by content may still find files."
msgstr "A análise não reconheceu nenhuma partição. Isso não prova que não há dados: uma busca por conteúdo ainda pode encontrar arquivos."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1162
msgid "The partition table is empty or unreadable. Analyzing the whole disk may find what it no longer lists."
msgstr "A tabela de partições está vazia ou ilegível. Analisar o disco inteiro pode achar o que ela já não lista."

#: big-mount/usr/lib/big-mount/gui/pages/results.py:212
