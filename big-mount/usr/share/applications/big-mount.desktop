[Desktop Entry]
Type=Application
Name[pt_BR]=Big-Mount
Name=Big-Mount
GenericName[pt_BR]=Gerenciador de unidades e resgate de arquivos
GenericName=Drive manager and file rescue
Comment[pt_BR]=Veja como estão suas unidades, resgate arquivos delas e remova-as com segurança
Comment=See how your drives are doing, rescue files from them and remove them safely
Exec=/usr/bin/bigmount --gui-drive
Icon=big-mount
Terminal=false
Categories=System;Filesystem;
Keywords[pt_BR]=disco;unidade;usb;pendrive;montar;desmontar;somente leitura;ocupado;ejetar;ssd;apagar;recuperar;resgatar;backup;smart;armazenamento;diagnóstico;
Keywords=disk;drive;usb;mount;unmount;read-only;busy;eject;ssd;erase;recover;rescue;backup;smart;storage;diagnostics;
Actions=storageDiagnostics;

[Desktop Action storageDiagnostics]
Name[pt_BR]=Diagnóstico de Armazenamento
Name=Storage Diagnostics
Icon=drive-harddisk
Exec=/usr/bin/bigmount --gui
