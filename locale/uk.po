msgstr "Шукати втрачені розділи"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:41
#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1084
msgid "TestDisk reads the partition table and analyzes the disk. It only shows what it finds: nothing is written."
msgstr "TestDisk читає таблицю розділів і аналізує диск. Він лише показує знайдене: нічого не записується."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:47
msgid "Recovered"
msgstr "Відновлено"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:123
msgid "Recovered files"
msgstr "Відновлені файли"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:131
msgid "Files found"
msgstr "Знайдені файли"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:268
#, python-format
msgid "%d item marked. The total is measured in the next steps."
msgid_plural "%d items marked. The total is measured in the next steps."
msgstr[0] "Позначено %d елемент. Загальний обсяг буде виміряно на наступних кроках."
msgstr[1] "Позначено %d елементи. Загальний обсяг буде виміряно на наступних кроках."
msgstr[2] "Позначено %d елементів. Загальний обсяг буде виміряно на наступних кроках."
msgstr[3] "Позначено %d елемент. Загальний обсяг буде виміряно на наступних кроках."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:304
msgid "Mark what to copy. A marked folder takes everything inside. Only the folders you open are read."
msgstr "Позначте, що копіювати. Позначена тека включає весь свій вміст. Читаються лише ті теки, які ви відкриваєте."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:327
#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:397
msgid "Next"
msgstr "Далі"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:367
#, python-format
