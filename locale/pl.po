msgstr "Należy zainstalować pakiet big-mount."

#: big-mount/usr/lib/big-mount/doctor.sh:162
msgid "Another copy of bigmount is found in PATH before or besides the package"
msgstr "W PATH znaleziono inną kopię bigmount przed pakietem lub obok niego"

#: big-mount/usr/lib/big-mount/doctor.sh:167
msgid "/usr/bin/bigmount is the current generation (no known defect of older versions)"
msgstr "/usr/bin/bigmount to bieżąca generacja (brak znanych wad starszych wersji)"

