msgstr "Bezpečně odebrat (ukáže, co jej blokuje)"

#: locale/templates/big-mount-servicemenu.desktop.in:21
msgid "Diagnose the drive and rescue files"
msgstr "Diagnostikovat disk a zachránit soubory"

#: locale/templates/org.biglinux.big-mount.policy.in:11
msgid "Show the programs of all users that keep a storage device busy"
msgstr "Zobrazit programy všech uživatelů, které blokují úložné zařízení"

#: locale/templates/org.biglinux.big-mount.policy.in:12
msgid "Authentication is required to see the programs of all users that are using this device"
msgstr "Pro zobrazení programů všech uživatelů, které toto zařízení používají, je vyžadováno ověření"

#: locale/templates/org.biglinux.big-mount.policy.in:24
msgid "Protect a storage device, read its health or make a disk image"
msgstr "Chránit úložné zařízení, číst jeho stav zdraví nebo vytvořit obraz disku"

#: locale/templates/org.biglinux.big-mount.policy.in:25
msgid "Authentication is required to protect this storage device, read its health or make a disk image"
msgstr "Pro ochranu tohoto úložného zařízení, čtení jeho stavu zdraví nebo vytvoření obrazu disku je vyžadováno ověření"
