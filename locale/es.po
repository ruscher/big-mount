msgstr "No hay D-Bus de sesión: no se pueden mostrar notificaciones"

#: big-mount/usr/lib/big-mount/doctor.sh:321
msgid "The read-only notifier is off (it can be turned on in the menu of the application)"
msgstr "El notificador de solo lectura está desactivado (se puede activar en el menú de la aplicación)"

#: big-mount/usr/lib/big-mount/doctor.sh:323
msgid "The read-only notifier is running"
msgstr "El notificador de solo lectura está en ejecución"

#: big-mount/usr/lib/big-mount/doctor.sh:325
msgid "The read-only notifier is on but not running"
msgstr "El notificador de solo lectura está activado pero no en ejecución"

#: big-mount/usr/lib/big-mount/doctor.sh:325
msgid "It starts at the next login."
msgstr "Se inicia en el próximo inicio de sesión."

#: big-mount/usr/lib/big-mount/doctor.sh:336
msgid "Storage stack"
msgstr "Pila de almacenamiento"

#: big-mount/usr/lib/big-mount/doctor.sh:347
msgid "Missing program: %s"
msgstr "Falta un programa: %s"

#: big-mount/usr/lib/big-mount/doctor.sh:348
msgid "Install the dependencies of big-mount (util-linux, udisks2, lsof, glib2)."
msgstr "Instale las dependencias de big-mount (util-linux, udisks2, lsof, glib2)."

#: big-mount/usr/lib/big-mount/doctor.sh:351
msgid "UDisks2 answers on the system D-Bus"
msgstr "UDisks2 responde en el D-Bus del sistema"

#: big-mount/usr/lib/big-mount/doctor.sh:353
msgid "UDisks2 does not answer on the system D-Bus"
msgstr "UDisks2 no responde en el D-Bus del sistema"

#: big-mount/usr/lib/big-mount/doctor.sh:353
msgid "Plasma and Big-Mount cannot mount or remove devices. Check: systemctl status udisks2"
msgstr "Plasma y Big-Mount no pueden montar ni extraer dispositivos. Compruebe: systemctl status udisks2"

#: big-mount/usr/lib/big-mount/doctor.sh:357
msgid "Polkit knows the action of Big-Mount"
msgstr "Polkit conoce la acción de Big-Mount"

#: big-mount/usr/lib/big-mount/doctor.sh:359
msgid "Polkit does not know org.biglinux.big-mount.inspect-processes"
msgstr "Polkit no conoce org.biglinux.big-mount.inspect-processes"

#: big-mount/usr/lib/big-mount/doctor.sh:359
msgid "'Show programs of all users' will not work. Reinstall the big-mount package."
msgstr "'Mostrar los programas de todos los usuarios' no funcionará. Reinstale el paquete big-mount."

#: big-mount/usr/lib/big-mount/doctor.sh:363
msgid "Kernel log readable (needed to explain read-only devices)"
msgstr "Registro del kernel legible (necesario para explicar los dispositivos de solo lectura)"

#: big-mount/usr/lib/big-mount/doctor.sh:365
msgid "Kernel log not readable by this user: read-only causes are explained with fewer details"
msgstr "Este usuario no puede leer el registro del kernel: las causas de solo lectura se explican con menos detalles"

#: big-mount/usr/lib/big-mount/doctor.sh:378
msgid "%s: %s, %s, removable"
msgstr "%s: %s, %s, extraíble"

#: big-mount/usr/lib/big-mount/doctor.sh:380
msgid "%s: %s, %s, internal"
msgstr "%s: %s, %s, interno"

#: big-mount/usr/lib/big-mount/doctor.sh:384
msgid "The kernel has no /sys/block entry for it"
msgstr "El kernel no tiene ninguna entrada en /sys/block para él"

#: big-mount/usr/lib/big-mount/doctor.sh:386
msgid "UDisks2 does not know this device: Plasma and Big-Mount cannot manage it"
msgstr "UDisks2 no conoce este dispositivo: Plasma y Big-Mount no pueden gestionarlo"

#: big-mount/usr/lib/big-mount/doctor.sh:393
msgid "%s: the drive reports problems (%s)"
msgstr "%s: la unidad informa de problemas (%s)"

#: big-mount/usr/lib/big-mount/doctor.sh:394
msgid "For details: bigmount --diagnose %s"
msgstr "Para más detalles: bigmount --diagnose %s"

#: big-mount/usr/lib/big-mount/doctor.sh:405
msgid "NVMe controller /dev/%s: storage %s"
msgstr "Controlador NVMe /dev/%s: almacenamiento %s"

#: big-mount/usr/lib/big-mount/doctor.sh:418
msgid "Mounted read-only: %s"
msgstr "Montado en solo lectura: %s"

#: big-mount/usr/lib/big-mount/doctor.sh:418
msgid "To know why: bigmount --diagnose DEVICE"
msgstr "Para saber por qué: bigmount --diagnose DISPOSITIVO"

#: big-mount/usr/lib/big-mount/doctor.sh:426
msgid "Outside Big-Mount (for reference)"
msgstr "Fuera de Big-Mount (como referencia)"

#: big-mount/usr/lib/big-mount/doctor.sh:432
msgid "Settings files that do not belong to you (Plasma cannot save them, so settings seem to reset)"
msgstr "Archivos de configuración que no le pertenecen (Plasma no puede guardarlos, así que la configuración parece restablecerse)"

#: big-mount/usr/lib/big-mount/doctor.sh:433
msgid "Usually left by a graphical program run with sudo. An administrator can give them back with chown."
msgstr "Suelen quedar de un programa gráfico ejecutado con sudo. Un administrador puede devolvérselos con chown."

#: big-mount/usr/lib/big-mount/doctor.sh:435
msgid "All your settings files belong to you"
msgstr "Todos sus archivos de configuración le pertenecen"

#: big-mount/usr/lib/big-mount/doctor.sh:442
msgid "Keep the system consistent: update everything at once (sudo pacman -Syu), never only some packages."
msgstr "Mantenga el sistema coherente: actualícelo todo a la vez (sudo pacman -Syu), nunca solo algunos paquetes."

#: big-mount/usr/lib/big-mount/doctor.sh:455
msgid "Big-Mount check (nothing is changed; labels, serial numbers, UUIDs and personal paths are left out)"
msgstr "Comprobación de Big-Mount (no se cambia nada; se omiten etiquetas, números de serie, UUID y rutas personales)"

#: big-mount/usr/lib/big-mount/doctor.sh:465
msgid "Result: %s, %s."
msgstr "Resultado: %s, %s."

#: big-mount/usr/lib/big-mount/doctor.sh:466
msgid "Big-Mount and the storage stack look healthy."
msgstr "Big-Mount y la pila de almacenamiento parecen estar en buen estado."

#: big-mount/usr/lib/big-mount/doctor.sh:467
msgid "To report a problem, attach this output: bigmount --doctor > big-mount-report.txt"
msgstr "Para informar de un problema, adjunte esta salida: bigmount --doctor > big-mount-report.txt"

#: big-mount/usr/lib/big-mount/drive-copy.sh:98
msgid "rsync is not installed, and it does the copying. Install the package rsync."
msgstr "rsync no está instalado, y es el que hace la copia. Instale el paquete rsync."

#: big-mount/usr/lib/big-mount/drive-copy.sh:99
msgid "A path has a line break in its name. It cannot be handled safely."
msgstr "Una ruta tiene un salto de línea en su nombre. No se puede tratar con seguridad."

#: big-mount/usr/lib/big-mount/drive-copy.sh:100
msgid "The source folder does not exist or cannot be read."
msgstr "La carpeta de origen no existe o no se puede leer."

#: big-mount/usr/lib/big-mount/drive-copy.sh:101
msgid "The source did not answer in time. The drive may be stuck on a damaged area: wait, or unplug it and try again."
msgstr "El origen no respondió a tiempo. Puede que la unidad esté atascada en una zona dañada: espere, o desconéctela y vuelva a intentarlo."

#: big-mount/usr/lib/big-mount/drive-copy.sh:102
msgid "A selected item is outside the source folder."
msgstr "Un elemento seleccionado está fuera de la carpeta de origen."

#: big-mount/usr/lib/big-mount/drive-copy.sh:103
msgid "A selected item does not exist in the source folder."
msgstr "Un elemento seleccionado no existe en la carpeta de origen."

#: big-mount/usr/lib/big-mount/drive-copy.sh:104
msgid "The source and the destination are the same folder."
msgstr "El origen y el destino son la misma carpeta."

#: big-mount/usr/lib/big-mount/drive-copy.sh:105
msgid "The destination is inside the source. The copy would copy itself."
msgstr "El destino está dentro del origen. La copia se copiaría a sí misma."

#: big-mount/usr/lib/big-mount/drive-copy.sh:106
msgid "The source is inside the destination, which could overwrite the source."
msgstr "El origen está dentro del destino, lo que podría sobrescribir el origen."

#: big-mount/usr/lib/big-mount/drive-copy.sh:107
msgid "The source and the destination are on the same filesystem. A copy there does not protect the data."
msgstr "El origen y el destino están en el mismo sistema de archivos. Una copia ahí no protege los datos."

#: big-mount/usr/lib/big-mount/drive-copy.sh:108
msgid "The destination is on the same physical disk as the source. If that disk fails, both are lost. To accept that, allow it explicitly."
msgstr "El destino está en el mismo disco físico que el origen. Si ese disco falla, se pierden ambos. Para aceptarlo, permítalo de forma explícita."

#: big-mount/usr/lib/big-mount/drive-copy.sh:109
msgid "The destination folder could not be created."
msgstr "No se ha podido crear la carpeta de destino."

#: big-mount/usr/lib/big-mount/drive-copy.sh:110
msgid "The destination is read-only."
msgstr "El destino es de solo lectura."

#: big-mount/usr/lib/big-mount/drive-copy.sh:111
msgid "You do not have permission to write to the destination."
msgstr "No tiene permiso para escribir en el destino."

#: big-mount/usr/lib/big-mount/drive-copy.sh:112
msgid "The destination did not answer in time."
msgstr "El destino no respondió a tiempo."

#: big-mount/usr/lib/big-mount/drive-copy.sh:113
msgid "The destination is on a drive with critical alerts. To accept that, allow it explicitly."
msgstr "El destino está en una unidad con alertas críticas. Para aceptarlo, permítalo de forma explícita."

#: big-mount/usr/lib/big-mount/drive-copy.sh:114
msgid "This drive is at risk and is mounted with writing enabled. Mount it read-only first, so that nothing changes it during the copy. To accept the risk, allow it explicitly."
msgstr "Esta unidad está en riesgo y está montada con la escritura activada. Móntela primero en solo lectura, para que nada la cambie durante la copia. Para aceptar el riesgo, permítalo de forma explícita."

#: big-mount/usr/lib/big-mount/drive-copy.sh:115
msgid "There is not enough free space at the destination."
msgstr "No hay suficiente espacio libre en el destino."

#: big-mount/usr/lib/big-mount/drive-copy.sh:116
#: big-mount/usr/lib/big-mount/drive-copy.sh:434
msgid "GNU ddrescue is not installed (package ddrescue). It makes the disk image."
msgstr "GNU ddrescue no está instalado (paquete ddrescue). Es el que crea la imagen de disco."

#: big-mount/usr/lib/big-mount/drive-copy.sh:117
#: big-mount/usr/lib/big-mount/drive-recovery.sh:853
msgid "PhotoRec is not installed (package testdisk)."
msgstr "PhotoRec no está instalado (paquete testdisk)."

#: big-mount/usr/lib/big-mount/drive-copy.sh:118
#: big-mount/usr/lib/big-mount/drive-recovery.sh:621
msgid "TestDisk is not installed (package testdisk)."
msgstr "TestDisk no está instalado (paquete testdisk)."

#: big-mount/usr/lib/big-mount/drive-copy.sh:119
#: big-mount/usr/lib/big-mount/drive-copy.sh:433
#: big-mount/usr/lib/big-mount/drive-recovery.sh:676
#: big-mount/usr/lib/big-mount/drive.sh:608
msgid "Permission was not granted."
msgstr "No se concedió el permiso."

#: big-mount/usr/lib/big-mount/drive-copy.sh:120
#: big-mount/usr/lib/big-mount/drive-recovery.sh:669
msgid "Stopped. Nothing was changed on the disk."
msgstr "Detenido. No se cambió nada en el disco."

#: big-mount/usr/lib/big-mount/drive-copy.sh:121
#: big-mount/usr/lib/big-mount/drive-recovery.sh:860
msgid "This device cannot be read by your user. Make a disk image first (bigmount --drive image), and search in the image: it also spares the disk."
msgstr "Su usuario no puede leer este dispositivo. Cree primero una imagen de disco (bigmount --drive image) y busque en la imagen: además, así se protege el disco."

#: big-mount/usr/lib/big-mount/drive-copy.sh:122
msgid "The image cannot be stored on the disk being read."
msgstr "La imagen no se puede guardar en el disco que se está leyendo."

#: big-mount/usr/lib/big-mount/drive-copy.sh:123
msgid "An image of another disk already exists in that place. Continuing it would mix the two: choose another name."
msgstr "Ya existe en ese lugar una imagen de otro disco. Continuarla mezclaría ambas: elija otro nombre."

#: big-mount/usr/lib/big-mount/drive-copy.sh:124
msgid "A file with this name already exists and is not an image started here. Choose another name."
msgstr "Ya existe un archivo con este nombre y no es una imagen iniciada aquí. Elija otro nombre."

#: big-mount/usr/lib/big-mount/drive-copy.sh:125
#: big-mount/usr/lib/big-mount/drive-diag.sh:387
#: big-mount/usr/lib/big-mount/drive-tui.sh:78
msgid "The device was disconnected or replaced. Nothing was done."
msgstr "El dispositivo se desconectó o se sustituyó. No se hizo nada."

#: big-mount/usr/lib/big-mount/drive-copy.sh:126
#: big-mount/usr/lib/big-mount/drive-diag.sh:378
msgid "This computer has no driver for this filesystem. Installing the right package may solve it."
msgstr "Este equipo no tiene controlador para este sistema de archivos. Instalar el paquete adecuado puede solucionarlo."

#: big-mount/usr/lib/big-mount/drive-copy.sh:127
#: big-mount/usr/lib/big-mount/drive-diag.sh:383
msgid "This volume is encrypted. Unlock it first."
msgstr "Este volumen está cifrado. Desbloquéelo primero."

#: big-mount/usr/lib/big-mount/drive-copy.sh:128
#: big-mount/usr/lib/big-mount/drive-diag.sh:384
msgid "This is a part of a larger volume (RAID, LVM or similar), not a filesystem of its own. Its volume must be assembled first."
msgstr "Es parte de un volumen mayor (RAID, LVM o similar), no un sistema de archivos propio. Primero hay que ensamblar su volumen."

#: big-mount/usr/lib/big-mount/drive-copy.sh:129
#: big-mount/usr/lib/big-mount/drive-diag.sh:386
msgid "This is swap space, not a place for files."
msgstr "Es espacio de intercambio, no un lugar para archivos."

#: big-mount/usr/lib/big-mount/drive-copy.sh:130
msgid "No filesystem was recognized on it, so its files cannot be listed."
msgstr "No se reconoció ningún sistema de archivos en él, así que no se pueden listar sus archivos."

#: big-mount/usr/lib/big-mount/drive-copy.sh:131
msgid "Choose one of the volumes of this drive to see its files."
msgstr "Elija uno de los volúmenes de esta unidad para ver sus archivos."

#: big-mount/usr/lib/big-mount/drive-copy.sh:132
msgid "This is already a disk image."
msgstr "Esto ya es una imagen de disco."

#: big-mount/usr/lib/big-mount/drive-copy.sh:133
msgid "The copy was refused."
msgstr "Se rechazó la copia."

#: big-mount/usr/lib/big-mount/drive-copy.sh:151
msgid "The source is mounted with writing enabled. Mounting it read-only is safer."
msgstr "El origen está montado con la escritura activada. Es más seguro montarlo en solo lectura."

#: big-mount/usr/lib/big-mount/drive-copy.sh:152
msgid "The source drive reported problems. Files that do not advance are set aside so the rest is saved first."
msgstr "La unidad de origen ha informado de problemas. Los archivos que no avanzan se dejan aparte para que el resto se salve primero."

#: big-mount/usr/lib/big-mount/drive-copy.sh:153
msgid "The total is not measured on a drive at risk, to avoid extra reads. Progress shows what was copied so far."
msgstr "En una unidad en riesgo no se mide el total, para evitar lecturas adicionales. El progreso muestra lo que se ha copiado hasta ahora."

#: big-mount/usr/lib/big-mount/drive-copy.sh:154
msgid "The total is the used space of the volume: an approximation."
msgstr "El total es el espacio usado del volumen: una aproximación."

#: big-mount/usr/lib/big-mount/drive-copy.sh:155
msgid "The destination is FAT32, which cannot store files of 4 GiB or more. Those files will be listed as failed."
msgstr "El destino es FAT32, que no puede guardar archivos de 4 GiB o más. Esos archivos figurarán como fallidos."

#: big-mount/usr/lib/big-mount/drive-copy.sh:156
msgid "The destination does not store Linux permissions. Names and dates are kept, permissions are not."
msgstr "El destino no guarda los permisos de Linux. Se conservan los nombres y las fechas, pero no los permisos."

#: big-mount/usr/lib/big-mount/drive-copy.sh:157
msgid "Some files already exist at the destination with different content. See the option for existing files."
msgstr "Algunos archivos ya existen en el destino con un contenido distinto. Consulte la opción para archivos existentes."

#: big-mount/usr/lib/big-mount/drive-copy.sh:158
msgid "This version of rsync cannot sync each file to the disk (it needs 3.2.4 or later). After a power cut, the last files copied should be checked."
msgstr "Esta versión de rsync no puede sincronizar cada archivo con el disco (necesita la 3.2.4 o posterior). Tras un corte de corriente, conviene comprobar los últimos archivos copiados."

#: big-mount/usr/lib/big-mount/drive-copy.sh:159
msgid "The full check reads every file of the source again. On a drive at risk that is extra wear."
msgstr "La comprobación completa vuelve a leer todos los archivos del origen. En una unidad en riesgo eso supone un desgaste adicional."

#: big-mount/usr/lib/big-mount/drive-copy.sh:358
msgid "Cannot record a name with a line break: %s"
msgstr "No se puede registrar un nombre con un salto de línea: %s"

#: big-mount/usr/lib/big-mount/drive-copy.sh:396
msgid "Making the disk image"
msgstr "Creando la imagen de disco"

#: big-mount/usr/lib/big-mount/drive-copy.sh:397
msgid "Disk image complete"
msgstr "Imagen de disco completa"

#: big-mount/usr/lib/big-mount/drive-copy.sh:398
msgid "Listing the files"
msgstr "Listando los archivos"

#: big-mount/usr/lib/big-mount/drive-copy.sh:399
msgid "List of files complete"
msgstr "Lista de archivos completa"

#: big-mount/usr/lib/big-mount/drive-copy.sh:400
msgid "Searching by content"
msgstr "Buscando por contenido"

#: big-mount/usr/lib/big-mount/drive-copy.sh:401
msgid "Search complete"
msgstr "Búsqueda terminada"

#: big-mount/usr/lib/big-mount/drive-copy.sh:404
msgid "Waiting to start"
msgstr "Esperando para empezar"

#: big-mount/usr/lib/big-mount/drive-copy.sh:405
msgid "Measuring what will be copied"
msgstr "Midiendo lo que se va a copiar"

#: big-mount/usr/lib/big-mount/drive-copy.sh:406
msgid "Copying"
msgstr "Copiando"

#: big-mount/usr/lib/big-mount/drive-copy.sh:407
msgid "Checking the result"
msgstr "Comprobando el resultado"

#: big-mount/usr/lib/big-mount/drive-copy.sh:408
msgid "Stopping: waiting for the disk to answer"
msgstr "Deteniendo: esperando a que el disco responda"

#: big-mount/usr/lib/big-mount/drive-copy.sh:409
msgid "Paused"
msgstr "En pausa"

#: big-mount/usr/lib/big-mount/drive-copy.sh:410
msgid "Completed and checked"
msgstr "Completado y comprobado"

#: big-mount/usr/lib/big-mount/drive-copy.sh:411
msgid "Cancelled"
msgstr "Cancelado"

#: big-mount/usr/lib/big-mount/drive-copy.sh:412
msgid "Failed"
msgstr "Fallido"

#: big-mount/usr/lib/big-mount/drive-copy.sh:413
msgid "Finished, needs your attention"
msgstr "Terminado, requiere su atención"

#: big-mount/usr/lib/big-mount/drive-copy.sh:414
msgid "Interrupted (it can be resumed)"
msgstr "Interrumpido (se puede reanudar)"

#: big-mount/usr/lib/big-mount/drive-copy.sh:425
msgid "The source drive was disconnected or unmounted. Connect and mount it again, then resume."
msgstr "La unidad de origen se desconectó o se desmontó. Vuelva a conectarla y montarla, y luego reanude."

#: big-mount/usr/lib/big-mount/drive-copy.sh:426
msgid "The destination was disconnected or unmounted. Connect and mount it again, then resume."
msgstr "El destino se desconectó o se desmontó. Vuelva a conectarlo y montarlo, y luego reanude."

#: big-mount/usr/lib/big-mount/drive-copy.sh:427
msgid "The destination ran out of space. Free some space or choose another place, then resume."
msgstr "El destino se quedó sin espacio. Libere espacio o elija otro lugar, y luego reanude."

#: big-mount/usr/lib/big-mount/drive-copy.sh:429
msgid "Some files were not copied. See the list below."
msgstr "Algunos archivos no se copiaron. Consulte la lista de abajo."

#: big-mount/usr/lib/big-mount/drive-copy.sh:430
msgid "The check found differences between source and destination."
msgstr "La comprobación encontró diferencias entre el origen y el destino."

#: big-mount/usr/lib/big-mount/drive-copy.sh:431
msgid "Everything was copied, but the check did not finish: it was cancelled or failed."
msgstr "Se copió todo, pero la comprobación no terminó: se canceló o falló."

#: big-mount/usr/lib/big-mount/drive-copy.sh:432
msgid "rsync stopped with an error. See the log."
msgstr "rsync se detuvo con un error. Consulte el registro."

#: big-mount/usr/lib/big-mount/drive-copy.sh:435
msgid "GNU ddrescue stopped with an error. See the log."
msgstr "GNU ddrescue se detuvo con un error. Consulte el registro."

#: big-mount/usr/lib/big-mount/drive-copy.sh:436
msgid "Some areas of the disk could not be read. The image holds everything that could be."
msgstr "No se pudieron leer algunas zonas del disco. La imagen contiene todo lo que se pudo leer."

#: big-mount/usr/lib/big-mount/drive-copy.sh:437
msgid "Some folders could not be read, so the list may be incomplete. See the log."
msgstr "No se pudieron leer algunas carpetas, así que puede que la lista esté incompleta. Consulte el registro."

#: big-mount/usr/lib/big-mount/drive-copy.sh:438
msgid "PhotoRec stopped with an error. See the log."
msgstr "PhotoRec se detuvo con un error. Consulte el registro."

#: big-mount/usr/lib/big-mount/drive-copy.sh:439
msgid "No file was recognized by its content. That does not prove there is nothing to recover: another method, or a professional, may find more."
msgstr "No se reconoció ningún archivo por su contenido. Eso no demuestra que no haya nada que recuperar: otro método, o un profesional, puede encontrar más."

#: big-mount/usr/lib/big-mount/drive-copy.sh:529
msgid "its content could not be read"
msgstr "no se pudo leer su contenido"

#: big-mount/usr/lib/big-mount/drive-copy.sh:999
#: big-mount/usr/lib/big-mount/drive-recovery.sh:935
msgid "Source:"
msgstr "Origen:"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1000
#: big-mount/usr/lib/big-mount/drive-recovery.sh:940
msgid "Destination:"
msgstr "Destino:"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1002
#: big-mount/usr/lib/big-mount/drive-copy.sh:1004
msgid "Files:"
msgstr "Archivos:"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1014
#: big-mount/usr/lib/big-mount/drive-copy.sh:1015
msgid "Copied:"
msgstr "Copiado:"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1019
msgid "average"
msgstr "media"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1019
msgid "Speed:"
msgstr "Velocidad:"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1020
#: big-mount/usr/lib/big-mount/drive-recovery.sh:948
msgid "Elapsed:"
msgstr "Transcurrido:"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1021
msgid "Remaining:"
msgstr "Restante:"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1025
msgid "Current file:"
msgstr "Archivo actual:"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1026
msgid "Set aside:"
msgstr "Apartados:"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1027
msgid "Failed:"
msgstr "Fallidos:"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1067
msgid "Cancelled. Files already copied stay at the destination, and the copy can be resumed."
msgstr "Cancelado. Los archivos ya copiados permanecen en el destino, y la copia se puede reanudar."

#: big-mount/usr/lib/big-mount/drive-copy.sh:1083
msgid "Source"
msgstr "Origen"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1088
#: big-mount/usr/lib/big-mount/drive-recovery.sh:962
msgid "Destination"
msgstr "Destino"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1089
msgid "Files copied"
msgstr "Archivos copiados"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1090
msgid "Data copied"
msgstr "Datos copiados"

#: big-mount/usr/lib/big-mount/drive-copy.sh:1091
#: big-mount/usr/lib/big-mount/drive-recovery.sh:966
msgid "Elapsed"
