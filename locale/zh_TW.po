msgstr "要複製的內容"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:636
#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1004
msgid "Everything"
msgstr "全部"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:636
