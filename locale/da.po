#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:985
msgid "Your files will be copied with their names. Nothing is written to the source."
msgstr "Dine filer bliver kopieret med deres navne. Intet bliver skrevet til kilden."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:986
msgid "First a list of what exists is made. Then you choose what to copy. Nothing is written to the source."
msgstr "Først laves en liste over, hvad der findes. Derefter vælger du, hvad der skal kopieres. Intet bliver skrevet til kilden."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:987
msgid "Files will be searched for by their content. Names and folders are lost, some files may come out incomplete, and finding nothing is possible. Nothing is written to the source."
msgstr "Der søges efter filer ud fra deres indhold. Navne og mapper går tabt, nogle filer kan blive ufuldstændige, og det er muligt, at der ikke findes noget. Intet bliver skrevet til kilden."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:988
msgid "The disk is read once, into a file. Nothing is written to it."
msgstr "Disken læses én gang ind i en fil. Intet bliver skrevet til den."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:993
msgid "After the image, the search needs your confirmation. It can also be started later."
msgstr "Efter aftrykket kræver søgningen din bekræftelse. Den kan også startes senere."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:995
msgid "Good to know"
msgstr "Godt at vide"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1005
#, python-format
msgid "%d item you marked"
msgid_plural "%d items you marked"
msgstr[0] "%d element, du har markeret"
msgstr[1] "%d elementer, du har markeret"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1015
msgid "If a file already exists"
msgstr "Hvis en fil allerede findes"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1020
msgid "Check the result"
msgstr "Kontrollér resultatet"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1022
msgid "Basic: rsync confirms each file as it is copied"
msgstr "Grundlæggende: rsync bekræfter hver fil, efterhånden som den kopieres"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1022
msgid "Names, sizes and dates compared at the end"
msgstr "Navne, størrelser og datoer sammenlignes til sidst"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1023
msgid "Content compared at the end (reads the source again)"
msgstr "Indhold sammenlignes til sidst (læser kilden igen)"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1027
msgid "Set aside a stuck file after (seconds)"
msgstr "Læg en fil, der sidder fast, til side efter (sekunder)"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1029
msgid "A file that does not advance for this long is set aside, so that the others are saved first. 0: never."
msgstr "En fil, der ikke kommer videre så længe, lægges til side, så de andre bliver reddet først. 0: aldrig."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1033
msgid "Limit the reading speed (kB/s)"
msgstr "Begræns læsehastigheden (kB/s)"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1035
msgid "0: no limit"
msgstr "0: ingen grænse"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1046
msgid "Starting…"
msgstr "Starter …"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1055
#: big-mount/usr/lib/big-mount/gui/pages/results.py:621
msgid "It did not start"
msgstr "Det startede ikke"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1085
msgid "Read the partition table"
msgstr "Læs partitionstabellen"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1086
msgid "Analyze the whole disk"
msgstr "Analysér hele disken"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1087
msgid "It reads all of the disk. On a drive with problems this is extra wear."
msgstr "Det læser hele disken. På et drev med problemer er det ekstra slid."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1090
msgid "This drive reported problems: analyzing all of it is extra wear. A disk image first spares it."
msgstr "Dette drev har rapporteret problemer: at analysere det hele er ekstra slid. Et diskaftryk først skåner det."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1112
msgid "Stopping…"
msgstr "Stopper …"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1119
msgid "Volumes this drive already has"
msgstr "Diskenheder, som dette drev allerede har"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1120
msgid "They are not lost. To recover their files, copying them is faster and reads the disk less than any analysis."
msgstr "De er ikke gået tabt. Hvis du vil gendanne deres filer, er det hurtigere at kopiere dem, og det læser disken mindre end nogen analyse."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1125
msgid "Recover its files"
msgstr "Gendan dens filer"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1137
msgid "Looking for partitions…"
msgstr "Leder efter partitioner …"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1141
msgid "TestDisk does not say how far it has gone, so there is no percentage. Analyzing a whole disk reads all of it and can take hours; the drive can be used for nothing else meanwhile."
msgstr "TestDisk fortæller ikke, hvor langt den er nået, så der er ingen procentdel. En analyse af en hel disk læser hele disken og kan tage timer; drevet kan ikke bruges til andet imens."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1152
#, python-format
msgid "Elapsed: %s"
msgstr "Forløbet tid: %s"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1172
msgid "The search failed."
msgstr "Søgningen mislykkedes."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1175
msgid "What TestDisk found"
msgstr "Hvad TestDisk fandt"

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1181
msgid "Big-Mount does not rewrite partition tables, on purpose: a mistake there can lose everything. A disk image, or a search by content, recovers files without that risk."
msgstr "Big-Mount omskriver med vilje ikke partitionstabeller: en fejl dér kan betyde, at alt går tabt. Et diskaftryk eller en søgning efter indhold gendanner filer uden den risiko."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1183
msgid "The analysis did not recognize any partition. That does not prove there is no data: a search by content may still find files."
msgstr "Analysen genkendte ingen partitioner. Det beviser ikke, at der ikke er nogen data: en søgning efter indhold kan stadig finde filer."

#: big-mount/usr/lib/big-mount/gui/pages/rescue.py:1185
msgid "The partition table is empty or unreadable. Analyzing the whole disk may find what it no longer lists."
msgstr "Partitionstabellen er tom eller kan ikke læses. En analyse af hele disken kan finde det, den ikke længere viser."

#: big-mount/usr/lib/big-mount/gui/pages/results.py:228
msgid "This picture cannot be shown"
msgstr "Dette billede kan ikke vises"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:229
msgid "It may be incomplete. That is common with files found by content."
msgstr "Det er måske ufuldstændigt. Det er almindeligt for filer, der er fundet ud fra indholdet."

#: big-mount/usr/lib/big-mount/gui/pages/results.py:274
#: big-mount/usr/lib/big-mount/gui/pages/results.py:275
msgid "Search by name"
msgstr "Søg efter navn"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:277
msgid "As found"
msgstr "Som fundet"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:277
msgid "Largest first"
msgstr "Største først"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:277
msgid "By name"
msgstr "Efter navn"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:278
msgid "Order"
msgstr "Rækkefølge"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:292
msgid "Name"
msgstr "Navn"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:296
msgid "Date"
msgstr "Dato"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:301
msgid "Reading the list…"
msgstr "Læser listen …"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:303
msgid "Nothing to show"
msgstr "Intet at vise"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:304
msgid "No file matches what you asked for."
msgstr "Ingen filer matcher det, du bad om."

#: big-mount/usr/lib/big-mount/gui/pages/results.py:311
msgid "Recover selected"
msgstr "Gendan valgte"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:313
msgid "Select all shown"
msgstr "Vælg alle viste"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:314
msgid "Clear selection"
msgstr "Ryd markering"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:321
#: big-mount/usr/lib/big-mount/gui/pages/results.py:642
msgid "Save report"
msgstr "Gem rapport"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:322
msgid "Try another method"
msgstr "Prøv en anden metode"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:358
msgid "Candidates found by content. They are saved in the destination folder, without their names and folders, and some may be incomplete. Check them before deleting anything."
msgstr "Kandidater fundet ud fra indholdet. De er gemt i destinationsmappen uden deres navne og mapper, og nogle kan være ufuldstændige. Tjek dem, før du sletter noget."

#: big-mount/usr/lib/big-mount/gui/pages/results.py:359
msgid "Copy selected to another folder"
msgstr "Kopiér valgte til en anden mappe"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:361
msgid "These files exist on the volume and have not been copied yet. Deleted files are not on this list."
msgstr "Disse filer findes på diskenheden og er ikke kopieret endnu. Slettede filer er ikke med på denne liste."

#: big-mount/usr/lib/big-mount/gui/pages/results.py:374
#, python-format
msgid "All (%d)"
msgstr "Alle (%d)"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:394
msgid "The list could not be read."
msgstr "Listen kunne ikke læses."

#: big-mount/usr/lib/big-mount/gui/pages/results.py:493
#, python-format
msgid "%(shown)s, %(sel)s (%(size)s)"
msgstr "%(shown)s, %(sel)s (%(size)s)"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:493
#, python-format
msgid "%d shown"
msgid_plural "%d shown"
msgstr[0] "%d vist"
msgstr[1] "%d vist"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:494
#, python-format
msgid "%d selected"
msgid_plural "%d selected"
msgstr[0] "%d valgt"
msgstr[1] "%d valgt"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:512
msgid "Select"
msgstr "Vælg"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:534
msgid "Preview"
msgstr "Forhåndsvisning"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:600
msgid "It cannot be copied"
msgstr "Det kan ikke kopieres"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:603
#, python-format
msgid "%d file with a line break in its name was left out. It cannot be handled safely."
msgid_plural "%d files with a line break in their names were left out. They cannot be handled safely."
msgstr[0] "%d fil med et linjeskift i navnet blev udeladt. Den kan ikke håndteres sikkert."
msgstr[1] "%d filer med et linjeskift i navnet blev udeladt. De kan ikke håndteres sikkert."

#: big-mount/usr/lib/big-mount/gui/pages/results.py:629
msgid "It cannot be saved here"
msgstr "Det kan ikke gemmes her"

