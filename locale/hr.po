msgstr "%s čita /var/lib/sddm/state.conf bez provjere smije li: 'Permission denied' kada je pokrene korisnik"

#: big-mount/usr/lib/big-mount/doctor.sh:132
msgid "Update the big-mount package. Never change the permissions of the files of SDDM to work around it."
msgstr "Ažurirajte paket big-mount. Nikada ne mijenjajte dopuštenja datoteka SDDM-a kako biste to zaobišli."

#: big-mount/usr/lib/big-mount/doctor.sh:135
msgid "%s has no diagnosis or safe removal: every option is ignored and it tries to mount the internal partitions instead"
msgstr "%s nema dijagnostiku ni sigurno uklanjanje: zanemaruje svaku opciju i umjesto toga pokušava montirati unutarnje particije"

