#!/bin/bash
# Stub of "bigmount --apfs-helper" for the boot run: logs its arguments
# and the lock fd, and exits with the code in $TESTROOT/apfs-helper-rc (0)
# (a FUSE driver started by it must not hold bigmount's lock)
: "${TESTROOT:?stub called outside the test harness}"
echo "apfs-helper $*" >> "$TESTROOT/apfs-helper.log"
[ -e /proc/self/fd/9 ] && echo "apfs-helper inherited fd 9" >> "$TESTROOT/fd.log"
rc=0
[ -r "$TESTROOT/apfs-helper-rc" ] && rc="$(cat "$TESTROOT/apfs-helper-rc")"
[ "$rc" = 0 ] && echo "${*: -4:1} ${*: -3:1} fuse.apfs-fuse ro,nosuid,nodev 0 0" >> "$TESTROOT/proc/mounts"
exit "$rc"
