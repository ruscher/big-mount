msgid "source checkout (not installed by a package)"
msgstr "forráskód-másolat (nem csomagból telepítve)"

#: big-mount/usr/lib/big-mount/doctor.sh:49
msgid "package:"
msgstr "csomag:"

#: big-mount/usr/lib/big-mount/doctor.sh:49
msgid "revision:"
msgstr "revízió:"

#: big-mount/usr/lib/big-mount/doctor.sh:49
msgid "source:"
msgstr "forrás:"

