#: big-mount/usr/lib/big-mount/gui/pages/results.py:494
#, python-format
msgid "%d selected"
msgid_plural "%d selected"
msgstr[0] "vybraných %d súborov"
msgstr[1] "vybraný %d súbor"
msgstr[2] "vybrané %d súbory"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:512
msgid "Select"
msgstr "Vybrať"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:534
msgid "Preview"
msgstr "Náhľad"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:600
msgid "It cannot be copied"
msgstr "Nedá sa to skopírovať"

#: big-mount/usr/lib/big-mount/gui/pages/results.py:603
#, python-format
msgid "%d file with a line break in its name was left out. It cannot be handled safely."
msgid_plural "%d files with a line break in their names were left out. They cannot be handled safely."
msgstr[0] "%d súborov so zalomením riadka v názve bolo vynechaných. Nedajú sa bezpečne spracovať."
msgstr[1] "%d súbor so zalomením riadka v názve bol vynechaný. Nedá sa bezpečne spracovať."
msgstr[2] "%d súbory so zalomením riadka v názve boli vynechané. Nedajú sa bezpečne spracovať."

#: big-mount/usr/lib/big-mount/gui/pages/results.py:629
msgid "It cannot be saved here"
msgstr "Sem sa to nedá uložiť"

#: locale/templates/big-mount.desktop.in:4
msgid "Drive manager and file rescue"
msgstr "Správca diskov a záchrana súborov"

#: locale/templates/big-mount.desktop.in:5
msgid "See how your drives are doing, rescue files from them and remove them safely"
msgstr "Zistite, ako sa darí vašim diskom, zachráňte z nich súbory a bezpečne ich odstráňte"

#: locale/templates/big-mount.desktop.in:11
msgid "disk;drive;usb;mount;unmount;read-only;busy;eject;ssd;erase;recover;rescue;backup;smart;storage;diagnostics;"
msgstr "disk;jednotka;usb;pripojiť;odpojiť;iba na čítanie;zaneprázdnené;vysunúť;ssd;vymazať;obnoviť;zachrániť;záloha;smart;úložisko;diagnostika;"

#: locale/templates/big-mount.desktop.in:15
msgid "Storage Diagnostics"
msgstr "Diagnostika úložísk"

#: locale/templates/big-mount-notifier.desktop.in:3
