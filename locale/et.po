msgstr "Jätkamiseks vajuta Enter."

#: big-mount/usr/lib/big-mount/drive-tui.sh:42
#: big-mount/usr/lib/big-mount/ui.sh:131 big-mount/usr/lib/big-mount/ui.sh:146
msgid "y"
msgstr "j"

#: big-mount/usr/lib/big-mount/drive-tui.sh:42
#: big-mount/usr/lib/big-mount/ui.sh:146
msgid "N"
msgstr "E"

#: big-mount/usr/lib/big-mount/drive-tui.sh:49
msgid "The interactive manager needs a terminal. For scripts, see bigmount --drive --help."
msgstr "Interaktiivne haldur vajab terminali. Skriptide jaoks vaata bigmount --drive --help."

#: big-mount/usr/lib/big-mount/drive-tui.sh:55
msgid "Safe diagnosis and recovery"
msgstr "Turvaline diagnoos ja taastamine"

#: big-mount/usr/lib/big-mount/drive-tui.sh:56
msgid "Devices found: %s"
msgstr "Leitud seadmeid: %s"

#: big-mount/usr/lib/big-mount/drive-tui.sh:58
msgid "Copies and images"
msgstr "Koopiad ja tõmmised"

#: big-mount/usr/lib/big-mount/drive-tui.sh:58
msgid "Refresh"
msgstr "Värskenda"

#: big-mount/usr/lib/big-mount/drive-tui.sh:58
msgid "Quit"
msgstr "Välju"

#: big-mount/usr/lib/big-mount/drive-tui.sh:59
